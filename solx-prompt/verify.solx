# Smoke tests, not a test suite: each statement proves one registration resolved
# end to end. Run after `solx install-package .`.
#
# The action names must match install.solx exactly - see the note in
# uninstall.solx about solx-inquiry's mismatch.
#
# The first exec needs no session, no history and no chat model to be reachable
# while the phases are still stubs; once they land, `model` has to name a model
# the configured llm action can actually serve.

exec /packages/solx-prompt/prompt --json '''{"prompt":"what can this system do about searching my documents?","model":"qwen3:4b","max_results":3}''';

exec /packages/solx-prompt/prompt-widget
