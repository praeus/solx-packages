save file files/actions/shared/solx-ollama.wasm --file bin/solx-ollama.wasm;
$key = random 32;
save type /packages/solx-ollama/ChatParams --json '{"description":"Parameters for POST /api/chat. The call returns one complete response, folded together from the token stream Ollama emits; watch it arrive live via console/tail on this action, and cancel a running call via action/start + action/stop.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model","messages"],"properties":{"model":{"type":"string"},"messages":{"type":"array","items":{"type":"object"},"description":"Chat history. Each entry has role and content, plus optional images, tool_calls, or thinking."},"tools":{"type":["array","null"],"description":"Tool definitions for models with tool support."},"format":{"type":["string","object","null"]},"options":{"type":["object","null"]},"think":{"type":["boolean","string","null"]},"keep_alive":{"type":["string","number","null"]},"logprobs":{"type":["boolean","null"]},"top_logprobs":{"type":["integer","null"]},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 1800."}}}}';
save type /packages/solx-ollama/NoArgParams --json '{"description":"Parameters for the Ollama endpoints that take no request body: list-models.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"base_url":{"type":["string","null"],"description":"Ollama origin. Defaults to the OLLAMA_HOST env mapping, then http://localhost:11434."},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 300."}}}}';
save type /packages/solx-ollama/TransferModelParams --json '{"description":"Parameters for POST /api/pull. Progress is written to its own console as it happens (console/tail); watch it live and cancel a running transfer via action/start + action/stop.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model"],"properties":{"model":{"type":"string","description":"Model name, for example llama3.2:1b."},"insecure":{"type":["boolean","null"]},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 7200."}}}}';
save type /packages/solx-ollama/SetApiKeyParams --json '{"description":"Store an Ollama bearer token under the secret name OLLAMA_API_KEY, encrypted with the key held in this action action_config.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["value"],"properties":{"value":{"type":"string","description":"The bearer token to store."}}}}';
save type /packages/solx-ollama/ChatResult --json '{"description":"Non-streaming response from POST /api/chat. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"model":{"type":"string"},"created_at":{"type":"string"},"message":{"type":"object","properties":{"role":{"type":"string"},"content":{"type":"string"},"thinking":{"type":"string"},"tool_calls":{"type":"array"},"images":{"type":"array"}}},"done":{"type":"boolean"},"done_reason":{"type":"string"},"total_duration":{"type":"integer"},"load_duration":{"type":"integer"},"prompt_eval_count":{"type":"integer"},"prompt_eval_duration":{"type":"integer"},"eval_count":{"type":"integer"},"eval_duration":{"type":"integer"},"logprobs":{"type":"array"}}}}';
save type /packages/solx-ollama/ModelsResult --json '{"description":"Response from GET /api/tags. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"models":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"model":{"type":"string"},"modified_at":{"type":"string"},"size":{"type":"integer"},"digest":{"type":"string"},"details":{"type":"object"}}}}}}}';
save type /packages/solx-ollama/StatusResult --json '{"description":"Response from POST /api/pull. Endpoints that answer with an empty body report status success. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"status":{"type":"string"}}}}';
save action /packages/solx-ollama/ollama-chat --json '{"actionType":"wasm","binName":"solx-ollama.wasm","fnName":"chat","caption":"Ollama chat","category":"llm","description":"Send a chat message list to a local Ollama model via POST /api/chat, with optional tool definitions. Tokens are streamed to the action console as they arrive; the call itself returns one folded-together response.","capabilities":["llm","chat","tools","ollama","local-model"],"phrases":["ollama chat","chat with a local model","talk to ollama","local llm conversation"],"paramTypeRef":"/packages/solx-ollama/ChatParams","resultTypeRef":"/packages/solx-ollama/ChatResult","actionConfig":{"timeout_secs":1860,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
save action /packages/solx-ollama/ollama-list-models --json '{"actionType":"wasm","binName":"solx-ollama.wasm","fnName":"list_models","caption":"Ollama list models","category":"llm","description":"List the models available on the Ollama server via GET /api/tags.","capabilities":["llm","models","list","ollama"],"phrases":["list ollama models","what models are installed","ollama tags","show available models"],"paramTypeRef":"/packages/solx-ollama/NoArgParams","resultTypeRef":"/packages/solx-ollama/ModelsResult","actionConfig":{"timeout_secs":360,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
save action /packages/solx-ollama/ollama-pull-model --json '{"actionType":"wasm","binName":"solx-ollama.wasm","fnName":"pull_model","caption":"Ollama pull model","category":"llm","description":"Download (install) a model to the Ollama server via POST /api/pull. Progress (status, completed, total) is streamed to the action console as it happens - it can take many minutes for a large model.","capabilities":["llm","models","download","install","ollama"],"phrases":["ollama pull","download a model","install an ollama model","fetch a model"],"paramTypeRef":"/packages/solx-ollama/TransferModelParams","resultTypeRef":"/packages/solx-ollama/StatusResult","actionConfig":{"timeout_secs":7260,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
save action /packages/solx-ollama/ollama-set-api-key --json '{"actionType":"wasm","binName":"solx-ollama.wasm","fnName":"set_api_key","caption":"Ollama set API key","category":"llm","description":"Store an Ollama bearer token under the secret name OLLAMA_API_KEY so the other solx-ollama actions can authenticate to Ollama Cloud or a reverse-proxied server.","capabilities":["llm","secrets","auth","ollama"],"phrases":["set ollama api key","store ollama token","authenticate ollama","configure ollama cloud"],"paramTypeRef":"/packages/solx-ollama/SetApiKeyParams","actionConfig":{"timeout_secs":60,"secrets":{"OLLAMA_API_KEY":"$key"}}}'
