{
  "name": "solx-quickjs",
  "version": "0.1.0",
  "description": "JavaScript action build package for solx-core using componentize-qjs",
  "command_actions": {
    "build-javascript-action": {
      "command": ".\\solx-quickjs.exe",
      "cwd": "D:/Projects/solx-packages/solx-quickjs/target/release"
    },
    "build-javascript-file": {
      "command": ".\\solx-quickjs.exe --file-only",
      "cwd": "D:/Projects/solx-packages/solx-quickjs/target/release"
    }
  }
}
