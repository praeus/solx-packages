post file files/actions/shared/solx-ollama.wasm --file bin/solx-ollama.wasm;
$key = random 32;
post type /packages/solx-ollama/GenerateParams --json '{"description":"Parameters for POST /api/generate. Streaming is forced off, so the call returns one complete response.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model"],"properties":{"model":{"type":"string","description":"Model name, for example llama3.2:1b."},"prompt":{"type":["string","null"]},"suffix":{"type":["string","null"],"description":"Text after the model response, for fill-in-the-middle."},"images":{"type":["array","null"],"items":{"type":"string"},"description":"Base64 encoded images for multimodal models."},"format":{"type":["string","object","null"],"description":"Set to json, or a JSON Schema object, for structured output."},"system":{"type":["string","null"]},"template":{"type":["string","null"]},"raw":{"type":["boolean","null"]},"think":{"type":["boolean","string","null"]},"keep_alive":{"type":["string","number","null"],"description":"How long to keep the model loaded, for example 5m."},"options":{"type":["object","null"],"description":"Sampler and runtime options such as temperature, num_predict, num_ctx, seed."},"context":{"type":["array","null"]},"logprobs":{"type":["boolean","null"]},"top_logprobs":{"type":["integer","null"]},"base_url":{"type":["string","null"],"description":"Ollama origin. Defaults to the OLLAMA_HOST env mapping, then http://localhost:11434."},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 1800."}}}}';
post type /packages/solx-ollama/ChatParams --json '{"description":"Parameters for POST /api/chat. Streaming is forced off, so the call returns one complete response.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model","messages"],"properties":{"model":{"type":"string"},"messages":{"type":"array","items":{"type":"object"},"description":"Chat history. Each entry has role and content, plus optional images, tool_calls, or thinking."},"tools":{"type":["array","null"],"description":"Tool definitions for models with tool support."},"format":{"type":["string","object","null"]},"options":{"type":["object","null"]},"think":{"type":["boolean","string","null"]},"keep_alive":{"type":["string","number","null"]},"logprobs":{"type":["boolean","null"]},"top_logprobs":{"type":["integer","null"]},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 1800."}}}}';
post type /packages/solx-ollama/EmbedParams --json '{"description":"Parameters for POST /api/embed. Set legacy to true to use the older /api/embeddings endpoint, which takes a single prompt string.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model","input"],"properties":{"model":{"type":"string"},"input":{"type":["string","array"],"items":{"type":"string"},"description":"One string, or an array of strings to embed in a single call."},"truncate":{"type":["boolean","null"]},"dimensions":{"type":["integer","null"]},"keep_alive":{"type":["string","number","null"]},"options":{"type":["object","null"]},"legacy":{"type":["boolean","null"],"description":"Use /api/embeddings instead. Requires a single string input and returns embedding rather than embeddings."},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 600."}}}}';
post type /packages/solx-ollama/NoArgParams --json '{"description":"Parameters for the Ollama endpoints that take no request body: list-models, ps, and version.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"base_url":{"type":["string","null"],"description":"Ollama origin. Defaults to the OLLAMA_HOST env mapping, then http://localhost:11434."},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 300."}}}}';
post type /packages/solx-ollama/ShowModelParams --json '{"description":"Parameters for POST /api/show.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model"],"properties":{"model":{"type":"string"},"verbose":{"type":["boolean","null"],"description":"Return the full tokenizer and model_info detail."},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 300."}}}}';
post type /packages/solx-ollama/TransferModelParams --json '{"description":"Parameters for POST /api/pull and POST /api/push. Streaming is forced off, so the call blocks with no progress output until the transfer finishes.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model"],"properties":{"model":{"type":"string","description":"Model name. For push it must be namespace/model:tag."},"insecure":{"type":["boolean","null"]},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 7200."}}}}';
post type /packages/solx-ollama/CreateModelParams --json '{"description":"Parameters for POST /api/create. The files and adapters fields reference blobs that must already exist on the server - this package does not implement blob upload.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model"],"properties":{"model":{"type":"string","description":"Name of the new model."},"from":{"type":["string","null"],"description":"Existing model to derive from."},"files":{"type":["object","null"],"additionalProperties":{"type":"string"},"description":"Map of file name to sha256 digest of an already uploaded blob."},"adapters":{"type":["object","null"],"additionalProperties":{"type":"string"}},"template":{"type":["string","null"]},"renderer":{"type":["string","null"]},"parser":{"type":["string","null"]},"license":{"type":["string","array","null"]},"system":{"type":["string","null"]},"parameters":{"type":["object","null"]},"messages":{"type":["array","null"]},"quantize":{"type":["string","null"],"description":"Quantization such as q4_K_M or q8_0."},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 7200."}}}}';
post type /packages/solx-ollama/CopyModelParams --json '{"description":"Parameters for POST /api/copy.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["source","destination"],"properties":{"source":{"type":"string"},"destination":{"type":"string"},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 300."}}}}';
post type /packages/solx-ollama/DeleteModelParams --json '{"description":"Parameters for DELETE /api/delete. Removing a model frees disk space and cannot be undone.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["model"],"properties":{"model":{"type":"string"},"base_url":{"type":["string","null"]},"api_key":{"type":["string","null"]},"auth_secret_name":{"type":["string","null"]},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"}},"timeout_secs":{"type":["integer","null"],"description":"Per-request HTTP timeout. Clamped to 300."}}}}';
post type /packages/solx-ollama/SetApiKeyParams --json '{"description":"Store an Ollama bearer token under the secret name OLLAMA_API_KEY, encrypted with the key held in this action action_config.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["value"],"properties":{"value":{"type":"string","description":"The bearer token to store."}}}}';
post type /packages/solx-ollama/GenerateResult --json '{"description":"Non-streaming response from POST /api/generate. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"model":{"type":"string"},"created_at":{"type":"string"},"response":{"type":"string"},"thinking":{"type":"string"},"done":{"type":"boolean"},"done_reason":{"type":"string"},"total_duration":{"type":"integer"},"load_duration":{"type":"integer"},"prompt_eval_count":{"type":"integer"},"prompt_eval_duration":{"type":"integer"},"eval_count":{"type":"integer"},"eval_duration":{"type":"integer"},"context":{"type":"array"},"logprobs":{"type":"array"}}}}';
post type /packages/solx-ollama/ChatResult --json '{"description":"Non-streaming response from POST /api/chat. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"model":{"type":"string"},"created_at":{"type":"string"},"message":{"type":"object","properties":{"role":{"type":"string"},"content":{"type":"string"},"thinking":{"type":"string"},"tool_calls":{"type":"array"},"images":{"type":"array"}}},"done":{"type":"boolean"},"done_reason":{"type":"string"},"total_duration":{"type":"integer"},"load_duration":{"type":"integer"},"prompt_eval_count":{"type":"integer"},"prompt_eval_duration":{"type":"integer"},"eval_count":{"type":"integer"},"eval_duration":{"type":"integer"},"logprobs":{"type":"array"}}}}';
post type /packages/solx-ollama/EmbedResult --json '{"description":"Response from POST /api/embed, or from /api/embeddings in legacy mode. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"model":{"type":"string"},"embeddings":{"type":"array","items":{"type":"array","items":{"type":"number"}}},"embedding":{"type":"array","items":{"type":"number"},"description":"Legacy mode only."},"total_duration":{"type":"integer"},"load_duration":{"type":"integer"},"prompt_eval_count":{"type":"integer"}}}}';
post type /packages/solx-ollama/ModelsResult --json '{"description":"Response from GET /api/tags and GET /api/ps. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"models":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"model":{"type":"string"},"modified_at":{"type":"string"},"size":{"type":"integer"},"digest":{"type":"string"},"details":{"type":"object"},"expires_at":{"type":"string"},"size_vram":{"type":"integer"},"context_length":{"type":"integer"}}}}}}}';
post type /packages/solx-ollama/ShowResult --json '{"description":"Response from POST /api/show. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"parameters":{"type":"string"},"license":{"type":"string"},"modified_at":{"type":"string"},"details":{"type":"object"},"template":{"type":"string"},"capabilities":{"type":"array","items":{"type":"string"}},"model_info":{"type":"object"}}}}';
post type /packages/solx-ollama/VersionResult --json '{"description":"Response from GET /api/version. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"version":{"type":"string"}}}}';
post type /packages/solx-ollama/StatusResult --json '{"description":"Response from the model management endpoints: pull, push, create, copy, and delete. Endpoints that answer with an empty body report status success. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"status":{"type":"string"}}}}';
post action /packages/solx-ollama/ollama-generate --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"generate","caption":"Ollama generate","category":"llm","description":"Generate a completion from a local Ollama model via POST /api/generate. Streaming is not supported, so the call blocks until the full response is ready.","capabilities":["llm","generate","completion","ollama","local-model"],"phrases":["ollama generate","run a prompt through ollama","local llm completion","complete text with a local model"],"param_type_ref":"/packages/solx-ollama/GenerateParams","result_type_ref":"/packages/solx-ollama/GenerateResult","action_config":{"timeout_secs":1860,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-chat --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"chat","caption":"Ollama chat","category":"llm","description":"Send a chat message list to a local Ollama model via POST /api/chat, with optional tool definitions. Streaming is not supported, so the call blocks until the full response is ready.","capabilities":["llm","chat","tools","ollama","local-model"],"phrases":["ollama chat","chat with a local model","talk to ollama","local llm conversation"],"param_type_ref":"/packages/solx-ollama/ChatParams","result_type_ref":"/packages/solx-ollama/ChatResult","action_config":{"timeout_secs":1860,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-embed --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"embed","caption":"Ollama embed","category":"llm","description":"Generate embedding vectors for one or more inputs via POST /api/embed. Set legacy to true to use the older single-prompt /api/embeddings endpoint.","capabilities":["llm","embeddings","vectors","ollama","local-model"],"phrases":["ollama embed","embed text locally","generate embeddings","vectorize text"],"param_type_ref":"/packages/solx-ollama/EmbedParams","result_type_ref":"/packages/solx-ollama/EmbedResult","action_config":{"timeout_secs":660,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-list-models --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"list_models","caption":"Ollama list models","category":"llm","description":"List the models available on the Ollama server via GET /api/tags.","capabilities":["llm","models","list","ollama"],"phrases":["list ollama models","what models are installed","ollama tags","show available models"],"param_type_ref":"/packages/solx-ollama/NoArgParams","result_type_ref":"/packages/solx-ollama/ModelsResult","action_config":{"timeout_secs":360,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-show-model --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"show_model","caption":"Ollama show model","category":"llm","description":"Show details for one Ollama model - template, parameters, license, capabilities, and model_info - via POST /api/show.","capabilities":["llm","models","inspect","ollama"],"phrases":["show ollama model","describe a model","ollama model details","what can this model do"],"param_type_ref":"/packages/solx-ollama/ShowModelParams","result_type_ref":"/packages/solx-ollama/ShowResult","action_config":{"timeout_secs":360,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-ps --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"ps","caption":"Ollama running models","category":"llm","description":"List the models currently loaded into memory, with VRAM use and expiry, via GET /api/ps.","capabilities":["llm","models","status","ollama"],"phrases":["ollama ps","what models are loaded","ollama running models","which models are in memory"],"param_type_ref":"/packages/solx-ollama/NoArgParams","result_type_ref":"/packages/solx-ollama/ModelsResult","action_config":{"timeout_secs":360,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-version --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"version","caption":"Ollama version","category":"llm","description":"Return the Ollama server version via GET /api/version. Useful as a liveness probe.","capabilities":["llm","status","health","ollama"],"phrases":["ollama version","is ollama running","check ollama","ollama health"],"param_type_ref":"/packages/solx-ollama/NoArgParams","result_type_ref":"/packages/solx-ollama/VersionResult","action_config":{"timeout_secs":360,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-pull-model --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"pull_model","caption":"Ollama pull model","category":"llm","description":"Download a model to the Ollama server via POST /api/pull. Streaming is forced off, so this blocks with no progress output until the download finishes - it can take many minutes for a large model.","capabilities":["llm","models","download","ollama"],"phrases":["ollama pull","download a model","install an ollama model","fetch a model"],"param_type_ref":"/packages/solx-ollama/TransferModelParams","result_type_ref":"/packages/solx-ollama/StatusResult","action_config":{"timeout_secs":7260,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-push-model --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"push_model","caption":"Ollama push model","category":"llm","description":"Upload a model to a registry via POST /api/push. The model name must be namespace/model:tag. Streaming is forced off, so this blocks until the upload finishes.","capabilities":["llm","models","upload","ollama"],"phrases":["ollama push","upload a model","publish an ollama model"],"param_type_ref":"/packages/solx-ollama/TransferModelParams","result_type_ref":"/packages/solx-ollama/StatusResult","action_config":{"timeout_secs":7260,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-create-model --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"create_model","caption":"Ollama create model","category":"llm","description":"Create a derived model via POST /api/create, from an existing model plus a system prompt, template, parameters, or quantization. Streaming is forced off.","capabilities":["llm","models","create","ollama"],"phrases":["ollama create model","make a custom model","derive an ollama model","quantize a model"],"param_type_ref":"/packages/solx-ollama/CreateModelParams","result_type_ref":"/packages/solx-ollama/StatusResult","action_config":{"timeout_secs":7260,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-copy-model --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"copy_model","caption":"Ollama copy model","category":"llm","description":"Copy an existing Ollama model to a new name via POST /api/copy.","capabilities":["llm","models","copy","ollama"],"phrases":["ollama copy model","duplicate a model","alias an ollama model"],"param_type_ref":"/packages/solx-ollama/CopyModelParams","result_type_ref":"/packages/solx-ollama/StatusResult","action_config":{"timeout_secs":360,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-delete-model --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"delete_model","caption":"Ollama delete model","category":"llm","description":"Remove a model from the Ollama server via DELETE /api/delete. This frees disk space and cannot be undone.","capabilities":["llm","models","delete","ollama"],"phrases":["ollama delete model","remove a model","uninstall an ollama model","free up model disk space"],"param_type_ref":"/packages/solx-ollama/DeleteModelParams","result_type_ref":"/packages/solx-ollama/StatusResult","action_config":{"timeout_secs":360,"secrets":{"OLLAMA_API_KEY":"$key"}}}';
post action /packages/solx-ollama/ollama-set-api-key --json '{"action_type":"wasm","bin_name":"solx-ollama.wasm","fn_name":"set_api_key","caption":"Ollama set API key","category":"llm","description":"Store an Ollama bearer token under the secret name OLLAMA_API_KEY so the other solx-ollama actions can authenticate to Ollama Cloud or a reverse-proxied server.","capabilities":["llm","secrets","auth","ollama"],"phrases":["set ollama api key","store ollama token","authenticate ollama","configure ollama cloud"],"param_type_ref":"/packages/solx-ollama/SetApiKeyParams","action_config":{"timeout_secs":60,"secrets":{"OLLAMA_API_KEY":"$key"}}}'
