save type /packages/solx-google/CalendarEventGetParams --json '{"description":"Input for get-calendar-event.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["calendarId","eventId"],"properties":{"calendarId":{"type":"string"},"eventId":{"type":"string"}}}}';
save type /packages/solx-google/CalendarEventCreateParams --json '{"description":"Input for create-calendar-event.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["calendarId","summary","start","end"],"properties":{"calendarId":{"type":"string"},"summary":{"type":"string"},"description":{"type":"string"},"start":{"type":"object","additionalProperties":true},"end":{"type":"object","additionalProperties":true},"location":{"type":"string"},"attendees":{"type":"array","items":{"type":"object","additionalProperties":true}}}}}';
save type /packages/solx-google/CalendarEvent --json '{"description":"Google Calendar API Event resource JSON.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":true,"properties":{"id":{"type":"string"},"summary":{"type":"string"},"description":{"type":"string"},"start":{"type":"object","additionalProperties":true},"end":{"type":"object","additionalProperties":true},"location":{"type":"string"},"htmlLink":{"type":"string"}}}}';
save type /packages/solx-google/SolDocToCalendarEventParams --json '{"description":"Input for convert-sol-doc-to-calendar-event.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["start","end"],"properties":{"summary":{"type":"string"},"start":{"type":"string"},"end":{"type":"string"},"all_day":{"type":"boolean"},"time_zone":{"type":"string"},"location":{"type":"string"},"attendees":{"type":"array","items":{"type":"string"}},"sol_document":{"type":"object","additionalProperties":true},"sol_document_name":{"type":"string"},"text_field_hint":{"type":"string"}}}}';
save type /packages/solx-google/SolDocToCalendarEventResult --json '{"description":"Result for convert-sol-doc-to-calendar-event.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"summary":{"type":"string"},"description":{"type":"string"},"start":{"type":"object","additionalProperties":true},"end":{"type":"object","additionalProperties":true},"create_body":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';
save type /packages/solx-google/CalendarEventToSolDocParams --json '{"description":"Input for convert-calendar-event-to-sol-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["calendar_event"],"properties":{"calendar_event":{"type":"object","additionalProperties":true},"output_document_name":{"type":"string"},"output_type_name":{"type":"string"}}}}';
save type /packages/solx-google/CalendarEventToSolDocResult --json '{"description":"Result for convert-calendar-event-to-sol-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"event_id":{"type":["string","null"]},"summary":{"type":"string"},"description":{"type":"string"},"start":{"type":"object","additionalProperties":true},"end":{"type":"object","additionalProperties":true},"location":{"type":["string","null"]},"suggested_document_name":{"type":"string"},"sol_document_payload":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';


save action /packages/solx-google/get-google-doc --json '{"actionType":"webhook","fnName":"https://docs.googleapis.com/v1/documents/{documentId}","caption":"Get Google Doc (REST)","category":"google-workspace","description":"Fetches a Google Doc via GET https://docs.googleapis.com/v1/documents/{documentId}.","capabilities":["google-workspace","docs","rest","webhook","read"],"phrases":["get google doc","read google doc","fetch google docs document"],"paramTypeRef":"/packages/solx-google/GoogleDocsGetParams","resultTypeRef":"/packages/solx-google/GoogleDocsDoc","actionConfig":{"method":"GET","secrets":{"GOOGLE_OAUTH_CLIENT_ID":"'$key'","GOOGLE_OAUTH_CLIENT_SECRET":"'$key'","GOOGLE_OAUTH_REFRESH_TOKEN":"'$key'"},"timeout_secs":30,"path_params":{"documentId":""},"auth":{"type":"oauth_refresh","client_id_secret":"GOOGLE_OAUTH_CLIENT_ID","client_secret_secret":"GOOGLE_OAUTH_CLIENT_SECRET","refresh_token_secret":"GOOGLE_OAUTH_REFRESH_TOKEN","token_uri":"https://oauth2.googleapis.com/token","scope":"https://www.googleapis.com/auth/documents.readonly"}}}';
save action /packages/solx-google/post-google-doc --json '{"actionType":"webhook","fnName":"https://docs.googleapis.com/v1/documents/{documentId}:batchUpdate","caption":"Post Google Doc (REST)","category":"google-workspace","description":"Updates a Google Doc via documents.batchUpdate.","capabilities":["google-workspace","docs","rest","webhook","write"],"phrases":["post google doc","write google doc","update google doc"],"paramTypeRef":"/packages/solx-google/GoogleDocsPostParams","actionConfig":{"secrets":{"GOOGLE_OAUTH_CLIENT_ID":"'$key'","GOOGLE_OAUTH_CLIENT_SECRET":"'$key'","GOOGLE_OAUTH_REFRESH_TOKEN":"'$key'"},"timeout_secs":60,"path_params":{"documentId":""},"auth":{"type":"oauth_refresh","client_id_secret":"GOOGLE_OAUTH_CLIENT_ID","client_secret_secret":"GOOGLE_OAUTH_CLIENT_SECRET","refresh_token_secret":"GOOGLE_OAUTH_REFRESH_TOKEN","token_uri":"https://oauth2.googleapis.com/token","scope":"https://www.googleapis.com/auth/documents"}}}';

# WASM converters (solx-google-actions.wasm, uploaded above): the Sol <->
# Google Docs pair plus the batch uploader built on the same converter.
# Each calls create-google-file/post-google-doc/upload-google-drive-image
# via its own action-exec recursion, so no OAuth secrets are needed here
# -- the callee actions above already carry their own action_config.secrets.
save action /packages/solx-google/convert-sol-doc-to-google-doc --json '{"actionType":"wasm","binName":"solx-google-actions.wasm","fnName":"convert-sol-doc-to-google-doc","caption":"Convert Sol document to Google Docs payload","category":"google-workspace","description":"Converts a Sol document (Tiptap rich text) into a Google Docs create_body + batchUpdate body, ready to pass to create-google-file and post-google-doc.","capabilities":["google-workspace","docs","convert"],"phrases":["convert sol document to google doc","turn document into google doc"],"paramTypeRef":"/packages/solx-google/SolDocToGoogleDocParams","resultTypeRef":"/packages/solx-google/SolDocToGoogleDocResult","actionConfig":{"timeout_secs":60}}';
save action /packages/solx-google/convert-google-doc-to-sol-doc --json '{"actionType":"wasm","binName":"solx-google-actions.wasm","fnName":"convert-google-doc-to-sol-doc","caption":"Convert Google Doc to Sol document","category":"google-workspace","description":"Converts a fetched Google Docs API document JSON into a Sol document payload.","capabilities":["google-workspace","docs","convert"],"phrases":["convert google doc to sol document","import google doc"],"paramTypeRef":"/packages/solx-google/GoogleDocToSolDocParams","resultTypeRef":"/packages/solx-google/GoogleDocToSolDocResult","actionConfig":{"timeout_secs":30}}';
save action /packages/solx-google/upload-documents-to-google-docs --json '{"actionType":"wasm","binName":"solx-google-actions.wasm","fnName":"upload-documents-to-google-docs","caption":"Upload documents to Google Docs","category":"google-workspace","description":"Lists the N most/least-recently-updated Sol documents under a path, converts each to Google Docs format, and creates a populated Google Doc for each one via create-google-file and post-google-doc. Fail-fast: stops on the first failing document.","capabilities":["google-workspace","docs","batch","write"],"phrases":["upload documents to google docs","export documents to google docs","batch upload to google docs"],"paramTypeRef":"/packages/solx-google/UploadDocsToGoogleDocsParams","resultTypeRef":"/packages/solx-google/UploadDocsToGoogleDocsResult","actionConfig":{"timeout_secs":300}}';


save action /packages/solx-google/find-google-drive-folder --json '{"actionType":"webhook","fnName":"https://www.googleapis.com/drive/v3/files","caption":"Find Google Drive file or folder","category":"google-workspace","description":"GET https://www.googleapis.com/drive/v3/files.","capabilities":["google-workspace","drive","rest","webhook","read"],"phrases":["find google drive folder","search drive"],"paramTypeRef":"/packages/solx-google/GoogleDriveFindFolderParams","actionConfig":{"method":"GET","secrets":{"GOOGLE_OAUTH_CLIENT_ID":"'$key'","GOOGLE_OAUTH_CLIENT_SECRET":"'$key'","GOOGLE_OAUTH_REFRESH_TOKEN":"'$key'"},"timeout_secs":30,"auth":{"type":"oauth_refresh","client_id_secret":"GOOGLE_OAUTH_CLIENT_ID","client_secret_secret":"GOOGLE_OAUTH_CLIENT_SECRET","refresh_token_secret":"GOOGLE_OAUTH_REFRESH_TOKEN","token_uri":"https://oauth2.googleapis.com/token","scope":"https://www.googleapis.com/auth/drive.file"}}}';
