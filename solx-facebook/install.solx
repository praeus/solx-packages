save file files/actions/shared/solx-facebook-actions.wasm --file bin/solx-facebook-actions.wasm;

# Reinstalling (e.g. to pick up a new package version) must not rotate the
# encryption key baked into every action below -- that would make every
# already-persisted secret (the Page access token, app id/secret)
# undecryptable and force the user through login again. If this package was
# installed before (any action already exists under our path), reuse "***":
# `save action` restores the real stored value for any secret whose incoming
# value is that sentinel (see solx-actions::mask::unmask_merge) rather than
# overwriting it. Only a genuinely first-time install generates a fresh key.
$existing = list action --path /packages/solx-facebook --limit 1;
if $existing.total > 0 then
    $key = "***";
else
    $key = random 32;
endif

exec /builtin/file/file-put --json '{"rel_path": "files/actions/shared/solx-facebook-login.solx", "content": "# solx-facebook login script\n#\n# Obtains a Facebook Page access token and persists it to the scoped secret\n# store as FACEBOOK_PAGE_ACCESS_TOKEN, where every Page post action picks it\n# up as a Bearer token. Runs as a Script-type action whose bin_name points at\n# this file (uploaded during install via file-put).\n#\n# Two modes:\n#\n#   A. Manual: the caller passes page_access_token (e.g. copied from the\n#      Graph API Explorer). It is validated against GET /me and stored.\n#\n#   B. OAuth (default):\n#      1. Read previously-persisted app_id / app_secret (if any).\n#      2. Bind the OAuth loopback listener on 127.0.0.1:{port} (default 8765).\n#      3. Open the Facebook Login dialog in the system browser.\n#      4. Await the OAuth callback (up to {timeout_secs} seconds).\n#      5. Exchange the code for a short-lived user token via the internal\n#         _private/oauth-token-exchange action, then trade it for a\n#         long-lived user token (fb_exchange_token grant).\n#      6. List the Pages the user manages (GET /me/accounts). A Page token\n#         derived from a long-lived user token does not expire, so no\n#         refresh flow is needed afterwards.\n#      7. Pick the Page matching page_id (or the first Page if page_id is\n#         omitted) and persist its access token.\n#      8. Always release the loopback port.\n#\n# Facebook has no refresh tokens: to switch Pages or recover from a revoked\n# token, just run this again.\n\n# The runner seeds $params from the caller\u0027s payload (see ActionCommandRunner).\n$existing_app_id = exec /builtin/secrets/get-secret --json {\"name\": \"FACEBOOK_APP_ID\"};\n$existing_app_secret = exec /builtin/secrets/get-secret --json {\"name\": \"FACEBOOK_APP_SECRET\"};\n\n$page_token = null;\n\nif $params.page_access_token != null then\n    $page_token = $params.page_access_token;\nelse if $params.app_id == null && $existing_app_id.result.value == null then\n    $result = {\"succeeded\": false, \"error\": \"missing_app_id\", \"error_description\": \"supply app_id and app_secret (or page_access_token) in params on first run\"};\nelse\n    $app_id = $params.app_id || $existing_app_id.result.value;\n    $app_secret = $params.app_secret || $existing_app_secret.result.value;\n    $scope = $params.scope || \"pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_posts\";\n\n    # Preflight, before any port is bound or browser opened: look the app up\n    # with an app access token (\"<app_id>|<app_secret>\"). A wrong app_id or\n    # app_secret fails here with Facebook\u0027s own error message, instead of\n    # the login dialog\u0027s opaque \"Invalid App ID\" page.\n    $app_token = \"$app_id|$app_secret\";\n    $app = exec /packages/solx-facebook/_private/check-app-credentials --json {\n        \"app_id\": $app_id,\n        \"access_token\": $app_token,\n        \"fields\": \"id,name\",\n    };\n\n    # 0 is treated the same as absent (`||` falls back on any falsy value):\n    # neither a loopback port nor an await timeout can meaningfully be 0, and\n    # callers whose UI form defaults a blank optional integer field to 0\n    # (rather than omitting it) would otherwise cause an instant oauth-await\n    # timeout.\n    $port = $params.port || 8765;\n    $timeout = $params.timeout_secs || 300;\n\n    $loopback = exec /builtin/oauth/oauth-start --json {\"port\": $port};\n\n    # redirect_uri must match byte-for-byte between this dialog URL and the\n    # token exchange below, and must be listed under the app\u0027s Facebook\n    # Login \"Valid OAuth Redirect URIs\".\n    $auth_url = \"https://www.facebook.com/v25.0/dialog/oauth?response_type=code&client_id=$app_id&redirect_uri=$loopback.result.redirect_uri&scope=$scope&state=$loopback.result.state_value\";\n\n    exec /builtin/web/open-url --json {\"url\": $auth_url};\n\n    $callback = exec /builtin/oauth/oauth-await --json {\"state_value\": $loopback.result.state_value, \"timeout_secs\": $timeout};\n\n    # Always release the loopback port, whether or not the callback succeeded.\n    exec /builtin/oauth/oauth-stop --json {\"state_value\": $loopback.result.state_value};\n\n    if $callback.result.succeeded == true then\n        # The token-exchange action resolves client_id/client_secret through\n        # its OWN configured secret store, not from exec params, so they must\n        # be persisted *before* the exchange.\n        exec /builtin/secrets/set-secret --json {\"name\": \"FACEBOOK_APP_ID\", \"value\": $app_id};\n        exec /builtin/secrets/set-secret --json {\"name\": \"FACEBOOK_APP_SECRET\", \"value\": $app_secret};\n\n        $short = exec /packages/solx-facebook/_private/oauth-token-exchange --json {\n            \"code\": $callback.result.code,\n            \"redirect_uri\": $loopback.result.redirect_uri,\n        };\n\n        $long = exec /packages/solx-facebook/_private/exchange-long-lived-token --json {\n            \"grant_type\": \"fb_exchange_token\",\n            \"client_id\": $app_id,\n            \"client_secret\": $app_secret,\n            \"fb_exchange_token\": $short.result.access_token,\n        };\n\n        $accounts = exec /packages/solx-facebook/_private/list-managed-pages --json {\n            \"access_token\": $long.result.access_token,\n            \"fields\": \"id,name,access_token\",\n            \"limit\": 100,\n        };\n\n        if $params.page_id == null then\n            $page_token = $accounts.result.data.0.access_token;\n        else\n            for $candidate in $accounts.result.data\n                if $candidate.id == $params.page_id then\n                    $page_token = $candidate.access_token;\n                endif\n            endfor\n        endif\n\n        if $page_token == null || $page_token == \"null\" then\n            $result = {\"succeeded\": false, \"error\": \"page_not_found\", \"error_description\": \"the authorized user manages no Page matching page_id (or none at all); check the Pages granted in the login dialog\"};\n        endif\n    else\n        $result = {\"succeeded\": false, \"error\": $callback.result.error, \"error_description\": $callback.result.error_description};\n    endif\nendif\n\nif $page_token != null && $page_token != \"null\" then\n    # Validates the token (a bad one fails the call) and tells the caller\n    # which Page it belongs to. With a Page token, /me is the Page itself.\n    $page = exec /packages/solx-facebook/_private/get-token-identity --json {\"access_token\": $page_token, \"fields\": \"id,name\"};\n\n    exec /builtin/secrets/set-secret --json {\"name\": \"FACEBOOK_PAGE_ACCESS_TOKEN\", \"value\": $page_token};\n\n    $result = {\"succeeded\": true, \"page\": $page.result};\nendif\n\n# A script\u0027s value is its last statement\u0027s, and the `if` above yields null\n# whenever it is skipped (every failure path), so emit $result explicitly.\n$result;\n"}';

save action /packages/solx-facebook/login-to-facebook --json '{"actionType":"script","binName":"solx-facebook-login.solx","files":[{"name":"solx-facebook-login.solx","relPath":"files/actions/shared/solx-facebook-login.solx","contentType":"text/x-solx"}],"caption":"Log in to Facebook (store a Page access token)","category":"facebook","description":"Obtains a Facebook Page access token and persists it via /builtin/secrets/set-secret. Either pass page_access_token directly, or pass app_id/app_secret to run the Facebook Login OAuth flow (loopback listener + system browser), exchange for a long-lived user token, and pick the managed Page matching page_id (first Page if omitted). Page tokens derived this way do not expire.","capabilities":["facebook","oauth","orchestration","script"],"phrases":["log in to facebook","login to facebook","facebook login","connect facebook page","set facebook page token"],"paramTypeRef":"/packages/solx-facebook/FacebookLoginParams","actionConfig":{"secrets":{"FACEBOOK_APP_ID":"'$key'","FACEBOOK_APP_SECRET":"'$key'","FACEBOOK_PAGE_ACCESS_TOKEN":"'$key'"}}}';


save type /packages/solx-facebook/FacebookLoginParams --json '{"description":"Input for login-to-facebook (and its internal token-exchange steps). Supply either page_access_token (manual mode) or app_id + app_secret (OAuth mode; persisted, so later runs may omit them).","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"page_access_token":{"type":"string","description":"Manual mode: an existing Page access token (e.g. from the Graph API Explorer). Skips OAuth entirely."},"app_id":{"type":"string","description":"Meta app ID (OAuth mode)."},"app_secret":{"type":"string","description":"Meta app secret (OAuth mode)."},"page_id":{"type":"string","description":"OAuth mode: which managed Page to connect. Defaults to the first Page returned by /me/accounts."},"scope":{"type":"string","description":"Comma-separated permissions. Defaults to pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_posts."},"port":{"type":"integer","description":"Loopback port for the OAuth redirect (default 8765)."},"timeout_secs":{"type":"integer","description":"How long to wait for the browser callback (default 300)."},"code":{"type":"string"},"redirect_uri":{"type":"string"}}}}';
save type /packages/solx-facebook/FacebookPostGetParams --json '{"description":"Input for get-facebook-post (GET https://graph.facebook.com/v25.0/{post_id}).","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["post_id"],"properties":{"post_id":{"type":"string","description":"Page post ID ({page_id}_{post_id} form, as returned by create/list). Filled into the URL, not sent as a query param."},"fields":{"type":"string","description":"Comma-separated fields to return, e.g. id,message,created_time,updated_time,permalink_url,full_picture,is_published,status_type. Without it Graph returns only id, message, created_time."}}}}';
save type /packages/solx-facebook/FacebookPostCreateParams --json '{"description":"Input for create-facebook-post (POST https://graph.facebook.com/v25.0/me/feed as the connected Page). At least one of message or link is required.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"message":{"type":"string","description":"Post text."},"link":{"type":"string","description":"URL to attach as a link preview."},"published":{"type":"boolean","description":"false creates an unpublished post; required (false) when scheduled_publish_time is set."},"scheduled_publish_time":{"type":["integer","string"],"description":"UNIX timestamp or ISO 8601 string, 10 minutes to 30 days in the future. Requires published=false."}},"additionalProperties":true}}';
save type /packages/solx-facebook/FacebookPostUpdateParams --json '{"description":"Input for update-facebook-post (POST https://graph.facebook.com/v25.0/{post_id}). Only posts created by this app can be updated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["post_id"],"properties":{"post_id":{"type":"string","description":"Page post ID. Filled into the URL, not sent in the body."},"message":{"type":"string","description":"Replacement post text."},"is_published":{"type":"boolean","description":"true publishes a previously unpublished post."}},"additionalProperties":true}}';
save type /packages/solx-facebook/FacebookPostListParams --json '{"description":"Input for list-facebook-posts (GET https://graph.facebook.com/v25.0/me/posts). Paginate by passing the previous response paging.cursors.after as after (older posts) or paging.cursors.before as before (newer posts); a response with no paging.next is the last page. The Graph API has no keyword search on Page posts: narrow by date with since/until.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"fields":{"type":"string","description":"Comma-separated fields per post, e.g. id,message,created_time,permalink_url,full_picture."},"limit":{"type":"integer","minimum":1,"maximum":100,"description":"Posts per page (Graph default 25)."},"after":{"type":"string","description":"Cursor from paging.cursors.after of the previous page."},"before":{"type":"string","description":"Cursor from paging.cursors.before of the previous page."},"since":{"type":["integer","string"],"description":"Only posts created at or after this time (UNIX timestamp or strtotime-style string, e.g. 2026-01-01)."},"until":{"type":["integer","string"],"description":"Only posts created before this time (UNIX timestamp or strtotime-style string)."}},"additionalProperties":true}}';
save type /packages/solx-facebook/FacebookPost --json '{"description":"Graph API Page post (PagePost) JSON. Which fields are present depends on the fields requested.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":true,"properties":{"id":{"type":"string"},"message":{"type":"string"},"created_time":{"type":"string"},"updated_time":{"type":"string"},"permalink_url":{"type":"string"},"full_picture":{"type":"string"},"is_published":{"type":"boolean"},"status_type":{"type":"string"}}}}';
save type /packages/solx-facebook/FacebookPostList --json '{"description":"Graph API paged list of Page posts.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":true,"properties":{"data":{"type":"array","items":{"type":"object","additionalProperties":true}},"paging":{"type":"object","additionalProperties":true,"properties":{"cursors":{"type":"object","properties":{"before":{"type":"string"},"after":{"type":"string"}}},"next":{"type":"string"},"previous":{"type":"string"}}}}}}';
save type /packages/solx-facebook/FacebookCommentListParams --json '{"description":"Input for list-facebook-comments (GET https://graph.facebook.com/v25.0/{object_id}/comments). Paginate with after/before cursors from the previous response paging.cursors.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["object_id"],"properties":{"object_id":{"type":"string","description":"Post ID for its top-level comments, or a comment ID for its replies. Filled into the URL."},"fields":{"type":"string","description":"Comma-separated fields, e.g. id,message,created_time,from{id,name},comment_count. Commenter from needs pages_read_user_content."},"filter":{"type":"string","enum":["toplevel","stream"],"description":"toplevel (default) or stream (all comments flattened, replies included)."},"order":{"type":"string","enum":["chronological","reverse_chronological"]},"limit":{"type":"integer","minimum":1,"maximum":100},"after":{"type":"string"},"before":{"type":"string"}},"additionalProperties":true}}';
save type /packages/solx-facebook/FacebookPostToSolDocParams --json '{"description":"Input for convert-facebook-post-to-sol-doc. Makes no network calls: comments come from the post own comments.data (requested via field expansion), and the picture is referenced, not downloaded.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["facebook_post"],"properties":{"facebook_post":{"type":"object","additionalProperties":true,"description":"A Graph API post, e.g. from get-facebook-post. Useful fields: id,message,story,created_time,updated_time,permalink_url,full_picture,from{id,name},attachments{type,title,url,unshimmed_url},comments{message,created_time,from,comments{message,created_time,from}}."},"path":{"type":"string","description":"Document path. Defaults to /blogs/facebook/<page-name-slug>."},"output_document_name":{"type":"string","description":"Document name. Defaults to the post ID."},"output_type_ref":{"type":"string","description":"Document type. Defaults to /types/docs/BlogPostWithComments."}}}}';
save type /packages/solx-facebook/FacebookPostToSolDocResult --json '{"description":"Result for convert-facebook-post-to-sol-doc. sol_document_payload is shaped for /builtin/document/entity-save-document and can be passed to it directly.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"post_id":{"type":["string","null"]},"title":{"type":"string"},"text":{"type":"string"},"suggested_document_path":{"type":"string"},"suggested_document_name":{"type":"string"},"sol_document_payload":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';
save type /packages/solx-facebook/ImportFacebookPostParams --json '{"description":"Input for import-facebook-post.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["post_id"],"properties":{"post_id":{"type":"string","description":"Page post ID ({page_id}_{post_id})."},"path":{"type":"string","description":"Document path. Defaults to /blogs/facebook/<page-name-slug>."},"include_comments":{"type":"boolean","description":"Import the comment thread (comments and their replies). Default true."},"max_comments":{"type":"integer","minimum":0,"description":"Cap on comments + replies imported for the post. Default 500."},"download_picture":{"type":"boolean","description":"Store the post full_picture in the files store as the document icon. Default true; best-effort."}}}}';
save type /packages/solx-facebook/ImportFacebookPostResult --json '{"description":"Result for import-facebook-post: the saved document.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"post_id":{"type":"string"},"document_path":{"type":"string"},"document_name":{"type":"string"},"title":{"type":"string"},"comments":{"type":"integer"},"comments_truncated":{"type":"boolean"},"icon":{"type":["string","null"]}}}}';
save type /packages/solx-facebook/ImportFacebookPostsParams --json '{"description":"Input for import-facebook-posts. Imports the connected Page own posts, newest first. To continue a previous run, pass its next_after as after.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"count":{"type":"integer","minimum":1,"description":"Maximum number of posts to import. Default 25."},"since":{"type":["integer","string"],"description":"Only posts created at or after this time (UNIX timestamp or strtotime-style string)."},"until":{"type":["integer","string"],"description":"Only posts created before this time."},"after":{"type":"string","description":"Resume cursor: next_after from a previous run."},"path":{"type":"string","description":"Document path. Defaults to /blogs/facebook/<page-name-slug>."},"include_comments":{"type":"boolean","description":"Default true."},"max_comments":{"type":"integer","minimum":0,"description":"Per-post cap on comments + replies. Default 500."},"download_picture":{"type":"boolean","description":"Default true; best-effort."}}}}';
save type /packages/solx-facebook/ImportFacebookPostsResult --json '{"description":"Result for import-facebook-posts. Individual post failures do not stop the batch; they are listed in failed. next_after is null once there are no more posts.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"requested":{"type":"integer"},"imported":{"type":"array","items":{"type":"object","additionalProperties":true}},"failed":{"type":"array","items":{"type":"object","properties":{"post_id":{"type":"string"},"error":{"type":"string"}}}},"cancelled":{"type":"boolean"},"next_after":{"type":["string","null"]}}}}';
save type /packages/solx-facebook/FacebookWriteResult --json '{"description":"Graph API write response: {id} for a new post, {success} for an update.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":true,"properties":{"id":{"type":"string"},"success":{"type":"boolean"}}}}';


# Page post actions. All authenticate with the stored Page access token as a
# Bearer header. With a Page token, /me resolves to the Page itself, so no
# page_id is needed. ttl_secs keeps the in-memory token cache short so a
# re-login (switching Pages) takes effect within minutes.
save action /packages/solx-facebook/get-facebook-post --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/{post_id}","caption":"Get Facebook Page post","category":"facebook","description":"GET https://graph.facebook.com/v25.0/{post_id}. Pass fields to choose what is returned.","capabilities":["facebook","pages","rest","webhook","read"],"phrases":["get facebook post","read facebook post","fetch facebook page post"],"paramTypeRef":"/packages/solx-facebook/FacebookPostGetParams","resultTypeRef":"/packages/solx-facebook/FacebookPost","actionConfig":{"method":"GET","secrets":{"FACEBOOK_PAGE_ACCESS_TOKEN":"'$key'"},"timeout_secs":30,"path_params":{"post_id":""},"auth":{"type":"bearer","token_secret":"FACEBOOK_PAGE_ACCESS_TOKEN","ttl_secs":300}}}';
save action /packages/solx-facebook/create-facebook-post --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/me/feed","caption":"Create Facebook Page post","category":"facebook","description":"POST https://graph.facebook.com/v25.0/me/feed as the connected Page. Publishes immediately, or schedules with published=false + scheduled_publish_time. Returns {id}.","capabilities":["facebook","pages","rest","webhook","write"],"phrases":["post to facebook","create facebook post","publish facebook post","schedule facebook post"],"paramTypeRef":"/packages/solx-facebook/FacebookPostCreateParams","resultTypeRef":"/packages/solx-facebook/FacebookWriteResult","actionConfig":{"secrets":{"FACEBOOK_PAGE_ACCESS_TOKEN":"'$key'"},"timeout_secs":60,"auth":{"type":"bearer","token_secret":"FACEBOOK_PAGE_ACCESS_TOKEN","ttl_secs":300}}}';
save action /packages/solx-facebook/update-facebook-post --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/{post_id}","caption":"Update Facebook Page post","category":"facebook","description":"POST https://graph.facebook.com/v25.0/{post_id}. Edits the message of (or publishes) a post created by this app. Returns {success}.","capabilities":["facebook","pages","rest","webhook","write"],"phrases":["update facebook post","edit facebook post"],"paramTypeRef":"/packages/solx-facebook/FacebookPostUpdateParams","resultTypeRef":"/packages/solx-facebook/FacebookWriteResult","actionConfig":{"secrets":{"FACEBOOK_PAGE_ACCESS_TOKEN":"'$key'"},"timeout_secs":60,"path_params":{"post_id":""},"auth":{"type":"bearer","token_secret":"FACEBOOK_PAGE_ACCESS_TOKEN","ttl_secs":300}}}';
save action /packages/solx-facebook/list-facebook-posts --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/me/posts","caption":"List/search Facebook Page posts","category":"facebook","description":"GET https://graph.facebook.com/v25.0/me/posts: the connected Page own posts, newest first. Filter by date with since/until; paginate with the after/before cursors from the previous response paging.cursors.","capabilities":["facebook","pages","rest","webhook","read"],"phrases":["list facebook posts","search facebook posts","facebook page posts","recent facebook posts"],"paramTypeRef":"/packages/solx-facebook/FacebookPostListParams","resultTypeRef":"/packages/solx-facebook/FacebookPostList","actionConfig":{"method":"GET","secrets":{"FACEBOOK_PAGE_ACCESS_TOKEN":"'$key'"},"timeout_secs":30,"auth":{"type":"bearer","token_secret":"FACEBOOK_PAGE_ACCESS_TOKEN","ttl_secs":300}}}';
save action /packages/solx-facebook/list-facebook-comments --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/{object_id}/comments","caption":"List Facebook comments","category":"facebook","description":"GET https://graph.facebook.com/v25.0/{object_id}/comments: a post top-level comments, or a comment replies. Paginate with the after/before cursors from the previous response paging.cursors.","capabilities":["facebook","pages","rest","webhook","read"],"phrases":["list facebook comments","get facebook post comments"],"paramTypeRef":"/packages/solx-facebook/FacebookCommentListParams","actionConfig":{"method":"GET","secrets":{"FACEBOOK_PAGE_ACCESS_TOKEN":"'$key'"},"timeout_secs":30,"path_params":{"object_id":""},"auth":{"type":"bearer","token_secret":"FACEBOOK_PAGE_ACCESS_TOKEN","ttl_secs":300}}}';


# WASM converters (solx-facebook-actions.wasm, uploaded above). They call the
# webhook actions above through action-exec, so no secrets are needed here --
# the callees carry their own action_config.secrets.
save action /packages/solx-facebook/convert-facebook-post-to-sol-doc --json '{"actionType":"wasm","binName":"solx-facebook-actions.wasm","files":[{"name":"solx-facebook-actions.wasm","relPath":"files/actions/shared/solx-facebook-actions.wasm","contentType":"application/wasm"}],"fnName":"convert-facebook-post-to-sol-doc","caption":"Convert Facebook post to Sol document","category":"facebook","description":"Converts a fetched Graph API post (with any comments requested via field expansion) into a BlogPostWithComments document payload, ready to pass to /builtin/document/entity-save-document. Makes no network calls and saves nothing.","capabilities":["facebook","pages","convert"],"phrases":["convert facebook post to sol document","convert facebook post to document"],"paramTypeRef":"/packages/solx-facebook/FacebookPostToSolDocParams","resultTypeRef":"/packages/solx-facebook/FacebookPostToSolDocResult","actionConfig":{"timeout_secs":30}}';
save action /packages/solx-facebook/import-facebook-post --json '{"actionType":"wasm","binName":"solx-facebook-actions.wasm","files":[{"name":"solx-facebook-actions.wasm","relPath":"files/actions/shared/solx-facebook-actions.wasm","contentType":"application/wasm"}],"fnName":"import-facebook-post","caption":"Import Facebook post as a document","category":"facebook","description":"Fetches one Page post, its comment thread, and its picture, and saves it as a BlogPostWithComments document (default path /blogs/facebook/<page>, name = post ID, so re-importing updates the same document).","capabilities":["facebook","pages","import","write"],"phrases":["import facebook post","save facebook post as document","import facebook post with comments"],"paramTypeRef":"/packages/solx-facebook/ImportFacebookPostParams","resultTypeRef":"/packages/solx-facebook/ImportFacebookPostResult","actionConfig":{"timeout_secs":300}}';
save action /packages/solx-facebook/import-facebook-posts --json '{"actionType":"wasm","binName":"solx-facebook-actions.wasm","files":[{"name":"solx-facebook-actions.wasm","relPath":"files/actions/shared/solx-facebook-actions.wasm","contentType":"application/wasm"}],"fnName":"import-facebook-posts","caption":"Import Facebook posts as documents","category":"facebook","description":"Pages through the connected Page posts (newest first, optionally within since/until) and saves up to count of them as BlogPostWithComments documents. Per-post failures are collected rather than stopping the batch; next_after resumes a later run.","capabilities":["facebook","pages","import","batch","write"],"phrases":["import facebook posts","import facebook page","archive facebook page posts","save facebook posts as documents"],"paramTypeRef":"/packages/solx-facebook/ImportFacebookPostsParams","resultTypeRef":"/packages/solx-facebook/ImportFacebookPostsResult","actionConfig":{"timeout_secs":1800}}';


# Internal steps of login-to-facebook. Not meant to be invoked standalone.
# The token-passing ones take access_token as a query param (the Graph API
# accepts it there) because the token being inspected is not yet stored;
# webhook console logs record the URL without its query string.
save action /packages/solx-facebook/_private/oauth-token-exchange --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/oauth/access_token","caption":"Facebook OAuth code exchange","category":"facebook","description":"Internal step of login-to-facebook: exchanges an OAuth code (already obtained via the loopback listener) for a short-lived user access token. Not meant to be invoked standalone.","capabilities":["facebook","oauth","rest","webhook","internal"],"phrases":["facebook oauth token exchange"],"paramTypeRef":"/packages/solx-facebook/FacebookLoginParams","actionConfig":{"secrets":{"FACEBOOK_APP_ID":"'$key'","FACEBOOK_APP_SECRET":"'$key'"},"timeout_secs":30,"auth":{"type":"oauth_authorization_code","client_id_secret":"FACEBOOK_APP_ID","client_secret_secret":"FACEBOOK_APP_SECRET","grant_type":"authorization_code"}}}';
save action /packages/solx-facebook/_private/check-app-credentials --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/{app_id}","caption":"Validate Facebook app credentials","category":"facebook","description":"Internal preflight of login-to-facebook: GET /{app_id} with an app access token (app_id|app_secret), so a wrong app id or secret fails before the login dialog opens. Not meant to be invoked standalone.","capabilities":["facebook","oauth","rest","webhook","internal"],"phrases":["check facebook app credentials"],"actionConfig":{"method":"GET","timeout_secs":30,"path_params":{"app_id":""}}}';
save action /packages/solx-facebook/_private/exchange-long-lived-token --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/oauth/access_token","caption":"Facebook long-lived token exchange","category":"facebook","description":"Internal step of login-to-facebook: trades a short-lived user token for a long-lived one (grant_type=fb_exchange_token). Not meant to be invoked standalone.","capabilities":["facebook","oauth","rest","webhook","internal"],"phrases":["facebook long lived token"],"actionConfig":{"method":"GET","timeout_secs":30}}';
save action /packages/solx-facebook/_private/list-managed-pages --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/me/accounts","caption":"List Pages managed by a Facebook user","category":"facebook","description":"Internal step of login-to-facebook: GET /me/accounts with a user access_token, returning each managed Page and its Page access token. Not meant to be invoked standalone.","capabilities":["facebook","oauth","rest","webhook","internal"],"phrases":["list facebook managed pages"],"actionConfig":{"method":"GET","timeout_secs":30}}';
save action /packages/solx-facebook/_private/get-token-identity --json '{"actionType":"webhook","fnName":"https://graph.facebook.com/v25.0/me","caption":"Identify a Facebook access token","category":"facebook","description":"Internal step of login-to-facebook: GET /me with an access_token to validate it and return the Page (or user) it belongs to. Not meant to be invoked standalone.","capabilities":["facebook","oauth","rest","webhook","internal"],"phrases":["facebook token identity"],"actionConfig":{"method":"GET","timeout_secs":30}}';
