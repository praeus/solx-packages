
$key = exec /builtin/random_string --json '{"length":32}';

exec /builtin/file_put --json '{"rel_path": "files/actions/shared/solx-google-login.solx", "content": "$existing_client_id = exec /builtin/get_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_CLIENT_ID\"}\u0027;\n$existing_client_secret = exec /builtin/get_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_CLIENT_SECRET\"}\u0027;\n$existing_scope = exec /builtin/get_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_SCOPE\"}\u0027;\nif $params.client_id == null;\n$client_id = json \u0027\"$existing_client_id.value\"\u0027;\nelse;\n$client_id = json \u0027\"$params.client_id\"\u0027;\nendif;\nif $params.client_secret == null;\n$client_secret = json \u0027\"$existing_client_secret.value\"\u0027;\nelse;\n$client_secret = json \u0027\"$params.client_secret\"\u0027;\nendif;\nif $params.scope == null;\n$scope = json \u0027\"$existing_scope.value\"\u0027;\nelse;\n$scope = json \u0027\"$params.scope\"\u0027;\nendif;\nif $client_id == \"null\";\n$result = json \u0027{\"succeeded\":false,\"error\":\"missing_client_id\",\"error_description\":\"supply client_id, client_secret, and scope in params on first run\"}\u0027;\nelse;\nif $params.port == null;\n$port = json 8765;\nelse;\n$port = json $params.port;\nendif;\nif $params.timeout_secs == null;\n$timeout = json 300;\nelse;\n$timeout = json $params.timeout_secs;\nendif;\n$loopback = exec /builtin/oauth_start --json \u0027{\"port\":$port}\u0027;\n$auth_url = json \u0027\"https://accounts.google.com/o/oauth2/v2/auth?response_type=code&access_type=offline&prompt=consent&include_granted_scopes=true&client_id=$client_id&redirect_uri=$loopback.redirect_uri&scope=$scope&state=$loopback.state_value\"\u0027;\nexec /builtin/open_url --json \u0027{\"url\":\"$auth_url\"}\u0027;\n$callback = exec /builtin/oauth_await --json \u0027{\"state_value\":\"$loopback.state_value\",\"timeout_secs\":$timeout}\u0027;\nif $callback.succeeded == true;\n$token = exec /packages/solx-google/oauth-token-exchange --json \u0027{\"code\":\"$callback.code\",\"redirect_uri\":\"$loopback.redirect_uri\",\"client_id\":\"$client_id\",\"client_secret\":\"$client_secret\",\"scope\":\"$scope\"}\u0027;\nexec /builtin/set_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_REFRESH_TOKEN\",\"value\":\"$token.refresh_token\"}\u0027;\nexec /builtin/set_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_CLIENT_ID\",\"value\":\"$client_id\"}\u0027;\nexec /builtin/set_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_CLIENT_SECRET\",\"value\":\"$client_secret\"}\u0027;\nexec /builtin/set_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_SCOPE\",\"value\":\"$scope\"}\u0027;\n$result = json \u0027{\"succeeded\":true,\"access_token\":\"$token.access_token\",\"refresh_token\":\"$token.refresh_token\",\"expires_in\":$token.expires_in,\"scope\":\"$token.scope\",\"token_type\":\"$token.token_type\"}\u0027;\nelse;\n$result = json \u0027{\"succeeded\":false,\"error\":\"$callback.error\",\"error_description\":\"$callback.error_description\"}\u0027;\nendif;\nexec /builtin/oauth_stop --json \u0027{\"state_value\":\"$loopback.state_value\"}\u0027;\nendif;\njson $result"}';

post action /packages/solx-google/login-to-google --json '{"action_type":"script","bin_name":"solx-google-login.solx","caption":"Log in to Google (one-shot OAuth flow)","category":"google-workspace","description":"Drives the OAuth 2.0 authorization-code flow end-to-end. Binds the loopback listener, opens the system browser, awaits the callback, exchanges the code for tokens, persists the credentials via /builtin/set_secret, and releases the port.","capabilities":["google-workspace","oauth","orchestration","script"],"phrases":["log in to google","login to google","google login","sign in to google","google oauth","connect google"],"param_type_ref":"/packages/solx-google/GoogleOAuthLoginParams","action_config":{"secrets":{"GOOGLE_OAUTH_CLIENT_ID":"'$key.value'","GOOGLE_OAUTH_CLIENT_SECRET":"'$key.value'","GOOGLE_OAUTH_REFRESH_TOKEN":"'$key.value'","GOOGLE_OAUTH_SCOPE":"'$key.value'"}}}';


