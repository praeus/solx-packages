# solx-agent install.
#
# One action and three document types. The harness that used to be six wasm
# actions now ships inside the widget bundle, so there is no build step here
# beyond `npm run build` and nothing to compile through solx-quickjs.
#
# Note for anyone editing the JSON below: a .solx argument is wrapped in
# single quotes, so a literal apostrophe inside one of these descriptions
# silently ends the argument and the rest of the line becomes bare tokens.
# Write any apostrophe as ', or avoid one. (solx-google/install.solx had
# exactly this bug and would not install.)

save type /packages/solx-agent/AgentSession --json '{"description": "The stored state of one agent session: transcript, the tools resolved for the current turn, the grant, the context index, pending calls, and the tool call audit log. Written when the session is created and rewritten several times per turn, so a browser tab closed mid-turn still leaves a true record. Deliberately permissive - the shape evolves with the package, and a session that fails validation mid-loop would strand the run. messages and calls are undeclared on purpose: the full-text index walks only declared fields, so leaving them out keeps the whole transcript out of FTS while still storing it.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "properties": {"model": {"type": "string"}, "title": {"type": "string", "description": "Taken from the first user message. Titles the document so a session list says what each one was about."}, "status": {"type": "string", "description": "running, awaiting_approval, idle, blocked, exhausted, or cancelled. idle means the model handed the turn back - to answer or to ask - not that the session is over."}, "iteration": {"type": "integer", "description": "Monotonic across the session: the audit trail."}, "turn_iteration": {"type": "integer", "description": "Reset each user turn, and what max_iterations is checked against."}, "grant": {"type": "array", "description": "What this session may reach. The model can never widen it; an operator can, from the setup panel, which appends a system turn saying so. Re-checked at dispatch, so editing it in the document buys nothing."}, "tools": {"type": "object", "description": "Tool name to action reference, re-resolved from the newest user message at the top of every turn. The dispatch table, but not the authority: every call is gated again against grant at the moment it runs."}, "memory": {"type": ["object", "null"], "description": "The memory scope and its budgets, fixed when the session is created."}, "memories_written": {"type": "integer"}, "context": {"type": "array", "description": "The context index. sys__context_read can open these and nothing else."}, "skills": {"type": ["object", "null"], "description": "Where skills are read from."}, "pending": {"type": "array", "description": "The calls of the turn in flight. Non-empty while awaiting approval, and also while a turn is mid-dispatch - a half-filled pending list is how a crashed turn is resumed. Cleared at the end of every iteration, so an approval never survives into the next one."}, "answer": {"type": ["string", "null"], "description": "The model reply that handed the turn back, set when status is idle."}}}}';

save type /packages/solx-agent/AgentMemory --json '{"description": "One thing an agent session learned, written by the model through sys__memory_save and recalled by later sessions in the same scope. The text is capped at 1000 characters and stored in the document summary as well as here, which is what lets recall be a single search with no follow-up reads. Treat the text as model output, not as fact: a memory scope is a trust boundary, so keep unrelated tasks in separate scopes.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["text"], "properties": {"text": {"type": "string", "description": "The note itself."}, "tags": {"type": "array", "items": {"type": "string"}, "description": "Optional keywords, indexed for search."}, "scope": {"type": "string", "description": "The memory scope this was written in."}, "sourceSession": {"type": ["string", "null"], "description": "The session that wrote it."}}}}';

save type /packages/solx-agent/AgentSkill --json '{"description": "Operator guidance for using particular tools. Bound to action references by glob, so one skill can cover a whole family. It is injected only when a matching tool is in the resolved catalogue, which means a skill never grants reach - it only explains reach that was already granted. Write one with: solx save document /agent/skills/NAME --type /packages/solx-agent/AgentSkill", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["tools", "instructions"], "properties": {"tools": {"type": "array", "items": {"type": "string"}, "description": "Action reference globs, for example /builtin/document/* or /packages/solx-media/transcode. * matches any characters including /."}, "instructions": {"type": "string", "description": "What the model should know about these tools. Capped at 4000 characters, and 8000 across all skills in one turn."}}}}';

save file files/actions/shared/solx-agent-widget-descriptor.solx --file agent-widget-descriptor.solx;

save file widgets/solx-agent.js --file dist/solx-agent.js;

save action /packages/solx-agent/agent-widget --json '{"actionType": "script", "binName": "solx-agent-widget-descriptor.solx", "caption": "Agent", "category": "widgets", "description": "A supervised agent thread over the solx action catalogue. Chat-shaped but not a chat: one message can mean a dozen iterations and thirty tool calls against real documents, so the work is rendered rather than hidden, and anything destructive stops for a decision. The harness runs in the widget; sessions, memories and skills are ordinary documents under /agent.", "capabilities": ["agent", "widget", "ui", "llm", "tools", "chat"], "phrases": ["open the agent", "show the agent", "start an agent", "run an agent", "give the model tools", "open chat"], "resultTypeRef": "/builtin/types/WidgetDescriptor"}';
