save action /packages/solx-quickjs/build-javascript-file --json '{"actionType":"command","fnName":"build-javascript-file","caption":"Build JavaScript file","category":"development","description":"Compile JavaScript source (read from the file store) into a wasm32-wasip2 component and upload the wasm to files/actions/shared/<output_artifact_name>. Unlike build-javascript-action, this never creates or updates an action row - it only builds and uploads the artifact, so a package can save its own action against the uploaded bin_name.","capabilities":["javascript","build","development","command"],"phrases":["build javascript file","compile javascript to a wasm file","build a js wasm artifact"],"paramTypeRef":"/packages/solx-quickjs/QuickjsBuildFileParams","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-quickjs/target/release","env":{"SOLX_SERVER_URL":"http://127.0.0.1:8766"}}}'
