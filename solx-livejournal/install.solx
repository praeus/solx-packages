save file files/actions/shared/solx-livejournal.wasm --file bin/solx-livejournal.wasm;
save type /packages/solx-livejournal/LjExtractEntryParams --json '{"description":"Extract one LiveJournal entry into a BlogPostWithComments document. Runs through the logged-in Firefox session, so private and friends-locked entries are included when that session can see them.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["user","id"],"properties":{"user":{"type":"string","description":"LiveJournal username, the subdomain of https://<user>.livejournal.com."},"id":{"type":["string","integer"],"description":"Numeric entry id, the <id> in /<id>.html."},"path":{"type":["string","null"],"description":"Document path. Defaults to /blogs/livejournal/<user>."},"security":{"type":["string","null"],"description":"Optional security level to record: public, friends, or private."}}}}';
save type /packages/solx-livejournal/LjHarvestPageParams --json '{"description":"Extract every entry linked from one LiveJournal index page. Returns the pages previous link, which is the resume cursor for the next page.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["user"],"properties":{"user":{"type":"string"},"index":{"type":["string","null"],"description":"Index page path relative to the journal origin, for example / or /?skip=10. Defaults to /."},"path":{"type":["string","null"],"description":"Document path. Defaults to /blogs/livejournal/<user>."}}}}';
save type /packages/solx-livejournal/LjHarvestParams --json '{"description":"Resumable harvest across index pages. Starts from the stored cursor, or page one when it is unset, and advances the cursor after each completed page.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["user"],"properties":{"user":{"type":"string"},"max_pages":{"type":["integer","null"],"description":"How many index pages to process this run. Defaults to 1."},"index":{"type":["string","null"],"description":"Override the starting index page, ignoring the stored cursor."},"path":{"type":["string","null"],"description":"Document path. Defaults to /blogs/livejournal/<user>."},"namespace":{"type":["string","null"],"description":"Env store namespace holding the resume cursor. Defaults to livejournal."},"cursor_key":{"type":["string","null"],"description":"Env store key holding the resume cursor, within the namespace. Defaults to the username."}}}}';
save type /packages/solx-livejournal/LjEntryResult --json '{"description":"One saved entry. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"title":{"type":"string"},"security":{"type":["string","null"]},"comments":{"type":"integer"},"paragraphs":{"type":"integer"}}}}';
save type /packages/solx-livejournal/LjHarvestPageResult --json '{"description":"Outcome of one index page. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"index":{"type":"string"},"prev":{"type":["string","null"],"description":"Previous page link, or null at the end of the journal."},"path":{"type":"string"},"saved":{"type":"array","items":{"type":"object"}},"failed":{"type":"array","items":{"type":"object"}}}}}';
save type /packages/solx-livejournal/LjHarvestResult --json '{"description":"Outcome of a multi-page harvest. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"user":{"type":"string"},"cursor_key":{"type":"string"},"cursor":{"type":"string"},"total_saved":{"type":"integer"},"total_failed":{"type":"integer"},"pages":{"type":"array","items":{"type":"object"}}}}}';
save action /packages/solx-livejournal/lj-extract-entry --json '{"action_type":"wasm","bin_name":"solx-livejournal.wasm","fn_name":"extract_entry","caption":"Extract LiveJournal entry","category":"extraction","description":"Extract one LiveJournal entry and its full comment tree into a BlogPostWithComments document. Requires a running Firefox with the journal signed in. Private and friends-locked entries are included when that session can see them.","capabilities":["livejournal","blog","extraction","comments","browser"],"phrases":["extract a livejournal entry","scrape a livejournal post","save a livejournal entry as a document"],"param_type_ref":"/packages/solx-livejournal/LjExtractEntryParams","result_type_ref":"/packages/solx-livejournal/LjEntryResult","action_config":{"timeout_secs":180}}';
save action /packages/solx-livejournal/lj-harvest-page --json '{"action_type":"wasm","bin_name":"solx-livejournal.wasm","fn_name":"harvest_page","caption":"Harvest LiveJournal index page","category":"extraction","description":"Extract every entry on one LiveJournal index page into BlogPostWithComments documents and return the previous-page link used as the resume cursor.","capabilities":["livejournal","blog","extraction","comments","browser","batch"],"phrases":["harvest a livejournal page","extract a page of livejournal entries","scrape livejournal index page"],"param_type_ref":"/packages/solx-livejournal/LjHarvestPageParams","result_type_ref":"/packages/solx-livejournal/LjHarvestPageResult","action_config":{"timeout_secs":1200}}';
save action /packages/solx-livejournal/lj-harvest --json '{"action_type":"wasm","bin_name":"solx-livejournal.wasm","fn_name":"harvest","caption":"Harvest LiveJournal","category":"extraction","description":"Resumable LiveJournal harvest. Starts from the stored cursor or page one, extracts max_pages index pages, and advances the cursor after each completed page so an interrupted run resumes where it stopped.","capabilities":["livejournal","blog","extraction","comments","browser","batch","resumable"],"phrases":["harvest a livejournal","extract a whole livejournal","back up a livejournal","continue the livejournal extraction"],"param_type_ref":"/packages/solx-livejournal/LjHarvestParams","result_type_ref":"/packages/solx-livejournal/LjHarvestResult","action_config":{"timeout_secs":3600}}'
