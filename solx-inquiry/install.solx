# actionConfig.timeout_secs below (4200s) covers two sequential llm phases,
# each potentially run detached (via /builtin/action/start+poll) up to the
# *child* action's own configured outer ceiling rather than solx-inquiry's
# `timeout_secs` param (which only bounds the inner per-request timeout of
# each phase) - solx-ollama's ollama-chat currently ships with a 1860s outer
# ceiling of its own, so 2x that plus headroom for search and polling.
#
# One quoting trap governs this whole file: a .solx argument is wrapped in
# single quotes, so a literal apostrophe inside one needs a backslash directly
# in front of it. Getting it wrong is silent, not an error - an unescaped
# quote ends the argument right there and the rest of the line becomes
# unrelated bare tokens that still parse. Nothing below contains an
# apostrophe, deliberately.
save file files/actions/shared/solx-inquiry.wasm --file bin/solx-inquiry.wasm;

save type /packages/solx-inquiry/InquireParams --json '{"description":"Parameters for the inquire action: ask a question, let a chat model turn it into search terms, search documents and/or actions, then summarize the results against the question.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["inquiry","model"],"properties":{"inquiry":{"type":"string","description":"The question or topic to investigate."},"model":{"type":"string","description":"Chat model name passed to the llm action for both the search-term and summary calls."},"scope":{"type":["string","null"],"enum":["documents","actions","both",null],"description":"What to search: documents, actions, or both. Defaults to documents."},"max_terms":{"type":["integer","null"],"description":"Upper bound on how many search terms the model may produce. Defaults to 5, clamped to 10."},"max_results":{"type":["integer","null"],"description":"Upper bound on merged hits fed to the summary and returned to the caller. Defaults to 10, clamped to 50."},"path_prefix":{"type":["string","null"],"description":"Restrict search to this path prefix."},"type_ref":{"type":["string","null"],"description":"Restrict document search to this type reference. Ignored for action search."},"inquiry_prompt":{"type":["string","null"],"description":"Override the default system prompt used to turn the inquiry into search terms."},"summary_prompt":{"type":["string","null"],"description":"Override the default system prompt used to summarize the search results."},"llm_action_ref":{"type":["string","null"],"description":"Action reference for the chat action this pipeline drives. Defaults to /packages/solx-ollama/ollama-chat; any action taking {model, messages, format?} and returning {message: {content}} can be substituted."},"base_url":{"type":["string","null"],"description":"Passed through to every llm call."},"api_key":{"type":["string","null"],"description":"Passed through to every llm call."},"auth_secret_name":{"type":["string","null"],"description":"Passed through to every llm call."},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"},"description":"Passed through to every llm call."},"options":{"type":["object","null"],"description":"Merged into every llm call own options object, a key at a time - this pipeline always sets temperature to 0 by default, and a key given here overrides that default for that key only, leaving every other key (from either side) untouched. The main use is num_ctx: this is the only way to raise a model context window from this action, and a large recall_limit/history_limit/max_results can otherwise build a prompt bigger than the model default window without either side telling you."},"timeout_secs":{"type":["integer","null"],"description":"Per-llm-call HTTP timeout, forwarded to each of the two chat calls. Clamped to 900."}}}}';

save type /packages/solx-inquiry/InquireResult --json '{"description":"Result of the inquire action. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"inquiry":{"type":"string"},"model":{"type":"string"},"scope":{"type":"string"},"terms":{"type":"array","items":{"type":"string"},"description":"The search terms the model generated from the inquiry."},"hits":{"type":"array","items":{"type":"object","properties":{"source":{"type":"string","enum":["document","action"]},"path":{"type":"string"},"name":{"type":"string"},"title":{"type":["string","null"]},"summary":{"type":["string","null"]},"score":{"type":"number","description":"Relevance, as the sum of this hit reciprocal rank under every search term that found it (Reciprocal Rank Fusion): first place under one term contributes 1.0, second 0.5, third 0.33. Unbounded above rather than capped at 1.0 - a hit ranked first by three terms scores about 1.83 - so it is a comparison within one result set, not a confidence."},"matched_terms":{"type":"array","items":{"type":"string"}},"details":{"type":["object","null"],"description":"For a document hit, its full contents, returned inline by search_documents. For an action hit, its category/capabilities/phrases/paramTypeRef/resultTypeRef (already returned by search_actions; capabilities is where solx:destructive shows up) plus, for each type ref present, the JSON Schema for that type under paramSchema/resultSchema (fetched separately and independently, only for the final capped hit list) - enough to construct a genuinely correct call and parse its result, not just name where each shape lives. resultTypeRef is documentation only; the host never validates an actual result against it. Null when there was nothing beyond title/summary to add."}}},"description":"Merged, deduplicated, score-sorted hits across every search term and scope."},"summary":{"type":"string","description":"The model final answer to the inquiry, grounded in hits."}}}}';

save action /packages/solx-inquiry/inquire --json '{"actionType":"wasm","binName":"solx-inquiry.wasm","fnName":"inquire","caption":"Inquiry","category":"llm","description":"Ask a question: a chat model turns it into search terms, those terms search documents and/or actions, and the model summarizes the results against the original question. Requires a chat action to be installed (defaults to solx-ollama/ollama-chat). Under solx-server/solx-mcp, each of the two chat calls runs detached so its progress is echoed live into the console and it can be cooperatively cancelled; falls back to a plain blocking call under a bare solx exec.","capabilities":["llm","search","summarize","rag"],"phrases":["ask a question about my documents","research this and summarize","search and summarize","investigate this topic","what do i know about"],"paramTypeRef":"/packages/solx-inquiry/InquireParams","resultTypeRef":"/packages/solx-inquiry/InquireResult","actionConfig":{"timeout_secs":4200}}';

# ── instruct ─────────────────────────────────────────────────────────────────

save type /packages/solx-inquiry/InstructParams --json '{"description":"Parameters for the instruct action: turn a natural-language instruction into responses, memories and runnable scripts, recording the exchange in a session document.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["instruction","model","session"],"properties":{"instruction":{"type":"string","description":"What the user wants, in natural language."},"model":{"type":"string","description":"Chat model name, passed to the llm action for the intent call and every inquiry."},"session":{"type":"string","description":"Full /path/name reference of the session document holding this conversation. Created on first use. Read for history before the intent call, and rewritten with this turn appended at the end."},"max_inquiries":{"type":["integer","null"],"description":"Upper bound on how many inquiries the intent phase may propose. Defaults to 3 and is clamped to 3, which is what the action timeout is sized for."},"max_terms":{"type":["integer","null"],"description":"Upper bound on search terms per inquiry. Defaults to 5, clamped to 10."},"max_results":{"type":["integer","null"],"description":"Upper bound on merged hits per inquiry. Defaults to 10, clamped to 50."},"document_path_prefix":{"type":["string","null"],"description":"Restrict document inquiries to this path prefix. Independent of action_path_prefix, since one instruct call can fan out inquiries of both kinds."},"action_path_prefix":{"type":["string","null"],"description":"Restrict action inquiries to this path prefix. Independent of document_path_prefix."},"type_ref":{"type":["string","null"],"description":"Restrict document inquiries to this type reference. Not applied to action inquiries."},"skills_path":{"type":["string","null"],"description":"Where seeded skills are read from. Defaults to /solx-inquiry/skills."},"memory_path":{"type":["string","null"],"description":"Where memories are recalled from, and the path stamped on the memory payloads returned for saving. Omit it and memories are off entirely: nothing is recalled and no payload is minted. There is no default on purpose, because this is you telling instruct where its own past output lives, and that is what keeps a previous run answers from being read back as though a person had written them. Save the returned memories where you said they would go."},"recall_limit":{"type":["integer","null"],"description":"How many memories to recall. Defaults to 5, clamped to 20."},"history_limit":{"type":["integer","null"],"description":"How many prior session turns to summarize into the intent prompt. Defaults to 6, clamped to 20."},"intent_prompt":{"type":["string","null"],"description":"Replace the default system prompt for the intent phase."},"document_prompt":{"type":["string","null"],"description":"Replace the default system prompt for document inquiries."},"action_prompt":{"type":["string","null"],"description":"Replace the default system prompt for action inquiries. The script primer is still appended."},"llm_action_ref":{"type":["string","null"],"description":"Action reference for the chat action this pipeline drives. Defaults to /packages/solx-ollama/ollama-chat."},"base_url":{"type":["string","null"],"description":"Passed through to every llm call."},"api_key":{"type":["string","null"],"description":"Passed through to every llm call."},"auth_secret_name":{"type":["string","null"],"description":"Passed through to every llm call."},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"},"description":"Passed through to every llm call."},"options":{"type":["object","null"],"description":"Merged into every llm call own options object, a key at a time - this pipeline always sets temperature to 0 by default, and a key given here overrides that default for that key only, leaving every other key (from either side) untouched. The main use is num_ctx: this is the only way to raise a model context window from this action, and a large recall_limit/history_limit/max_results can otherwise build a prompt bigger than the model default window without either side telling you."},"timeout_secs":{"type":["integer","null"],"description":"Per-llm-call HTTP timeout, forwarded to every chat call. Clamped to 900."}}}}';

save type /packages/solx-inquiry/InstructResult --json '{"description":"Result of the instruct action. Documentation only - result schemas are not validated. The caller is expected to save the memories and run the scripts; instruct writes nothing but its own session document.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"instruction":{"type":"string"},"model":{"type":"string"},"session":{"type":"string"},"intent":{"type":"object","description":"What the intent phase decided: mode (direct or inquire), the direct response if any, and the inquiries it proposed."},"responses":{"type":"array","items":{"type":"object","properties":{"text":{"type":"string"},"title":{"type":["string","null"]},"memory":{"type":"boolean","description":"The model judged this durable enough to be worth saving. A matching payload is in memories when this response came from an inquiry and a memory_path was given; otherwise notes says why not."},"tags":{"type":"array","items":{"type":"string"}},"citations":{"type":"array","items":{"type":"string"},"description":"Paths of the search results this response was grounded in."},"inquiry":{"type":["integer","null"],"description":"Which inquiry produced it. Null for a direct answer from the intent phase, which can be returned alongside inquiry findings rather than instead of them. A null here means the response is ungrounded model output and is why it is never minted as a memory."}}}},"memories":{"type":"array","items":{"type":"object"},"description":"Ready-to-save document payloads, one per response that an inquiry produced and the model flagged as a memory. A direct answer from the intent phase is never minted, however it was flagged: that phase searches nothing, so its answer cites nothing and nothing checked it, and a note says so. Empty when no memory_path was given, in which case a note says how many responses were flagged. Pass one straight to /builtin/document/entity_save_document. Each carries path (the memory_path you supplied), typeRef and author, so a saved memory records that a model produced it. The name is derived from the text, so re-deriving the same memory upserts itself rather than duplicating."},"scripts":{"type":"array","items":{"type":"object","properties":{"title":{"type":["string","null"]},"notes":{"type":"array","items":{"type":"string"},"description":"Why steps were dropped - an action that was not in the search results, or a $capture reference no earlier step defines - whether the script calls anything destructive, which capture references were left quoted because the called action declares no parameter schema, plus anything the model wanted to say about it."},"actions":{"type":"array","items":{"type":"string"}},"destructive":{"type":"array","items":{"type":"string"},"description":"Actions among the steps that solx would stop for a human decision: those carrying solx:destructive, and those of actionType command or webhook. Non-empty means read this script before running it. Not exhaustive - a configured tool_destructive list is not visible from inside a wasm action, so an action listed only there will not appear here."},"steps":{"type":"array","items":{"type":"object"}},"source":{"type":"string","description":"The rendered .solx text. Generated from the steps by solx-inquiry, not written by the model."}}}},"hits":{"type":"array","items":{"type":"object"},"description":"The evidence, tagged with the inquiry that found it."},"notes":{"type":"array","items":{"type":"string"}},"errors":{"type":"array","items":{"type":"object"},"description":"Per-inquiry failures. A failed inquiry does not fail the run unless every one of them failed."},"warnings":{"type":"array","items":{"type":"string"},"description":"Things that went wrong without affecting the answer, such as a session document that could not be written."}}}}';

# `turns` is deliberately undeclared. The full-text index walks only a type
# declared fields, so leaving it out keeps a whole growing transcript out of
# FTS while still storing and returning it - which is what makes rewriting
# this document on every instruction affordable. title and summary *are*
# indexed, which is what lets a session be found by what it was about.
save type /packages/solx-inquiry/InstructSession --json '{"description":"The stored history of one instruct conversation: every turn, with the instruction, the intent decision, the responses, the scripts and the memories it produced. Written once at the end of each instruct call. Deliberately permissive - the shape evolves with the package, and a session that failed validation mid-run would strand the record of work that already happened.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"turnCount":{"type":"integer","description":"How many turns are retained. Capped at 50; older turns are dropped from the front."},"lastInstruction":{"type":"string","description":"The most recent instruction, indexed so a session can be found by what was last asked of it."}}}}';

save type /packages/solx-inquiry/InquiryMemory --json '{"description":"One durable thing an instruct run learned, flagged by the model as worth keeping and saved by the caller. The document author records which action produced it, so a memory is identifiable as model output rather than something a person wrote. The text is capped at 1000 characters and stored in the document summary as well as here, which is what lets recall be a single search with no follow-up reads. Treat the text as model output, not as fact.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["text"],"properties":{"text":{"type":"string","description":"The note itself."},"tags":{"type":"array","items":{"type":"string"},"description":"Optional keywords, indexed for search."},"instruction":{"type":"string","description":"The instruction that produced it."},"session":{"type":"string","description":"The session document it came from."}}}}';

save type /packages/solx-inquiry/InquirySkill --json '{"description":"Operator guidance for one kind of inquiry. Injected as reference material into the prompts of the inquiries it applies to, which means a skill never grants reach or decides an answer - it only explains ground the model is already standing on. Write one with: solx save doc /solx-inquiry/skills/NAME --type /packages/solx-inquiry/InquirySkill","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["instructions"],"properties":{"instructions":{"type":"string","description":"What the model should know. Capped at 4000 characters, and 8000 across all skills in one inquiry, so keep it short - a small local model drowns long before it runs out of context."},"scope":{"type":"string","enum":["documents","actions","both"],"description":"Which inquiry kind this rides along with. An absent or unrecognized value means both, so a typo makes a skill apply too often rather than silently never."},"tools":{"type":"array","items":{"type":"string"},"description":"Action reference globs, for example /builtin/document/* - * matches any characters including /. Narrows an actions-scoped skill to inquiries whose search surfaced a matching action. Empty means any action inquiry."}}}}';

save action /packages/solx-inquiry/instruct --json '{"actionType":"wasm","binName":"solx-inquiry.wasm","fnName":"instruct","caption":"Instruct","category":"llm","description":"Turn a natural-language instruction into responses, memories and runnable .solx scripts. An intent call decides whether the instruction can be answered directly or needs looking up; up to three inquiries then run in parallel as detached invocations, searching documents (which answer in prose) or actions (which answer in script steps that solx-inquiry renders to .solx). Skills and memories are recalled as reference material, and the exchange is recorded in a session document. Saves nothing else: the caller decides which memories to save and which scripts to run.","capabilities":["llm","instruct","plan","scripts","rag"],"phrases":["do this for me","work out how to do this","turn this into a script","what should i do about","plan this out"],"paramTypeRef":"/packages/solx-inquiry/InstructParams","resultTypeRef":"/packages/solx-inquiry/InstructResult","actionConfig":{"timeout_secs":8400}}';

# ── Seeded skills ────────────────────────────────────────────────────────────
#
# Two traps govern these, both learned the hard way in solx-agent:
#
# 1. --json is parsed as a DocumentInput, so the skill fields must sit under
#    `contents`. serde ignores unknown fields, so a top-level `instructions`
#    saves an empty document and the skill silently never loads.
# 2. Keep each one short. SKILL_TOTAL_CAP is 8000 characters across every
#    skill in one inquiry, so a long skill crowds out the others.

save doc /solx-inquiry/skills/solx-scripts --type /packages/solx-inquiry/InquirySkill --json '{"title":"What a .solx script is","contents":{"scope":"actions","instructions":"You write steps, not syntax: solx-inquiry renders your steps into .solx text, so quoting and statement separators are not your problem. What is worth knowing is what the result can and cannot do.\nA script is a sequence of statements separated by semicolons, run in order. A captured value is read back as $name, or $name.field for one field of it.\nA script registered as an action supports only exec and json stages - not the fuller command line grammar - and has no return statement. The value of the last statement is the result, so the step that answers the question goes last.\nSubstitution is textual, not structural: a captured string is inserted as raw unquoted text, while numbers and objects insert as valid JSON. That is why a captured value is best used as a whole parameter value rather than spliced into the middle of one."}}';

save doc /solx-inquiry/skills/script-steps --type /packages/solx-inquiry/InquirySkill --json '{"title":"Writing script steps","contents":{"scope":"actions","instructions":"Every step names one action and supplies its parameters.\nUse the exact action reference as it appears in the search results. A step naming an action that was not in the results is dropped before the script reaches anyone, and the reason is reported instead - so inventing a plausible action produces nothing, not a shortcut.\nRead the parameter schema included with each action rather than guessing from its name. The host validates parameters on every call, so a wrong shape fails at run time.\nGive a step a capture name only when a later step actually reads it. An unused capture is noise.\nPrefer the shortest sequence that answers the question. Two correct steps beat six speculative ones."}}';

save doc /solx-inquiry/skills/optional-params --type /packages/solx-inquiry/InquirySkill --json '{"title":"Omit optional parameters, never null them","contents":{"scope":"both","instructions":"Never send null for an optional parameter. An optional string is typed as a string, so an explicit null fails validation and errors the whole call. Omit the key instead."}}';

save doc /solx-inquiry/skills/documents --type /packages/solx-inquiry/InquirySkill --json '{"title":"Reading document results","contents":{"scope":"documents","instructions":"A document is identified by its path and its name together, and the full reference is the two joined - for example /research/ai/note. Cite results that way, because that is what the reader needs in order to go and look.\nA result carries its full contents, so what you see is the document, not a preview of it. If the contents do not say something, it is not established - say so rather than filling the gap.\nResults are ordered best match first, but a high rank means the words matched, not that the document is right. Read before relying.\nSearch terms are ANDed and prefix-matched, so a result set can be narrow for reasons that have nothing to do with what exists. Absence of results is weak evidence of absence."}}';

save doc /solx-inquiry/skills/action-catalogue --type /packages/solx-inquiry/InquirySkill --json '{"title":"Reading the action catalogue","contents":{"scope":"actions","instructions":"The action registry is the catalogue of everything this system can do, so a search over it tells you what is genuinely available rather than what would be reasonable to exist.\nA row says more than its description. actionType says how it runs. paramTypeRef names the schema its parameters are validated against on every call, and that schema is included with the result. resultTypeRef is documentation only and is never validated, so a declared result shape is an intention, not a guarantee.\ncapabilities may carry solx:destructive, which means running it stops for a human decision. Say plainly when a script you propose includes one.\nAn action you cannot see in the results may still exist but be hidden. Do not assume the catalogue you were shown is the whole system."}}';

save doc /solx-inquiry/skills/memories --type /packages/solx-inquiry/InquirySkill --json '{"title":"What is worth remembering","contents":{"scope":"both","instructions":"Flagging a response as a memory means it gets stored and shown to later, unrelated runs. That is a high bar and most responses do not clear it.\nA memory should be durable, self-contained and true outside this conversation: how something is configured, where something lives, a decision that was made and why. Someone reading it months later with no other context should be able to use it.\nDo not flag a restatement of the question, a summary of what you just did, a fact that is already obvious from the documents, or anything true only of this run.\nWrite it as a standalone statement rather than a reply. Not: that is in the auth notes. Instead: authentication issues a signed session token at login, documented in /notes/auth."}}';
