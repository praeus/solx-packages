# solx-google login script
#
# Drives the OAuth 2.0 authorization-code flow end-to-end through the
# dispatcher. Runs as a Script-type action whose bin_name points at this
# file (uploaded during install via file_put).
#
# Steps (parallels the old sol-google-login-script.json):
#   1. Read previously-persisted client_id, client_secret, scope (if any).
#   2. Bind the OAuth loopback listener on 127.0.0.1:{port} (default 8765).
#   3. Open the Google consent URL in the system browser via /builtin/web/open_url.
#   4. Await the OAuth callback (up to {timeout_secs} seconds).
#   5. If the user authorized, exchange the code for tokens via the
#      internal /packages/solx-google/_private/oauth-token-exchange action
#      (not meant to be invoked standalone — it needs an already-obtained
#      code + redirect_uri from step 4).
#   6. Persist client_id, client_secret, scope, and refresh_token via
#      /builtin/secrets/set_secret, encrypted with the key configured in this
#      action's action_config.secrets map.
#   7. Always release the loopback port.

# The runner seeds $params from the caller's payload (see ActionCommandRunner).
$existing_client_id = exec /builtin/secrets/get_secret --json '{"name":"GOOGLE_OAUTH_CLIENT_ID"}';
$existing_client_secret = exec /builtin/secrets/get_secret --json '{"name":"GOOGLE_OAUTH_CLIENT_SECRET"}';
$existing_scope = exec /builtin/secrets/get_secret --json '{"name":"GOOGLE_OAUTH_SCOPE"}';

# Prefer caller's params over the persisted secrets — lets the user re-enter
# credentials on a fresh install or rotate them. client_secret/scope don't
# need a null-guard (only client_id does, below), so a plain per-var
# if/else picking whichever source is non-null is enough for them.
if $params.client_secret == null;
    $client_secret = json '"$existing_client_secret.result.value"';
else;
    $client_secret = json '"$params.client_secret"';
endif;
if $params.scope == null;
    $scope = json '"$existing_scope.result.value"';
else;
    $scope = json '"$params.scope"';
endif;

# Guard: if the caller did not provide credentials on first run (and none are
# persisted from a previous run), fail loud rather than handing Google an
# empty client_id. The condition below evaluates the real typed values (not
# their string form), so it works whether either field is absent or null.
if $params.client_id == null && $existing_client_id.result.value == null;
    exec /builtin/web/open_url --json '{"url":"about:blank"}';
    $result = json '{"succeeded":false,"error":"missing_client_id","error_description":"supply client_id, client_secret, and scope in params on first run"}';
else;
    if $params.client_id == null;
        $client_id = json '"$existing_client_id.result.value"';
    else;
        $client_id = json '"$params.client_id"';
    endif;

    # 0 is treated the same as absent: neither a loopback port nor an await
    # timeout can meaningfully be 0, and callers whose UI form defaults a
    # blank optional integer field to 0 (rather than omitting it) would
    # otherwise cause an instant oauth_await timeout.
    if $params.port == null || $params.port == 0;
        $port = json '8765';
    else;
        $port = json '$params.port';
    endif;
    if $params.timeout_secs == null || $params.timeout_secs == 0;
        $timeout = json '300';
    else;
        $timeout = json '$params.timeout_secs';
    endif;

    $loopback = exec /builtin/oauth/oauth_start --json '{"port":'$port'}';

    # Build the Google authorization URL. $client_id, $scope,
    # $loopback.result.redirect_uri, and $loopback.result.state_value are
    # all strings at this point. (Every `exec` result is wrapped as
    # {"action","result","success"} -- the actual action output lives under
    # .result.)
    $auth_url = json '"https://accounts.google.com/o/oauth2/v2/auth?response_type=code&access_type=offline&prompt=consent&include_granted_scopes=true&client_id=$client_id&redirect_uri=$loopback.result.redirect_uri&scope=$scope&state=$loopback.result.state_value"';

    exec /builtin/web/open_url --json '{"url":"'$auth_url'"}';

    $callback = exec /builtin/oauth/oauth_await --json '{"state_value":"'$loopback.result.state_value'","timeout_secs":'$timeout'}';

    # Always release the loopback port, whether or not the callback succeeded.
    exec /builtin/oauth/oauth_stop --json '{"state_value":"'$loopback.result.state_value'"}';

    if $callback.result.succeeded == true;
        # The token-exchange action below resolves client_id/client_secret
        # itself, through its OWN configured secret store (action_config.secrets
        # + auth.client_id_secret/client_secret_secret) -- it does NOT read
        # them from these exec params (only `code` is used from params). So
        # they must already be persisted under GOOGLE_OAUTH_CLIENT_ID /
        # GOOGLE_OAUTH_CLIENT_SECRET / GOOGLE_OAUTH_SCOPE *before* this call,
        # not after, or a first-time login (nothing persisted yet) fails with
        # "secret 'GOOGLE_OAUTH_CLIENT_ID' is not set".
        exec /builtin/secrets/set_secret --json '{"name":"GOOGLE_OAUTH_CLIENT_ID","value":"'$client_id'"}';
        exec /builtin/secrets/set_secret --json '{"name":"GOOGLE_OAUTH_CLIENT_SECRET","value":"'$client_secret'"}';
        exec /builtin/secrets/set_secret --json '{"name":"GOOGLE_OAUTH_SCOPE","value":"'$scope'"}';

        # Exchange the auth code for tokens.
        $token = exec /packages/solx-google/_private/oauth-token-exchange --json '{"code":"'$callback.result.code'","redirect_uri":"'$loopback.result.redirect_uri'","client_id":"'$client_id'","client_secret":"'$client_secret'","scope":"'$scope'"}';

        exec /builtin/secrets/set_secret --json '{"name":"GOOGLE_OAUTH_REFRESH_TOKEN","value":"'$token.result.refresh_token'"}';

        $result = json '{"succeeded":true,"access_token":"'$token.result.access_token'","refresh_token":"'$token.result.refresh_token'","expires_in":'$token.result.expires_in',"scope":"'$token.result.scope'","token_type":"'$token.result.token_type'"}';
    else;
        $result = json '{"succeeded":false,"error":"'$callback.result.error'","error_description":"'$callback.result.error_description'"}';
    endif;
endif;
