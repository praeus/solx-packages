save type /packages/solx-mcp-actions/McpImportParams --json '{"name":"McpImportParams","description":"Input for solx-mcp-actions-import. Connects to a server configured in mcp-servers.json and imports its tools as solx Command actions.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"server":{"type":"string","description":"Server key in mcp-servers.json"},"dry_run":{"type":["boolean","null"],"description":"When true, list discovered tools without creating any solx entities."},"permission_name":{"type":["string","null"],"description":"Optional Permission name to stamp onto every generated action, scoping which callers may invoke the imported MCP tools."},"include":{"type":["array","null"],"items":{"type":"string"},"description":"Only import tools whose raw MCP name matches one of these patterns (one '*' wildcard allowed per pattern). Entirely replaces, does not merge with, the server's tool_filter.include in mcp-servers.json."},"exclude":{"type":["array","null"],"items":{"type":"string"},"description":"Never import tools whose raw MCP name matches one of these patterns, applied after include. Entirely replaces, does not merge with, the server's tool_filter.exclude in mcp-servers.json. Tools previously imported that no longer pass the filter are removed (reported as tools_pruned)."}},"required":["server"]}}';
save type /packages/solx-mcp-actions/McpImportResult --json '{"name":"McpImportResult","description":"Result of solx-mcp-actions-import.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"server":{"type":"string"},"tools_imported":{"type":"array"},"tools_pruned":{"type":"array","description":"Actions from a prior import of this server that no longer pass the current filter, and were deleted."},"errors":{"type":"array"}}}}';
save type /packages/solx-mcp-actions/McpRemoveParams --json '{"name":"McpRemoveParams","description":"Input for solx-mcp-actions-remove. Deletes the actions and types a prior import created for the given server.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"server":{"type":"string","description":"Server key previously passed to solx-mcp-actions-import."}},"required":["server"]}}';
save type /packages/solx-mcp-actions/McpRemoveResult --json '{"name":"McpRemoveResult","description":"Result of solx-mcp-actions-remove.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"server":{"type":"string"},"tools_removed":{"type":"array"},"errors":{"type":"array"}}}}';

save action /packages/solx-mcp-actions/solx-mcp-actions-import --json '{"action_type":"command","fn_name":"solx-mcp-actions-import","caption":"Import MCP server tools","category":"mcp","description":"Connect to a configured MCP server over stdio and import its tools as solx Command actions. Parameters are passed on stdin as JSON.","capabilities":["mcp","integration","import"],"phrases":["import mcp server","register mcp tools","connect mcp server"],"param_type_ref":"/packages/solx-mcp-actions/McpImportParams","result_type_ref":"/packages/solx-mcp-actions/McpImportResult","action_config":{"cwd":"D:/Projects/solx-packages/solx-mcp-actions/bin"}}';
save action /packages/solx-mcp-actions/solx-mcp-actions-remove --json '{"action_type":"command","fn_name":"solx-mcp-actions-remove","caption":"Remove MCP server tools","category":"mcp","description":"Remove a previously imported MCP server\u0027s actions and types. Parameters are passed on stdin as JSON.","capabilities":["mcp","integration","cleanup"],"phrases":["remove mcp server","uninstall mcp tools"],"param_type_ref":"/packages/solx-mcp-actions/McpRemoveParams","result_type_ref":"/packages/solx-mcp-actions/McpRemoveResult","action_config":{"cwd":"D:/Projects/solx-packages/solx-mcp-actions/bin"}}'