# actionConfig.timeout_secs below (4200s) covers two sequential llm phases,
# each potentially run detached (via /builtin/action/start+poll) up to the
# *child* action's own configured outer ceiling rather than solx-inquiry's
# `timeout_secs` param (which only bounds the inner per-request timeout of
# each phase) - solx-ollama's ollama-chat currently ships with a 1860s outer
# ceiling of its own, so 2x that plus headroom for search and polling.

save file files/actions/shared/solx-inquiry.wasm --file bin/solx-inquiry.wasm;

save type /packages/solx-inquiry/InquireParams --json '''{"description":"Parameters for the inquire action: ask a question, let a chat model turn it into search terms, search documents and/or actions, then summarize the results against the question.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["inquiry","model"],"properties":{"inquiry":{"type":"string","description":"The question or topic to investigate."},"model":{"type":"string","description":"Chat model name passed to the llm action for both the search-term and summary calls."},"scope":{"type":["string","null"],"enum":["documents","actions","both",null],"description":"What to search: documents, actions, or both. Defaults to documents."},"max_terms":{"type":["integer","null"],"description":"Upper bound on how many search terms the model may produce. Defaults to 5, clamped to 10."},"max_results":{"type":["integer","null"],"description":"Upper bound on merged hits fed to the summary and returned to the caller. Defaults to 10, clamped to 50."},"path_prefix":{"type":["string","null"],"description":"Restrict search to this path prefix."},"type_ref":{"type":["string","null"],"description":"Restrict document search to this type reference. Ignored for action search."},"inquiry_prompt":{"type":["string","null"],"description":"Override the default system prompt used to turn the inquiry into search terms."},"summary_prompt":{"type":["string","null"],"description":"Override the default system prompt used to summarize the search results."},"llm_action_ref":{"type":["string","null"],"description":"Action reference for the chat action this pipeline drives. Defaults to /packages/solx-ollama/ollama-chat; any action taking {model, messages, format?} and returning {message: {content}} can be substituted."},"base_url":{"type":["string","null"],"description":"Passed through to every llm call."},"api_key":{"type":["string","null"],"description":"Passed through to every llm call."},"auth_secret_name":{"type":["string","null"],"description":"Passed through to every llm call."},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"},"description":"Passed through to every llm call."},"options":{"type":["object","null"],"description":"Merged into every llm call own options object, a key at a time - this pipeline always sets temperature to 0 by default, and a key given here overrides that default for that key only, leaving every other key (from either side) untouched. The main use is num_ctx: this is the only way to raise a model context window from this action, and a large recall_limit/history_limit/max_results can otherwise build a prompt bigger than the model default window without either side telling you."},"timeout_secs":{"type":["integer","null"],"description":"Per-llm-call HTTP timeout, forwarded to each of the two chat calls. Clamped to 900."}}}}''';

save type /packages/solx-inquiry/InquireResult --json '''{"description":"Result of the inquire action. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"inquiry":{"type":"string"},"model":{"type":"string"},"scope":{"type":"string"},"terms":{"type":"array","items":{"type":"string"},"description":"The search terms the model generated from the inquiry."},"hits":{"type":"array","items":{"type":"object","properties":{"source":{"type":"string","enum":["document","action"]},"path":{"type":"string"},"name":{"type":"string"},"title":{"type":["string","null"]},"summary":{"type":["string","null"]},"score":{"type":"number","description":"Relevance, as the sum of this hit reciprocal rank under every search term that found it (Reciprocal Rank Fusion): first place under one term contributes 1.0, second 0.5, third 0.33. Unbounded above rather than capped at 1.0 - a hit ranked first by three terms scores about 1.83 - so it is a comparison within one result set, not a confidence."},"matched_terms":{"type":"array","items":{"type":"string"}},"details":{"type":["object","null"],"description":"For a document hit, its full contents, returned inline by search-documents. For an action hit, its category/capabilities/phrases/paramTypeRef/resultTypeRef (already returned by search-actions; capabilities is where solx:destructive shows up) plus, for each type ref present, the JSON Schema for that type under paramSchema/resultSchema (fetched separately and independently, only for the final capped hit list) - enough to construct a genuinely correct call and parse its result, not just name where each shape lives. resultTypeRef is documentation only; the host never validates an actual result against it. Null when there was nothing beyond title/summary to add."}}},"description":"Merged, deduplicated, score-sorted hits across every search term and scope."},"summary":{"type":"string","description":"The model final answer to the inquiry, grounded in hits."}}}}''';

save action /packages/solx-inquiry/inquire --json '''{"actionType":"wasm","binName":"solx-inquiry.wasm","fnName":"inquire","caption":"Inquiry","category":"llm","description":"Ask a question: a chat model turns it into search terms, those terms search documents and/or actions, and the model summarizes the results against the original question. Requires a chat action to be installed (defaults to solx-ollama/ollama-chat). Under solx-server/solx-mcp, each of the two chat calls runs detached so its progress is echoed live into the console and it can be cooperatively cancelled; falls back to a plain blocking call under a bare solx exec.","capabilities":["llm","search","summarize","rag"],"phrases":["ask a question about my documents","research this and summarize","search and summarize","investigate this topic","what do i know about"],"paramTypeRef":"/packages/solx-inquiry/InquireParams","resultTypeRef":"/packages/solx-inquiry/InquireResult","actionConfig":{"timeout_secs":4200}}''';

# ── multi_inquire ────────────────────────────────────────────────────────────

save type /packages/solx-inquiry/MultiInquireParams --json '''{"description":"Parameters for the multi_inquire action: turn a natural-language instruction into responses, memories and runnable scripts, reading a session document for history.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["instruction","model","session"],"properties":{"instruction":{"type":"string","description":"What the user wants, in natural language."},"model":{"type":"string","description":"Chat model name, passed to the llm action for the intent call and every inquiry."},"session":{"type":"string","description":"Full /path/name reference of the session document holding this conversation. Read for history before the intent call; the updated document is returned as session_document for the caller to create/update - multi_inquire never writes it itself."},"max_inquiries":{"type":["integer","null"],"description":"Upper bound on how many inquiries the intent phase may propose. Defaults to 3 and is clamped to 3, which is what the action timeout is sized for."},"max_terms":{"type":["integer","null"],"description":"Upper bound on search terms per inquiry. Defaults to 5, clamped to 10."},"max_results":{"type":["integer","null"],"description":"Upper bound on merged hits per inquiry. Defaults to 10, clamped to 50."},"document_path_prefix":{"type":["string","null"],"description":"Restrict document inquiries to this path prefix. Independent of action_path_prefix, since one multi_inquire call can fan out inquiries of both kinds."},"action_path_prefix":{"type":["string","null"],"description":"Restrict action inquiries to this path prefix. Independent of document_path_prefix."},"type_ref":{"type":["string","null"],"description":"Restrict document inquiries to this type reference. Not applied to action inquiries."},"skills_path":{"type":["string","null"],"description":"Where seeded skills are read from. Defaults to /solx-inquiry/skills."},"memory_path":{"type":["string","null"],"description":"Where memories are recalled from, and the path stamped on the memory payloads returned for saving. Omit it and memories are off entirely: nothing is recalled and no payload is minted. There is no default on purpose, because this is you telling multi_inquire where its own past output lives, and that is what keeps a previous run answers from being read back as though a person had written them. Save the returned memories where you said they would go."},"context_documents":{"type":["array","null"],"items":{"type":"string"},"description":"Full /path/name references of documents to read into every prompt this run makes - the intent call and every inquiry, regardless of kind. Unlike a skill or a memory, these ride along unconditionally: naming a document here is you saying it applies. Up to 10; each is one entity-get-document call made once up front. A reference that is not a valid /path/name shape, or that fails to load, is dropped and reported in notes rather than failing the call."},"recall_limit":{"type":["integer","null"],"description":"How many memories to recall. Defaults to 5, clamped to 20."},"history_limit":{"type":["integer","null"],"description":"How many prior session turns to summarize into the intent prompt. Defaults to 6, clamped to 20."},"intent_prompt":{"type":["string","null"],"description":"Replace the default system prompt for the intent phase."},"document_prompt":{"type":["string","null"],"description":"Replace the default system prompt for document inquiries."},"action_prompt":{"type":["string","null"],"description":"Replace the default system prompt for action inquiries. The script primer is still appended."},"llm_action_ref":{"type":["string","null"],"description":"Action reference for the chat action this pipeline drives. Defaults to /packages/solx-ollama/ollama-chat."},"base_url":{"type":["string","null"],"description":"Passed through to every llm call."},"api_key":{"type":["string","null"],"description":"Passed through to every llm call."},"auth_secret_name":{"type":["string","null"],"description":"Passed through to every llm call."},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"},"description":"Passed through to every llm call."},"options":{"type":["object","null"],"description":"Merged into every llm call own options object, a key at a time - this pipeline always sets temperature to 0 by default, and a key given here overrides that default for that key only, leaving every other key (from either side) untouched. The main use is num_ctx: this is the only way to raise a model context window from this action, and a large recall_limit/history_limit/max_results can otherwise build a prompt bigger than the model default window without either side telling you."},"timeout_secs":{"type":["integer","null"],"description":"Per-llm-call HTTP timeout, forwarded to every chat call. Clamped to 900."}}}}''';

save type /packages/solx-inquiry/MultiInquireResult --json '''{"description":"Result of the multi_inquire action. Documentation only - result schemas are not validated. multi_inquire writes nothing at all; the caller persists session_document and any memories, and executes any scripts.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"instruction":{"type":"string"},"model":{"type":"string"},"session":{"type":"string"},"intent":{"type":"object","description":"What the intent phase decided: mode (direct or inquire), the direct response if any, and the inquiries it proposed."},"responses":{"type":"array","items":{"type":"object","properties":{"text":{"type":"string"},"title":{"type":["string","null"]},"memory":{"type":"boolean","description":"The model judged this durable enough to be worth saving. A matching payload is in memories when this response came from an inquiry and a memory_path was given; otherwise notes says why not."},"tags":{"type":"array","items":{"type":"string"}},"citations":{"type":"array","items":{"type":"string"},"description":"Paths of the search results this response was grounded in."},"inquiry":{"type":["integer","null"],"description":"Which inquiry produced it. Null for a direct answer from the intent phase, which can be returned alongside inquiry findings rather than instead of them. A null here means the response is ungrounded model output and is why it is never minted as a memory."}}}},"memories":{"type":"array","items":{"type":"object"},"description":"Ready-to-save document payloads, one per response that an inquiry produced and the model flagged as a memory. A direct answer from the intent phase is never minted, however it was flagged: that phase searches nothing, so its answer cites nothing and nothing checked it, and a note says so. Empty when no memory_path was given, in which case a note says how many responses were flagged. Pass one straight to /builtin/document/entity-save-document. Each carries path (the memory_path you supplied), typeRef and author, so a saved memory records that a model produced it. The name is derived from the text, so re-deriving the same memory upserts itself rather than duplicating."},"scripts":{"type":"array","items":{"type":"object","properties":{"title":{"type":["string","null"]},"notes":{"type":"array","items":{"type":"string"},"description":"Why steps were dropped - an action that was not in the search results, or a $capture reference no earlier step defines - whether the script calls anything destructive, plus anything the model wanted to say about it."},"actions":{"type":"array","items":{"type":"string"}},"destructive":{"type":"array","items":{"type":"string"},"description":"Actions among the steps that solx would stop for a human decision: those carrying solx:destructive, and those of actionType command or webhook. Non-empty means inspect this plan before running it. Not exhaustive - a configured tool_destructive list is not visible from inside a wasm action, so an action listed only there will not appear here."},"steps":{"type":"array","items":{"type":"object","properties":{"action_ref":{"type":"string"},"params":{"type":"object","description":"The parameters to call action_ref with. A string value of the form $name or $name.field is a reference to an earlier step capture in this same plan and must be substituted with that step real result before calling the action - it is not a literal value."},"capture":{"type":["string","null"],"description":"When set, the name later steps in this plan reference this step result by, as $name or $name.field."}}},"description":"Validated action calls, in order, for the caller to execute directly. Never .solx text - this pipeline does not generate or run any script syntax."}}}},"session_document":{"type":"object","description":"The updated session document payload - this turn appended to the prior ones read from session, oldest dropped past 50. Not written by this action; pass it straight to /builtin/document/entity-save-document to make this turn part of history for the next call. Carries path, name, typeRef (MultiInquireSession), author, title, summary and contents (turns/turnCount/lastInstruction), exactly the shape entity-save-document expects."},"hits":{"type":"array","items":{"type":"object"},"description":"The evidence, tagged with the inquiry that found it."},"notes":{"type":"array","items":{"type":"string"}},"errors":{"type":"array","items":{"type":"object"},"description":"Per-inquiry failures. A failed inquiry does not fail the run unless every one of them failed."}}}}''';

# `turns` is deliberately undeclared. The full-text index walks only a type
# declared fields, so leaving it out keeps a whole growing transcript out of
# FTS while still storing and returning it - which is what makes saving this
# document on every instruction affordable. title and summary *are* indexed,
# which is what lets a session be found by what it was about.
save type /packages/solx-inquiry/MultiInquireSession --json '''{"description":"The history of one multi_inquire conversation: every turn, with the instruction, the intent decision, the responses, the scripts and the memories it produced. Composed at the end of each multi_inquire call and returned as session_document for the caller to save - multi_inquire never writes it itself. Deliberately permissive - the shape evolves with the package, and a session that failed validation mid-run would strand the record of work that already happened.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"turnCount":{"type":"integer","description":"How many turns are retained. Capped at 50; older turns are dropped from the front."},"lastInstruction":{"type":"string","description":"The most recent instruction, indexed so a session can be found by what was last asked of it."}}}}''';

save type /packages/solx-inquiry/InquiryMemory --json '''{"description":"One durable thing an instruct run learned, flagged by the model as worth keeping and saved by the caller. The document author records which action produced it, so a memory is identifiable as model output rather than something a person wrote. The text is capped at 1000 characters and stored in the document summary as well as here, which is what lets recall be a single search with no follow-up reads. Treat the text as model output, not as fact.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["text"],"properties":{"text":{"type":"string","description":"The note itself."},"tags":{"type":"array","items":{"type":"string"},"description":"Optional keywords, indexed for search."},"instruction":{"type":"string","description":"The instruction that produced it."},"session":{"type":"string","description":"The session document it came from."}}}}''';

save type /packages/solx-inquiry/InquirySkill --json '''{"description":"Operator guidance for one kind of inquiry. Injected as reference material into the prompts of the inquiries it applies to, which means a skill never grants reach or decides an answer - it only explains ground the model is already standing on. Write one with: solx save doc /solx-inquiry/skills/NAME --type /packages/solx-inquiry/InquirySkill","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["instructions"],"properties":{"instructions":{"type":"string","description":"What the model should know. Capped at 4000 characters, and 8000 across all skills in one inquiry, so keep it short - a small local model drowns long before it runs out of context."},"scope":{"type":"string","enum":["documents","actions","both"],"description":"Which inquiry kind this rides along with. An absent or unrecognized value means both, so a typo makes a skill apply too often rather than silently never."},"tools":{"type":"array","items":{"type":"string"},"description":"Action reference globs, for example /builtin/document/* - * matches any characters including /. Narrows an actions-scoped skill to inquiries whose search surfaced a matching action. Empty means any action inquiry."}}}}''';

save action /packages/solx-inquiry/multi-inquire --json '''{"actionType":"wasm","binName":"solx-inquiry.wasm","fnName":"multi_inquire","caption":"Multi-inquire","category":"llm","description":"Turn a natural-language instruction into responses, memories and runnable action plans. An intent call decides whether the instruction can be answered directly or needs looking up; up to three inquiries then run in parallel as detached invocations, searching documents (which answer in prose) or actions (which answer in an ordered list of validated action calls, as JSON, for the caller to execute directly). Skills and memories are recalled as reference material, and the exchange is assembled into a session document payload. Saves nothing: the caller decides which memories to save, whether to persist the session document, and which plans to execute.","capabilities":["llm","instruct","plan","scripts","rag"],"phrases":["do this for me","work out how to do this","turn this into a plan","what should i do about","plan this out"],"paramTypeRef":"/packages/solx-inquiry/MultiInquireParams","resultTypeRef":"/packages/solx-inquiry/MultiInquireResult","actionConfig":{"timeout_secs":8400}}''';

# ── Seeded skills ────────────────────────────────────────────────────────────
#
# Two traps govern these, both learned the hard way in solx-agent:
#
# 1. --json is parsed as a DocumentInput, so the skill fields must sit under
#    `contents`. serde ignores unknown fields, so a top-level `instructions`
#    saves an empty document and the skill silently never loads.
# 2. Keep each one short. SKILL_TOTAL_CAP is 8000 characters across every
#    skill in one inquiry, so a long skill crowds out the others.

save doc /solx-inquiry/skills/script-steps --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Writing script steps","contents":{"scope":"actions","instructions":"Every step names one action and supplies its parameters. Steps run in order, and the caller executes them directly - there is no .solx or other script text involved.\nUse the exact action reference as it appears in the search results. A step naming an action that was not in the results is dropped before the plan reaches anyone, and the reason is reported instead - so inventing a plausible action produces nothing, not a shortcut.\nRead the parameter schema included with each action rather than guessing from its name. The host validates parameters on every call, so a wrong shape fails at run time.\nGive a step a capture name only when a later step actually reads it, as $name or $name.field for one field of it. An unused capture is noise.\nPrefer the shortest sequence that answers the question. Two correct steps beat six speculative ones."}}''';

save doc /solx-inquiry/skills/optional-params --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Omit optional parameters, never null them","contents":{"scope":"both","instructions":"Never send null for an optional parameter. An optional string is typed as a string, so an explicit null fails validation and errors the whole call. Omit the key instead."}}''';

save doc /solx-inquiry/skills/documents --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Reading document results","contents":{"scope":"documents","instructions":"A document is identified by its path and its name together, and the full reference is the two joined - for example /research/ai/note. Cite results that way, because that is what the reader needs in order to go and look.\nA result carries its full contents, so what you see is the document, not a preview of it. If the contents do not say something, it is not established - say so rather than filling the gap.\nResults are ordered best match first, but a high rank means the words matched, not that the document is right. Read before relying.\nSearch terms are ANDed and prefix-matched, so a result set can be narrow for reasons that have nothing to do with what exists. Absence of results is weak evidence of absence."}}''';

save doc /solx-inquiry/skills/action-catalogue --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Reading the action catalogue","contents":{"scope":"actions","instructions":"The action registry is the catalogue of everything this system can do, so a search over it tells you what is genuinely available rather than what would be reasonable to exist.\nA row says more than its description. actionType says how it runs. paramTypeRef names the schema its parameters are validated against on every call, and that schema is included with the result. resultTypeRef is documentation only and is never validated, so a declared result shape is an intention, not a guarantee.\ncapabilities may carry solx:destructive, which means running it stops for a human decision. Say plainly when a script you propose includes one.\nAn action you cannot see in the results may still exist but be hidden. Do not assume the catalogue you were shown is the whole system."}}''';

save doc /solx-inquiry/skills/memories --type /packages/solx-inquiry/InquirySkill --json '''{"title":"What is worth remembering","contents":{"scope":"both","instructions":"Flagging a response as a memory means it gets stored and shown to later, unrelated runs. That is a high bar and most responses do not clear it.\nA memory should be durable, self-contained and true outside this conversation: how something is configured, where something lives, a decision that was made and why. Someone reading it months later with no other context should be able to use it.\nDo not flag a restatement of the question, a summary of what you just did, a fact that is already obvious from the documents, or anything true only of this run.\nWrite it as a standalone statement rather than a reply. Not: that is in the auth notes. Instead: authentication issues a signed session token at login, documented in /notes/auth."}}''';

save doc /solx-inquiry/skills/solx-system --type /packages/solx-inquiry/InquirySkill --json '''{"title":"What solx is","contents":{"scope":"both","instructions":"solx is a system for persisting, searching and acting on documents through a single action catalogue. Every operation is an action call.\nDocuments live under a path/name pair (e.g. /research/ai/note), have a title and summary indexed for search, and carry their full contents. typeRef names a JSON Schema type the contents are validated against on save. Types themselves live under /types/* and the parameter and result schemas backing built-in actions live under /builtin/types.\nActions live under /packages/* and /builtin/*. Each row says how it runs (actionType: wasm, command, webhook, script), what parameters it takes (paramTypeRef), and what it returns (resultTypeRef). actionType command and webhook plus any capability carrying solx:destructive stop for a human decision before running.\nThe action catalogue is the tool catalogue. Anything this system can do is a row here, and reading paramTypeRef gives the exact parameter shape instead of guessing. Outputs are JSON; a non-2xx is not an error from http-request, it is just status 4xx/5xx with a body - check status before trusting body.\nFiles are a flat byte store addressed by rel_path; /files/actions/shared/ for action artifacts and /widgets/ for widget bundles. Two frontends exist: solx-web (browser at http://localhost:5173) and a CLI/MCP. Both hit the same solx-server on :8766. There is also a Rust native client for local use without a server.\nOutbound HTTP is deny-by-default: every URL must match a host prefix the install granted. Adding a host is something a human does. The instance in front of you grants http://localhost:11434 (Ollama) and a few LJ/Google/Reddit hosts already.\nWhat multi_inquire does itself: one intent call decides whether to answer directly or fan out up to three inquiries in parallel (documents answer in prose, actions answer as a validated JSON script). Skills are recalled per inquiry and capped at 8000 characters across all skills. Memories are recalled only when memory_path was supplied."}}''';

save doc /solx-inquiry/skills/wire-keys --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Parameter names and null","contents":{"scope":"both","instructions":"Parameter spelling is not uniform across solx and the schemas are open, so a key you misspell is dropped in silence rather than refused. You get a wrong answer, not an error.\nEntity and search parameters are camelCase: typeRef, pathPrefix, paramTypeRef, resultTypeRef, excludeHidden, linkedTo.\nSome handlers read raw keys and take snake_case instead: rel_path, doc_path, state_value, stream_id, action_ref, invocation_id, timeout_secs, from_seq, wait_secs.\nWhen you are unsure which a tool wants, read its parameter schema rather than guessing.\nNever send null for an optional parameter. An optional string is typed as a string, so an explicit null fails validation and errors the whole call. Omit the key instead."}}''';

save doc /solx-inquiry/skills/javascript-actions --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Building a JavaScript action","contents":{"scope":"actions","instructions":"A JavaScript action is compiled into a wasm component by solx-quickjs. The source must export a named runner object, because the build binds the interface to that identifier and a bare top-level run function does not bind. The shape is:\nexport const runner = { run(actionName, params) { return { success: true, message: null, output: JSON.stringify(result) }; } };\nparams arrives as a JSON string and output must be a JSON string, so parse and stringify at the boundary. To call another action, import exec from sol:actions/action-exec@0.1.0; it takes a reference string and a JSON-stringified payload and returns { success, message, output }.\nStage the source with file-put first (rel_path under files/actions/shared/, base64-encoded if not text), then build. /packages/solx-quickjs/build-javascript-file compiles and uploads the artifact without touching any action row. /packages/solx-quickjs/build-javascript-action does the same and also upserts the action named by path and action_name.\nBoth stop for a human decision, and what you build runs with more reach than you have. Say what it will do, in plain terms, before you ask."}}''';

save doc /solx-inquiry/skills/packages --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Building an installable package","contents":{"scope":"actions","instructions":"A package is a directory holding solx-package.json and an install.solx script, installed from the command line with `solx install-package`. You cannot install one from inside solx, so produce the files and hand them over.\nsolx-package.json needs name and version. It also declares what the package needs permission for, and installing grants exactly that: allowed_base_urls for outbound hosts, and command_actions mapping an opaque key to a command and a working directory. Both are deny-by-default, so an undeclared host or command simply will not run.\ninstall.solx registers everything with ordinary CLI verbs, one statement per line, each ending in a semicolon: save type, save file, save action, save doc. Write an uninstall.solx that removes what install added.\nWrap a --json argument in three consecutive single-quote characters on each side, not just one: the content is then taken completely raw, so a description containing an apostrophe or a quote needs no escaping and cannot silently truncate the argument.\nFor a script-typed action, install also reads from solx-package.json - the bin_name comes from the script_action mapping there."}}''';

save doc /solx-inquiry/skills/files --type /packages/solx-inquiry/InquirySkill --json '''{"title":"The file store","contents":{"scope":"both","instructions":"The file store is a flat byte store addressed by rel_path, which is snake_case here rather than the camelCase used by entity parameters.\nfile-put takes rel_path, content, and encoding of either utf8 or base64. Use base64 for anything that is not text, and note that content is the bytes themselves, not the name of a local file.\nfile-get and file-delete take rel_path. file-list takes prefix. file-copy and dir-copy take source and dest. dir-delete takes rel_path and returns the list of what it removed.\nTwo conventions worth following: action artifacts, meaning wasm components and .solx scripts, live under files/actions/shared/, and widget bundles under widgets/.\nThere is no directory entity. A directory is only a shared prefix, which is why dir-delete is a prefix sweep and is worth being careful with."}}''';

save doc /solx-inquiry/skills/web --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Making HTTP requests","contents":{"scope":"both","instructions":"Outbound requests are deny-by-default. Every URL has to match a prefix the instance has already allowed, so a refusal usually means the host was never granted rather than that you called it wrongly, and adding a host is something a human does.\nhttp-request takes url, method defaulting to GET, headers, body, body_encoding of utf8 or base64, and timeout_secs defaulting to 30.\nA non-2xx response is not an error. You get back status, lowercased headers and body, and a 404 or a 500 arrives looking exactly like a success, so check status before trusting body.\nTo read a response as it arrives, start returns a stream_id once the headers land, poll drains the chunks buffered since a cursor and can wait for more, and close ends it. Always close a stream you started.\nOnly http and https are ever accepted, whatever the allowlist says."}}''';

save doc /solx-inquiry/skills/solx-scripts --type /packages/solx-inquiry/InquirySkill --json '''{"title":"Writing a .solx script","contents":{"scope":"actions","instructions":"A .solx script is a pipeline language, not a general one, and enough of it is unusual that intuition will get it wrong.\nStatements are separated by semicolons and newlines are only cosmetic, so every statement needs its own semicolon, including if, elseif, else, endif, for and endfor.\nComments run from a hash to the end of the line and are stripped before the split.\nA vertical bar pipes one stage into the next. A value is captured with a name and an equals sign and read back with a dollar sign, including dotted paths into a result.\nSubstitution is textual. A variable holding a string is inserted as raw unquoted text, while numbers and objects insert as valid JSON, and a missing field inserts the four characters null. There is no interpolation operator, so build a template inside a single json stage.\nWrap a JSON body in three consecutive single-quote characters on each side rather than one: that content is taken completely raw, so an apostrophe or a quote inside it needs no escaping.\nAn action of type script supports only exec and json stages, not the full command line grammar, and has no return: the value of the last statement is the result."}}''';
