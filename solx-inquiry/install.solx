# actionConfig.timeout_secs below (4200s) covers two sequential llm phases,
# each potentially run detached (via /builtin/action/start+poll) up to the
# *child* action's own configured outer ceiling rather than solx-inquiry's
# `timeout_secs` param (which only bounds the inner per-request timeout of
# each phase) - solx-ollama's ollama-chat currently ships with a 1860s outer
# ceiling of its own, so 2x that plus headroom for search and polling.
save file files/actions/shared/solx-inquiry.wasm --file bin/solx-inquiry.wasm;

save type /packages/solx-inquiry/InquireParams --json '{"description":"Parameters for the inquire action: ask a question, let a chat model turn it into search terms, search documents and/or actions, then summarize the results against the question.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["inquiry","model"],"properties":{"inquiry":{"type":"string","description":"The question or topic to investigate."},"model":{"type":"string","description":"Chat model name passed to the llm action for both the search-term and summary calls."},"scope":{"type":["string","null"],"enum":["documents","actions","both",null],"description":"What to search: documents, actions, or both. Defaults to documents."},"max_terms":{"type":["integer","null"],"description":"Upper bound on how many search terms the model may produce. Defaults to 5, clamped to 10."},"max_results":{"type":["integer","null"],"description":"Upper bound on merged hits fed to the summary and returned to the caller. Defaults to 10, clamped to 50."},"path_prefix":{"type":["string","null"],"description":"Restrict search to this path prefix."},"type_ref":{"type":["string","null"],"description":"Restrict document search to this type reference. Ignored for action search."},"inquiry_prompt":{"type":["string","null"],"description":"Override the default system prompt used to turn the inquiry into search terms."},"summary_prompt":{"type":["string","null"],"description":"Override the default system prompt used to summarize the search results."},"llm_action_ref":{"type":["string","null"],"description":"Action reference for the chat action this pipeline drives. Defaults to /packages/solx-ollama/ollama-chat; any action taking {model, messages, format?} and returning {message: {content}} can be substituted."},"base_url":{"type":["string","null"],"description":"Passed through to every llm call."},"api_key":{"type":["string","null"],"description":"Passed through to every llm call."},"auth_secret_name":{"type":["string","null"],"description":"Passed through to every llm call."},"headers":{"type":["object","null"],"additionalProperties":{"type":"string"},"description":"Passed through to every llm call."},"timeout_secs":{"type":["integer","null"],"description":"Per-llm-call HTTP timeout, forwarded to each of the two chat calls. Clamped to 900."}}}}';

save type /packages/solx-inquiry/InquireResult --json '{"description":"Result of the inquire action. Documentation only - result schemas are not validated.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"inquiry":{"type":"string"},"model":{"type":"string"},"scope":{"type":"string"},"terms":{"type":"array","items":{"type":"string"},"description":"The search terms the model generated from the inquiry."},"hits":{"type":"array","items":{"type":"object","properties":{"source":{"type":"string","enum":["document","action"]},"path":{"type":"string"},"name":{"type":"string"},"title":{"type":["string","null"]},"summary":{"type":["string","null"]},"score":{"type":"number"},"matched_terms":{"type":"array","items":{"type":"string"}},"details":{"type":["object","null"],"description":"For a document hit, its full contents (fetched for the final, capped hit list). For an action hit, its category/phrases/paramTypeRef/resultTypeRef (already returned by search_actions) plus, for each type ref present, the JSON Schema for that type under paramSchema/resultSchema (fetched separately, independently) - enough to construct a genuinely correct call and parse its result, not just name where each shape lives. resultTypeRef is documentation only; the host never validates an actual result against it. Null when there was nothing beyond title/summary to add."}}},"description":"Merged, deduplicated, score-sorted hits across every search term and scope."},"summary":{"type":"string","description":"The model final answer to the inquiry, grounded in hits."}}}}';

save action /packages/solx-inquiry/inquire --json '{"actionType":"wasm","binName":"solx-inquiry.wasm","fnName":"inquire","caption":"Inquiry","category":"llm","description":"Ask a question: a chat model turns it into search terms, those terms search documents and/or actions, and the model summarizes the results against the original question. Requires a chat action to be installed (defaults to solx-ollama/ollama-chat). Under solx-server/solx-mcp, each of the two chat calls runs detached so its progress is echoed live into the console and it can be cooperatively cancelled; falls back to a plain blocking call under a bare solx exec.","capabilities":["llm","search","summarize","rag"],"phrases":["ask a question about my documents","research this and summarize","search and summarize","investigate this topic","what do i know about"],"paramTypeRef":"/packages/solx-inquiry/InquireParams","resultTypeRef":"/packages/solx-inquiry/InquireResult","actionConfig":{"timeout_secs":4200}}'
