save type /packages/solx-git/GitCloneParams --json '{"description":"Params for git-clone: clone a repository into path, or fetch+sync an existing checkout already there.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["url","path"],"properties":{"url":{"type":"string","description":"Remote URL - https://... or an SSH form (git@host:org/repo.git, ssh://...)."},"path":{"type":"string","description":"Where the repo is cloned into (or, if it already holds a checkout, synced in place). A relative path resolves inside the solx files directory; an absolute path must be listed in solx-git.json's allowed_paths (see the package README)."},"branch":{"type":["string","null"],"description":"Branch to check out. Ignored if rev is set."},"rev":{"type":["string","null"],"description":"A specific commit or tag to check out (detached HEAD unless it is a branch tip). Takes priority over branch."},"depth":{"type":["integer","null"],"description":"Shallow-clone/fetch depth. Omit for full history."}}}}';
save type /packages/solx-git/GitCloneResult --json '{"description":"Result of git-clone.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"path":{"type":"string","description":"The resolved absolute path the repo was cloned/synced into."},"url":{"type":"string"},"branch":{"type":["string","null"]},"commit":{"type":"string"},"cloned":{"type":"boolean","description":"true for a fresh clone, false when path already held a repo that was fetched and re-synced instead."}}}}';
save action /packages/solx-git/git-clone --json '{"actionType":"command","fnName":"git-clone","caption":"Git clone","category":"git","description":"Clone a repository into path, or fetch and hard-checkout an existing repo already there to the requested branch/rev. Local modifications at path are discarded (force checkout) - this reproduces a source tree, it does not preserve edits. Credentials: SSH via GIT_SSH_KEY_PATH (+GIT_SSH_KEY_PASSPHRASE) or ssh-agent; HTTPS via GIT_USERNAME+GIT_PASSWORD or GIT_TOKEN.","capabilities":["git","clone","checkout","source-control","command"],"phrases":["clone a git repository","checkout a repository","git clone","pull down a repo"],"paramTypeRef":"/packages/solx-git/GitCloneParams","resultTypeRef":"/packages/solx-git/GitCloneResult","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-git/target/release","timeout_secs":600}}';
save type /packages/solx-git/GitPatchParams --json '{"description":"Params for git-patch: produce a unified diff of a repos current changes.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["path"],"properties":{"path":{"type":"string","description":"A path inside a git working directory. A relative path resolves inside the solx files directory; an absolute path must be listed in solx-git.json's allowed_paths."},"staged_only":{"type":["boolean","null"],"description":"Restrict the diff to staged changes (index vs HEAD) instead of all current changes (workdir vs HEAD). Default false."},"include_untracked":{"type":["boolean","null"],"description":"Include untracked files as additions. Ignored when staged_only is set. Default true."},"context_lines":{"type":["integer","null"],"description":"Lines of context around each hunk. Default 3."}}}}';
save type /packages/solx-git/GitPatchResult --json '{"description":"Result of git-patch.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"path":{"type":"string"},"patch":{"type":"string","description":"Unified diff text, ready to write to a .patch file or feed to git apply."},"files_changed":{"type":"integer"},"insertions":{"type":"integer"},"deletions":{"type":"integer"}}}}';
save action /packages/solx-git/git-patch --json '{"actionType":"command","fnName":"git-patch","caption":"Git patch","category":"git","description":"Produce a unified diff patch of a repos current changes: working tree vs HEAD (staged+unstaged+untracked) by default, or index vs HEAD with staged_only.","capabilities":["git","diff","patch","source-control","command"],"phrases":["get a git patch","diff current changes","git diff","produce a patch of the changes"],"paramTypeRef":"/packages/solx-git/GitPatchParams","resultTypeRef":"/packages/solx-git/GitPatchResult","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-git/target/release","timeout_secs":120}}';
save type /packages/solx-git/GitBranchParams --json '{"description":"Params for git-branch: create a branch and/or switch the repos current branch.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["path","branch"],"properties":{"path":{"type":"string","description":"A path inside a git working directory. A relative path resolves inside the solx files directory; an absolute path must be listed in solx-git.json's allowed_paths."},"branch":{"type":"string","description":"Branch name to switch to (and, per create, to make first)."},"create":{"type":["boolean","null"],"description":"Create branch at start_point if it does not exist yet. Default true. If false and the branch is missing, this is an error instead of an implicit create."},"start_point":{"type":["string","null"],"description":"Revspec (branch, tag, sha, HEAD, ...) the branch is created at. Only consulted when the branch is actually being created or moved. Default HEAD."},"force":{"type":["boolean","null"],"description":"If branch already exists, move it to start_point instead of leaving it where it is. Default false."}}}}';
save type /packages/solx-git/GitBranchResult --json '{"description":"Result of git-branch.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"path":{"type":"string"},"branch":{"type":"string"},"commit":{"type":"string"},"created":{"type":"boolean","description":"true if this call created the branch, false if it already existed."}}}}';
save action /packages/solx-git/git-branch --json '{"actionType":"command","fnName":"git-branch","caption":"Git branch","category":"git","description":"Create a branch and/or switch the repos current branch. create defaults to true (make it if missing); force additionally moves an already-existing branch to start_point. Always hard-checks out the resulting branch (CheckoutBuilder::force), discarding local modifications the same as git-clone.","capabilities":["git","branch","checkout","source-control","command"],"phrases":["create a git branch","switch git branch","checkout a new branch","make a branch"],"paramTypeRef":"/packages/solx-git/GitBranchParams","resultTypeRef":"/packages/solx-git/GitBranchResult","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-git/target/release","timeout_secs":60}}';
save type /packages/solx-git/GitCommitParams --json '{"description":"Params for git-commit: stage and commit a repos current changes.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["path","message"],"properties":{"path":{"type":"string","description":"A path inside a git working directory. A relative path resolves inside the solx files directory; an absolute path must be listed in solx-git.json's allowed_paths."},"message":{"type":"string","description":"Commit message."},"all":{"type":["boolean","null"],"description":"Stage all changes (new/modified/deleted, tracked and untracked) before committing - git add -A. Default true. false commits only what is already staged."},"author_name":{"type":["string","null"],"description":"Overrides the commit author/committer name. Requires author_email too; otherwise falls back to the repos configured user.name/user.email."},"author_email":{"type":["string","null"],"description":"Overrides the commit author/committer email. Requires author_name too."}}}}';
save type /packages/solx-git/GitCommitResult --json '{"description":"Result of git-commit.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"path":{"type":"string"},"commit":{"type":"string"},"branch":{"type":["string","null"],"description":"null on a detached HEAD."}}}}';
save action /packages/solx-git/git-commit --json '{"actionType":"command","fnName":"git-commit","caption":"Git commit","category":"git","description":"Stage (git add -A by default) and commit a repos current changes. Uses the repos configured user.name/user.email unless author_name+author_email are both given.","capabilities":["git","commit","source-control","command"],"phrases":["commit changes","git commit","make a commit","save changes to git"],"paramTypeRef":"/packages/solx-git/GitCommitParams","resultTypeRef":"/packages/solx-git/GitCommitResult","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-git/target/release","timeout_secs":120}}'
