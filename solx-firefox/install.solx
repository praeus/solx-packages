
exec /builtin/file_put --json '{"rel_path": "files/actions/shared/solx-firefox-mcp-setup.solx", "content": "$start = exec /packages/solx-firefox/firefox-start --json \u0027{}\u0027;$import = exec /packages/solx-mcp-actions/solx-mcp-actions-import --json \u0027{\"server\":\"firefox\"}\u0027;json \u0027{\"firefox\":$start,\"import\":$import}\u0027"}';
exec /builtin/file_put --json '{"rel_path": "files/actions/shared/solx-firefox-mcp-teardown.solx", "content": "$remove = exec /packages/solx-mcp-actions/solx-mcp-actions-remove --json \u0027{\"server\":\"firefox\"}\u0027;$stop = exec /packages/solx-firefox/firefox-stop --json \u0027{}\u0027;json \u0027{\"remove\":$remove,\"stop\":$stop}\u0027"}';


post action /packages/solx-firefox/firefox-start --json '{"action_type":"command","fn_name":".\\solx-firefox.exe start","caption":"Start managed Firefox","category":"firefox","description":"Launch (or reuse) a dedicated-profile Firefox instance with Marionette enabled, for MCP-based browser automation via solx-mcp. Parameters are passed on stdin as JSON.","capabilities":["firefox","browser","mcp"],"phrases":["start firefox","launch firefox devtools","start managed firefox"],"action_config":{"cwd":"D:/Projects/solx-packages/solx-firefox/bin"}}';
post action /packages/solx-firefox/firefox-stop --json '{"action_type":"command","fn_name":".\\solx-firefox.exe stop","caption":"Stop managed Firefox","category":"firefox","description":"Stop the dedicated-profile Firefox instance previously started by firefox-start. Parameters are passed on stdin as JSON.","capabilities":["firefox","browser","mcp"],"phrases":["stop firefox","close firefox devtools","stop managed firefox"],"action_config":{"cwd":"D:/Projects/solx-packages/solx-firefox/bin"}}';


post action /packages/solx-firefox/firefox-mcp-setup --json '{"action_type":"script","bin_name":"solx-firefox-mcp-setup.solx","caption":"Set up Firefox MCP tools","category":"firefox","description":"Start the managed Firefox instance and import its DevTools MCP tools as solx actions in one step.","capabilities":["firefox","browser","mcp","orchestration"],"phrases":["set up firefox mcp","import firefox devtools tools","start and import firefox mcp"]}';
post action /packages/solx-firefox/firefox-mcp-teardown --json '{"action_type":"script","bin_name":"solx-firefox-mcp-teardown.solx","caption":"Tear down Firefox MCP tools","category":"firefox","description":"Remove the imported Firefox DevTools MCP actions and stop the managed Firefox instance.","capabilities":["firefox","browser","mcp","orchestration"],"phrases":["tear down firefox mcp","remove firefox devtools tools","stop and remove firefox mcp"]}'
