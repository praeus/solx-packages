save type /packages/solx-google/GoogleTaskCreateParams --json '{"description":"Input for create-google-task.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["tasklist","title"],"properties":{"tasklist":{"type":"string"},"title":{"type":"string"},"notes":{"type":"string"},"due":{"type":"string"},"status":{"type":"string","enum":["needsAction","completed"]}},"additionalProperties":true}}';
save type /packages/solx-google/GoogleTask --json '{"description":"Google Tasks API Task resource JSON.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":true,"properties":{"id":{"type":"string"},"title":{"type":"string"},"notes":{"type":"string"},"status":{"type":"string"},"due":{"type":"string"},"selfLink":{"type":"string"}}}}';
save type /packages/solx-google/SolDocToGoogleTaskParams --json '{"description":"Input for convert-sol-doc-to-google-task.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"sol_document":{"type":"object","additionalProperties":true},"sol_document_name":{"type":"string"},"default_title":{"type":"string"},"text_field_hint":{"type":"string"},"due":{"type":"string"},"status":{"type":"string","enum":["needsAction","completed"]}}}}';
save type /packages/solx-google/SolDocToGoogleTaskResult --json '{"description":"Result for convert-sol-doc-to-google-task.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"title":{"type":"string"},"notes":{"type":"string"},"due":{"type":["string","null"]},"status":{"type":"string"},"create_body":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';
save type /packages/solx-google/GoogleTaskToSolDocParams --json '{"description":"Input for convert-google-task-to-sol-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["google_task"],"properties":{"google_task":{"type":"object","additionalProperties":true},"output_document_name":{"type":"string"},"output_type_name":{"type":"string"}}}}';
save type /packages/solx-google/GoogleTaskToSolDocResult --json '{"description":"Result for convert-google-task-to-sol-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"task_id":{"type":["string","null"]},"title":{"type":"string"},"notes":{"type":"string"},"due":{"type":["string","null"]},"status":{"type":["string","null"]},"suggested_document_name":{"type":"string"},"sol_document_payload":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';
