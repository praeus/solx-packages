save type /packages/solx-media/MediaDocument --json '{"description":"Result of a solx-media extraction. Persisted to solx-server via entity_save_document by the solx-media actions. Discriminator `kind` picks the extraction mode (image-text, audio-transcript, video-transcript, materialized-html).","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["kind","document_name","contents"],"properties":{"kind":{"type":"string","title":"Kind","enum":["image-text","audio-transcript","video-transcript","materialized-html"],"description":"Discriminator for which extraction mode produced this document."},"document_name":{"type":"string","title":"Document Name","description":"Suggested document name (used as the basename under the persisted path)."},"title":{"type":["string","null"],"title":"Title","description":"Display title; null when not provided."},"summary":{"type":["string","null"],"title":"Summary","description":"Short summary; null when not provided."},"author":{"type":["string","null"],"title":"Author","description":"Attributed author; null when not provided."},"contents":{"type":"object","title":"Contents","description":"Free-form JSON contents of the document. Specific shape depends on `kind`."},"artifacts":{"type":"array","items":{"$ref":"#/$defs/EmbeddedArtifact"},"title":"Artifacts","description":"Embedded artifacts (e.g. images materialized from HTML)."},"transcript":{"type":"string","title":"Transcript","description":"For audio/video: full transcript text concatenated."},"segments":{"type":"array","items":{"$ref":"#/$defs/TimecodedSegment"},"title":"Segments","description":"For audio/video: timecoded transcript segments from whisper."},"scene_captions":{"type":"array","items":{"$ref":"#/$defs/TimecodedSegment"},"title":"Scene Captions","description":"For video: per-frame vision captions (text only, no speaker)."},"description":{"type":"string","title":"Description","description":"Synthesized description (audio/video) or extracted description (image)."},"notes":{"type":"array","items":{"type":"string"},"title":"Notes","description":"Free-form notes (e.g. transcription availability warnings)."}},"$defs":{"EmbeddedArtifact":{"type":"object","required":["name","content_type","data"],"properties":{"name":{"type":"string","title":"Name"},"content_type":{"type":"string","title":"Content Type"},"data":{"type":"string","title":"Data","description":"Base64-encoded artifact bytes."}}},"TimecodedSegment":{"type":"object","required":["start_ms","end_ms","text"],"properties":{"start_ms":{"type":"integer","minimum":0},"end_ms":{"type":"integer","minimum":0},"speaker":{"type":["string","null"]},"text":{"type":"string"}}}}}}';
save type /packages/solx-media/MediaInstallParams --json '{"description":"Params for solx-media install-whisper-model.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"name":{"type":["string","null"],"description":"Whisper model name (e.g. tiny.en). Default: tiny.en"},"force":{"type":"boolean","description":"Re-download even if file exists. Default: false"}}}}';
save action /packages/solx-media/solx-media-image --json '{"actionType":"command","fnName":"solx-media-image","caption":"Extract image to document","category":"media","description":"Vision-LLM pass: load image, ask Ollama multimedia model, persist as MediaDocument (kind=image-text) at /media/image-text/<name>.","capabilities":["media","image","vision","extraction","command"],"phrases":["describe image","extract image","image to document","vision extract"],"resultTypeRef":"/packages/solx-media/MediaDocument","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":600,"env":{"SOLX_SERVER_URL":"http://127.0.0.1:8766"}}}';
save action /packages/solx-media/solx-media-audio --json '{"actionType":"command","fnName":"solx-media-audio","caption":"Extract audio to document","category":"media","description":"Whisper-transcribe audio via ffmpeg, summarize via Ollama, persist as MediaDocument (kind=audio-transcript) at /media/audio-transcript/<name>.","capabilities":["media","audio","whisper","transcription","extraction","command"],"phrases":["transcribe audio","extract audio","audio to document","audio to text"],"resultTypeRef":"/packages/solx-media/MediaDocument","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":600,"env":{"SOLX_SERVER_URL":"http://127.0.0.1:8766"}}}';
save action /packages/solx-media/solx-media-video --json '{"actionType":"command","fnName":"solx-media-video","caption":"Extract video to document","category":"media","description":"Whisper-transcribe audio track + per-frame vision captions, summarize via Ollama, persist as MediaDocument (kind=video-transcript) at /media/video-transcript/<name>.","capabilities":["media","video","whisper","transcription","vision","extraction","command"],"phrases":["transcribe video","extract video","video to document","video to text"],"resultTypeRef":"/packages/solx-media/MediaDocument","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":1200,"env":{"SOLX_SERVER_URL":"http://127.0.0.1:8766"}}}';
save action /packages/solx-media/materialize-html --json '{"actionType":"command","fnName":"solx-media-materialize-html","caption":"Materialize HTML embedded media","category":"media","description":"Walk an HTML rich_text payload, fetch every embedded image (data:/http(s)/path-relative) and rewrite srcs to artifacts/<name>. Persists as MediaDocument (kind=materialized-html) at /media/materialized-html/<name>.","capabilities":["media","html","materialize","extraction","command"],"phrases":["materialize html","embed images","materialize rich text"],"resultTypeRef":"/packages/solx-media/MediaDocument","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":600,"env":{"SOLX_SERVER_URL":"http://127.0.0.1:8766"}}}';
save action /packages/solx-media/install-whisper-model --json '{"actionType":"command","fnName":"solx-media-install-whisper-model","caption":"Install whisper model","category":"media","description":"Download a whisper.cpp ggml model from huggingface (default tiny.en), SHA-256 verify, persist active model name to {SOLX_PACKAGES_DIR}/solx-media/config.json. Pass {name} to pick a specific model.","capabilities":["media","whisper","install","setup","command"],"phrases":["install whisper model","download whisper model","setup whisper"],"paramTypeRef":"/packages/solx-media/MediaInstallParams","actionConfig":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":300,"env":{"SOLX_SERVER_URL":"http://127.0.0.1:8766"}}}'
