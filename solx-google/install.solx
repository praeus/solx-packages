save type /packages/solx-google/GmailMessage --json '{"description":"Gmail API Message resource JSON.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":true,"properties":{"id":{"type":"string"},"threadId":{"type":"string"},"labelIds":{"type":"array","items":{"type":"string"}},"snippet":{"type":"string"},"payload":{"type":"object","additionalProperties":true}}}}';
