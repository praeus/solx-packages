save type /packages/solx-google/SolDocToGmailParams --json '{"description":"Input for convert-sol-doc-to-gmail-message.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["to"],"properties":{"to":{"type":"string"},"cc":{"type":"string"},"bcc":{"type":"string"},"subject":{"type":"string"},"sol_document":{"type":"object","additionalProperties":true},"sol_document_name":{"type":"string"},"text_field_hint":{"type":"string"},"rich_text_field_hint":{"type":"string"}}}}';
save type /packages/solx-google/SolDocToGmailResult --json '{"description":"Result for convert-sol-doc-to-gmail-message.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"to":{"type":"string"},"cc":{"type":["string","null"]},"bcc":{"type":["string","null"]},"subject":{"type":"string"},"text":{"type":"string"},"raw":{"type":"string"},"send_body":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';
save type /packages/solx-google/GmailMessageToSolDocParams --json '{"description":"Input for convert-gmail-message-to-sol-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["gmail_message"],"properties":{"gmail_message":{"type":"object","additionalProperties":true},"output_document_name":{"type":"string"},"output_type_name":{"type":"string"}}}}';
save type /packages/solx-google/GmailMessageToSolDocResult --json '{"description":"Result for convert-gmail-message-to-sol-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"message_id":{"type":["string","null"]},"thread_id":{"type":["string","null"]},"subject":{"type":"string"},"from":{"type":["string","null"]},"to":{"type":["string","null"]},"date":{"type":["string","null"]},"text":{"type":"string"},"suggested_document_name":{"type":"string"},"sol_document_payload":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';
save type /packages/solx-google/GoogleTasklistsListParams --json '{"description":"Input for list-google-tasklists.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"maxResults":{"type":"integer","minimum":1,"maximum":100},"pageToken":{"type":"string"}},"additionalProperties":true}}';
save type /packages/solx-google/GoogleTaskListParams --json '{"description":"Input for list-google-tasks.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["tasklist"],"properties":{"tasklist":{"type":"string"},"showCompleted":{"type":"boolean"},"showHidden":{"type":"boolean"},"dueMin":{"type":"string"},"dueMax":{"type":"string"},"maxResults":{"type":"integer","minimum":1,"maximum":100},"pageToken":{"type":"string"}},"additionalProperties":true}}';
