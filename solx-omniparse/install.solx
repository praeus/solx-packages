save type /packages/solx-omniparse/OmniparseInput --json '{"description":"Input payload for solx-omniparse preprocessing.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"artifact_name":{"type":["string","null"]},"source_path":{"type":["string","null"],"description":"Local source file path when available."},"file_name":{"type":["string","null"]},"mime_type":{"type":["string","null"]}}}}';
save type /packages/solx-omniparse/OmniparseResult --json '{"description":"Result payload from solx-omniparse preprocessing. Return bytes_base64 for converted output.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"bytes_base64":{"type":"string","description":"Base64 encoded replacement bytes."},"file_name":{"type":"string","description":"Optional replacement file name for downstream type detection."},"mime_type":{"type":"string","description":"Optional replacement mime type."},"source_path":{"type":"string","description":"Optional alternate source path instead of bytes_base64."},"artifact_name":{"type":"string","description":"Optional alternate artifact to read bytes from."}}}}';
save action /packages/solx-omniparse/solx-omniparse-process-file-write --json '{"action_type":"command","fn_name":"solx-omniparse-process-file-write","caption":"solx-omniparse process-file (write)","category":"extraction","description":"Preprocess a document (PDF/office/etc.) into plain text using omniparse, with ML OCR fallback for scanned/image-only PDFs, and POST the extracted text to solx-server (/docs/save) before returning. Output is {saved:[{path,name}],result:{OmniparseResult fields}}. Requires SOLX_SERVER_URL (set via this action's action_config.env); the bearer token is resolved from SOLX_SERVER_TOKEN/SOLX_TOKEN or falls back to solx-config.json. Soft-fails to a raw (unsaved) result on connection error.","capabilities":["extraction","preprocess","ocr","document-conversion","command","pdf","write"],"phrases":["omniparse process file","convert pdf to text","ocr process file","scanned pdf process file","omniparse process file and save"],"param_type_ref":"/packages/solx-omniparse/OmniparseInput","result_type_ref":"/packages/solx-omniparse/OmniparseResult","action_config":{"cwd":"D:/Projects/solx-packages/solx-omniparse/bin","timeout_secs":600,"env":{"SOLX_SERVER_URL":"http://127.0.0.1:8766"}}}'
