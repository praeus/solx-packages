save action /packages/solx-google/upload-google-drive-image --json '{"actionType":"webhook","fnName":"https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart","caption":"Upload image bytes to Google Drive","category":"google-workspace","description":"POST https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart (multipart/related: JSON metadata + raw media bytes). Used to give a solx-internal image (e.g. a BlogPostWithComments icon) a Drive-hosted, shareable file so it can be referenced by URL elsewhere (e.g. Google Docs insertInlineImage).","capabilities":["google-workspace","drive","rest","webhook","write"],"phrases":["upload image to google drive","upload icon to drive"],"paramTypeRef":"/packages/solx-google/GoogleDriveUploadImageParams","actionConfig":{"secrets":{"GOOGLE_OAUTH_CLIENT_ID":"'$key'","GOOGLE_OAUTH_CLIENT_SECRET":"'$key'","GOOGLE_OAUTH_REFRESH_TOKEN":"'$key'"},"timeout_secs":60,"body_mode":"multipart_related","auth":{"type":"oauth_refresh","client_id_secret":"GOOGLE_OAUTH_CLIENT_ID","client_secret_secret":"GOOGLE_OAUTH_CLIENT_SECRET","refresh_token_secret":"GOOGLE_OAUTH_REFRESH_TOKEN","token_uri":"https://oauth2.googleapis.com/token","scope":"https://www.googleapis.com/auth/drive.file"}}}';
save action /packages/solx-google/share-google-drive-file-public --json '{"actionType":"webhook","fnName":"https://www.googleapis.com/drive/v3/files/{fileId}/permissions","caption":"Share a Google Drive file with anyone who has the link","category":"google-workspace","description":"POST https://www.googleapis.com/drive/v3/files/{fileId}/permissions with {type, role}. Used after upload-google-drive-image so the resulting file can be fetched anonymously (e.g. by Google Docs insertInlineImage).","capabilities":["google-workspace","drive","rest","webhook","write"],"phrases":["share google drive file","make drive file public"],"paramTypeRef":"/packages/solx-google/GoogleDriveShareFileParams","actionConfig":{"secrets":{"GOOGLE_OAUTH_CLIENT_ID":"'$key'","GOOGLE_OAUTH_CLIENT_SECRET":"'$key'","GOOGLE_OAUTH_REFRESH_TOKEN":"'$key'"},"timeout_secs":30,"path_params":{"fileId":""},"auth":{"type":"oauth_refresh","client_id_secret":"GOOGLE_OAUTH_CLIENT_ID","client_secret_secret":"GOOGLE_OAUTH_CLIENT_SECRET","refresh_token_secret":"GOOGLE_OAUTH_REFRESH_TOKEN","token_uri":"https://oauth2.googleapis.com/token","scope":"https://www.googleapis.com/auth/drive.file"}}}';


