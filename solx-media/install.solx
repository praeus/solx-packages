save type /packages/solx-media/MediaDocument --json '{"description":"Result of a solx-media extraction. Persisted to solx-server via entity_save_document by the solx-media actions. Discriminator `kind` picks the extraction mode (image-text, audio-transcript, video-transcript, materialized-html).","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["kind","document_name","contents"],"properties":{"kind":{"type":"string","enum":["image-text","audio-transcript","video-transcript","materialized-html"]},"document_name":{"type":"string"},"title":{"type":["string","null"]},"summary":{"type":["string","null"]},"author":{"type":["string","null"]},"contents":{"type":"object"},"artifacts":{"type":"array","items":{"$ref":"#/$defs/EmbeddedArtifact"}},"transcript":{"type":"string"},"segments":{"type":"array","items":{"$ref":"#/$defs/TimecodedSegment"}},"scene_captions":{"type":"array","items":{"$ref":"#/$defs/TimecodedSegment"}},"description":{"type":"string"},"notes":{"type":"array","items":{"type":"string"}}},"$defs":{"EmbeddedArtifact":{"type":"object","required":["name","content_type","data"],"properties":{"name":{"type":"string"},"content_type":{"type":"string"},"data":{"type":"string"}}},"TimecodedSegment":{"type":"object","required":["start_ms","end_ms","text"],"properties":{"start_ms":{"type":"integer","minimum":0},"end_ms":{"type":"integer","minimum":0},"speaker":{"type":["string","null"]},"text":{"type":"string"}}}}}}';
save type /packages/solx-media/MediaInstallParams --json '{"description":"Params for solx-media install-whisper-model.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"name":{"type":["string","null"],"description":"Whisper model name (e.g. tiny.en). Default: tiny.en"},"force":{"type":"boolean","description":"Re-download even if file exists. Default: false"}}}}';
save action /packages/solx-media/solx-media-image --json '{"action_type":"command","fn_name":"solx-media-image","caption":"Extract image to document","category":"media","description":"Vision-LLM pass: load image, ask Ollama multimedia model, persist as MediaDocument (kind=image-text) at /media/image-text/<name>.","capabilities":["media","image","vision","extraction","command"],"phrases":["describe image","extract image","image to document","vision extract"],"result_type_ref":"/packages/solx-media/MediaDocument","action_config":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":600}}';
save action /packages/solx-media/solx-media-audio --json '{"action_type":"command","fn_name":"solx-media-audio","caption":"Extract audio to document","category":"media","description":"Whisper-transcribe audio via ffmpeg, summarize via Ollama, persist as MediaDocument (kind=audio-transcript) at /media/audio-transcript/<name>.","capabilities":["media","audio","whisper","transcription","extraction","command"],"phrases":["transcribe audio","extract audio","audio to document","audio to text"],"result_type_ref":"/packages/solx-media/MediaDocument","action_config":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":600}}';
save action /packages/solx-media/solx-media-video --json '{"action_type":"command","fn_name":"solx-media-video","caption":"Extract video to document","category":"media","description":"Whisper-transcribe audio track + per-frame vision captions, summarize via Ollama, persist as MediaDocument (kind=video-transcript) at /media/video-transcript/<name>.","capabilities":["media","video","whisper","transcription","vision","extraction","command"],"phrases":["transcribe video","extract video","video to document","video to text"],"result_type_ref":"/packages/solx-media/MediaDocument","action_config":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":1200}}';
save action /packages/solx-media/solx-media-materialize-html --json '{"action_type":"command","fn_name":"solx-media-materialize-html","caption":"Materialize HTML embedded media","category":"media","description":"Walk an HTML rich_text payload, fetch every embedded image (data:/http(s)/path-relative) and rewrite srcs to artifacts/<name>. Persists as MediaDocument (kind=materialized-html) at /media/materialized-html/<name>.","capabilities":["media","html","materialize","extraction","command"],"phrases":["materialize html","embed images","materialize rich text"],"result_type_ref":"/packages/solx-media/MediaDocument","action_config":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":600}}';
save action /packages/solx-media/solx-media-install-whisper-model --json '{"action_type":"command","fn_name":"solx-media-install-whisper-model","caption":"Install whisper model","category":"media","description":"Download a whisper.cpp ggml model from huggingface (default tiny.en), SHA-256 verify, persist active model name to {SOLX_PACKAGES_DIR}/solx-media/config.json. Pass {name} to pick a specific model.","capabilities":["media","whisper","install","setup","command"],"phrases":["install whisper model","download whisper model","setup whisper"],"param_type_ref":"/packages/solx-media/MediaInstallParams","action_config":{"cwd":"D:/Projects/solx-packages/solx-media/bin","timeout_secs":300}}'
