; solx-google login script
;
; Drives the OAuth 2.0 authorization-code flow end-to-end through the
; dispatcher. Runs as a Script-type action whose bin_name points at this
; file (uploaded during install via file_put).
;
; Steps (parallels the old sol-google-login-script.json):
;   1. Read previously-persisted client_id, client_secret, scope (if any).
;   2. Bind the OAuth loopback listener on 127.0.0.1:{port} (default 8765).
;   3. Open the Google consent URL in the system browser via /builtin/open_url.
;   4. Await the OAuth callback (up to {timeout_secs} seconds).
;   5. If the user authorized, exchange the code for tokens via the
;      /packages/solx-google/oauth-token-exchange action.
;   6. Persist client_id, client_secret, scope, and refresh_token via
;      /builtin/set_secret, encrypted with the key configured in this
;      action's action_config.secrets map.
;   7. Always release the loopback port.

; The runner seeds $params from the caller's payload (see ActionCommandRunner).
$existing_client_id = exec /builtin/get_secret --json '{"name":"GOOGLE_OAUTH_CLIENT_ID"}';
$existing_client_secret = exec /builtin/get_secret --json '{"name":"GOOGLE_OAUTH_CLIENT_SECRET"}';
$existing_scope = exec /builtin/get_secret --json '{"name":"GOOGLE_OAUTH_SCOPE"}';

; Prefer caller's params over the persisted secrets — lets the user re-enter
; credentials on a fresh install or rotate them.
$client_id = $params.client_id | $existing_client_id.value;
$client_secret = $params.client_secret | $existing_client_secret.value;
$scope = $params.scope | $existing_scope.value;

; Guard: if the caller did not provide credentials on first run, fail loud
; rather than handing Google an empty client_id.
if $client_id == null
    exec /builtin/open_url --json '{"url":"about:blank"}'
    return { "succeeded": false, "error": "missing_client_id", "error_description": "supply client_id, client_secret, and scope in params on first run" }
endif

$port = $params.port | 8765;
$timeout = $params.timeout_secs | 300;

$loopback = exec /builtin/oauth_start --json '{"port":'$port'}';

; Build the Google authorization URL. $client_id, $scope, $loopback.redirect_uri,
; and $loopback.state_value are all strings at this point.
$auth_url = "https://accounts.google.com/o/oauth2/v2/auth?response_type=code&access_type=offline&prompt=consent&include_granted_scopes=true&client_id=" | $client_id | "&redirect_uri=" | $loopback.redirect_uri | "&scope=" | $scope | "&state=" | $loopback.state_value;

exec /builtin/open_url --json '{"url":"'$auth_url'"}';

$callback = exec /builtin/oauth_await --json '{"state_value":"'$loopback.state_value'","timeout_secs":'$timeout'}';

if $callback.succeeded == true
    ; Exchange the auth code for tokens.
    $token = exec /packages/solx-google/oauth-token-exchange --json '{"code":"'$callback.code'","redirect_uri":"'$loopback.redirect_uri'","client_id":"'$client_id'","client_secret":"'$client_secret'","scope":"'$scope'"}';

    ; Persist refresh_token first so a crash mid-set still leaves us with
    ; the most-likely-to-rotated credential persisted.
    exec /builtin/set_secret --json '{"name":"GOOGLE_OAUTH_REFRESH_TOKEN","value":"'$token.refresh_token'"}';
    exec /builtin/set_secret --json '{"name":"GOOGLE_OAUTH_CLIENT_ID","value":"'$client_id'"}';
    exec /builtin/set_secret --json '{"name":"GOOGLE_OAUTH_CLIENT_SECRET","value":"'$client_secret'"}';
    exec /builtin/set_secret --json '{"name":"GOOGLE_OAUTH_SCOPE","value":"'$scope'"}';

    $result = { "succeeded": true, "access_token": $token.access_token, "refresh_token": $token.refresh_token, "expires_in": $token.expires_in, "scope": $token.scope, "token_type": $token.token_type }
else
    $result = { "succeeded": false, "error": $callback.error, "error_description": $callback.error_description }
endif

; Always release the loopback port.
exec /builtin/oauth_stop --json '{"state_value":"'$loopback.state_value'"}';

return $result