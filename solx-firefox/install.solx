
save file files/actions/shared/solx-firefox-mcp-setup.solx --file mcp-setup.solx;
save file files/actions/shared/solx-firefox-mcp-teardown.solx --file mcp-teardown.solx;


save action /packages/solx-firefox/firefox-start --json {
    "actionType": "command",
    "fnName": "firefox-start",
    "caption": "Start managed Firefox",
    "category": "firefox",
    "description": "Launch (or reuse) a dedicated-profile Firefox instance with Marionette enabled, for MCP-based browser automation via solx-mcp. Parameters are passed on stdin as JSON.",
    "capabilities": ["firefox", "browser", "mcp"],
    "phrases": ["start firefox", "launch firefox devtools", "start managed firefox"],
    "actionConfig": {"cwd": "D:/Projects/solx-packages/solx-firefox/bin"},
};
save action /packages/solx-firefox/firefox-stop --json {
    "actionType": "command",
    "fnName": "firefox-stop",
    "caption": "Stop managed Firefox",
    "category": "firefox",
    "description": "Stop the dedicated-profile Firefox instance previously started by firefox-start. Parameters are passed on stdin as JSON.",
    "capabilities": ["firefox", "browser", "mcp"],
    "phrases": ["stop firefox", "close firefox devtools", "stop managed firefox"],
    "actionConfig": {"cwd": "D:/Projects/solx-packages/solx-firefox/bin"},
};


save action /packages/solx-firefox/firefox-mcp-setup --json {
    "actionType": "script",
    "binName": "solx-firefox-mcp-setup.solx",
    "files": [
        {
            "name": "solx-firefox-mcp-setup.solx",
            "relPath": "files/actions/shared/solx-firefox-mcp-setup.solx",
            "contentType": "text/x-solx",
        },
    ],
    "caption": "Set up Firefox MCP tools",
    "category": "firefox",
    "description": "Start the managed Firefox instance and import its DevTools MCP tools as solx actions in one step.",
    "capabilities": ["firefox", "browser", "mcp", "orchestration"],
    "phrases": [
        "set up firefox mcp",
        "import firefox devtools tools",
        "start and import firefox mcp",
    ],
};
save action /packages/solx-firefox/firefox-mcp-teardown --json {
    "actionType": "script",
    "binName": "solx-firefox-mcp-teardown.solx",
    "files": [
        {
            "name": "solx-firefox-mcp-teardown.solx",
            "relPath": "files/actions/shared/solx-firefox-mcp-teardown.solx",
            "contentType": "text/x-solx",
        },
    ],
    "caption": "Tear down Firefox MCP tools",
    "category": "firefox",
    "description": "Remove the imported Firefox DevTools MCP actions and stop the managed Firefox instance.",
    "capabilities": ["firefox", "browser", "mcp", "orchestration"],
    "phrases": [
        "tear down firefox mcp",
        "remove firefox devtools tools",
        "stop and remove firefox mcp",
    ],
}
