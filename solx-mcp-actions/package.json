{
  "name": "solx-mcp-actions",
  "version": "0.1.0",
  "description": "MCP (Model Context Protocol) action package for solx-core — import MCP tools as Command actions",
  "command_actions": {
    "solx-mcp-actions-import": {
      "command": "D:/Projects/solx-packages/solx-mcp-actions/bin/solx-mcp-actions.exe import",
      "cwd": "D:/Projects/solx-packages/solx-mcp-actions/bin"
    },
    "solx-mcp-actions-remove": {
      "command": "D:/Projects/solx-packages/solx-mcp-actions/bin/solx-mcp-actions.exe remove",
      "cwd": "D:/Projects/solx-packages/solx-mcp-actions/bin"
    }
  }
}
