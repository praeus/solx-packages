save file files/actions/shared/solx-google-actions.wasm --file bin/solx-google-actions.wasm;

# Reinstalling (e.g. to pick up a new package version) must not rotate the
# OAuth encryption key baked into every action below -- that would make
# every already-persisted secret undecryptable and force the user through
# the whole login flow again. If this package was installed before (any
# action already exists under our path), reuse "***": `save action`
# restores the real stored value for any secret whose incoming value is
# that sentinel (see solx-actions::mask::unmask_merge) rather than
# overwriting it. Only a genuinely first-time install generates a fresh key.
$existing = list action --path /packages/solx-google --limit 1;
if $existing.total > 0;
    $key = json '"***"';
else;
    $key = random 32;
endif;

exec /builtin/file/file_put --json '{"rel_path": "files/actions/shared/solx-google-login.solx", "content": "# solx-google login script\n#\n# Drives the OAuth 2.0 authorization-code flow end-to-end through the\n# dispatcher. Runs as a Script-type action whose bin_name points at this\n# file (uploaded during install via file_put).\n#\n# Steps (parallels the old sol-google-login-script.json):\n#   1. Read previously-persisted client_id, client_secret, scope (if any).\n#   2. Bind the OAuth loopback listener on 127.0.0.1:{port} (default 8765).\n#   3. Open the Google consent URL in the system browser via /builtin/web/open_url.\n#   4. Await the OAuth callback (up to {timeout_secs} seconds).\n#   5. If the user authorized, exchange the code for tokens via the\n#      internal /packages/solx-google/_private/oauth-token-exchange action\n#      (not meant to be invoked standalone — it needs an already-obtained\n#      code + redirect_uri from step 4).\n#   6. Persist client_id, client_secret, scope, and refresh_token via\n#      /builtin/secrets/set_secret, encrypted with the key configured in this\n#      action\u0027s action_config.secrets map.\n#   7. Always release the loopback port.\n\n# The runner seeds $params from the caller\u0027s payload (see ActionCommandRunner).\n$existing_client_id = exec /builtin/secrets/get_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_CLIENT_ID\"}\u0027;\n$existing_client_secret = exec /builtin/secrets/get_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_CLIENT_SECRET\"}\u0027;\n$existing_scope = exec /builtin/secrets/get_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_SCOPE\"}\u0027;\n\n# Prefer caller\u0027s params over the persisted secrets — lets the user re-enter\n# credentials on a fresh install or rotate them. client_secret/scope don\u0027t\n# need a null-guard (only client_id does, below), so a plain per-var\n# if/else picking whichever source is non-null is enough for them.\nif $params.client_secret == null;\n    $client_secret = json \u0027\"$existing_client_secret.result.value\"\u0027;\nelse;\n    $client_secret = json \u0027\"$params.client_secret\"\u0027;\nendif;\nif $params.scope == null;\n    $scope = json \u0027\"$existing_scope.result.value\"\u0027;\nelse;\n    $scope = json \u0027\"$params.scope\"\u0027;\nendif;\n\n# Guard: if the caller did not provide credentials on first run (and none are\n# persisted from a previous run), fail loud rather than handing Google an\n# empty client_id. The condition below evaluates the real typed values (not\n# their string form), so it works whether either field is absent or null.\nif $params.client_id == null && $existing_client_id.result.value == null;\n    $result = json \u0027{\"succeeded\":false,\"error\":\"missing_client_id\",\"error_description\":\"supply client_id, client_secret, and scope in params on first run\"}\u0027;\nelse;\n    if $params.client_id == null;\n        $client_id = json \u0027\"$existing_client_id.result.value\"\u0027;\n    else;\n        $client_id = json \u0027\"$params.client_id\"\u0027;\n    endif;\n\n    # 0 is treated the same as absent: neither a loopback port nor an await\n    # timeout can meaningfully be 0, and callers whose UI form defaults a\n    # blank optional integer field to 0 (rather than omitting it) would\n    # otherwise cause an instant oauth_await timeout.\n    if $params.port == null || $params.port == 0;\n        $port = json \u00278765\u0027;\n    else;\n        $port = json \u0027$params.port\u0027;\n    endif;\n    if $params.timeout_secs == null || $params.timeout_secs == 0;\n        $timeout = json \u0027300\u0027;\n    else;\n        $timeout = json \u0027$params.timeout_secs\u0027;\n    endif;\n\n    $loopback = exec /builtin/oauth/oauth_start --json \u0027{\"port\":\u0027$port\u0027}\u0027;\n\n    # Build the Google authorization URL. $client_id, $scope,\n    # $loopback.result.redirect_uri, and $loopback.result.state_value are\n    # all strings at this point. (Every `exec` result is wrapped as\n    # {\"action\",\"result\",\"success\"} -- the actual action output lives under\n    # .result.)\n    $auth_url = json \u0027\"https://accounts.google.com/o/oauth2/v2/auth?response_type=code&access_type=offline&prompt=consent&include_granted_scopes=true&client_id=$client_id&redirect_uri=$loopback.result.redirect_uri&scope=$scope&state=$loopback.result.state_value\"\u0027;\n\n    exec /builtin/web/open_url --json \u0027{\"url\":\"\u0027$auth_url\u0027\"}\u0027;\n\n    $callback = exec /builtin/oauth/oauth_await --json \u0027{\"state_value\":\"\u0027$loopback.result.state_value\u0027\",\"timeout_secs\":\u0027$timeout\u0027}\u0027;\n\n    # Always release the loopback port, whether or not the callback succeeded.\n    exec /builtin/oauth/oauth_stop --json \u0027{\"state_value\":\"\u0027$loopback.result.state_value\u0027\"}\u0027;\n\n    if $callback.result.succeeded == true;\n        # The token-exchange action below resolves client_id/client_secret\n        # itself, through its OWN configured secret store (action_config.secrets\n        # + auth.client_id_secret/client_secret_secret) -- it does NOT read\n        # them from these exec params (only `code` is used from params). So\n        # they must already be persisted under GOOGLE_OAUTH_CLIENT_ID /\n        # GOOGLE_OAUTH_CLIENT_SECRET / GOOGLE_OAUTH_SCOPE *before* this call,\n        # not after, or a first-time login (nothing persisted yet) fails with\n        # \"secret \u0027GOOGLE_OAUTH_CLIENT_ID\u0027 is not set\".\n        exec /builtin/secrets/set_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_CLIENT_ID\",\"value\":\"\u0027$client_id\u0027\"}\u0027;\n        exec /builtin/secrets/set_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_CLIENT_SECRET\",\"value\":\"\u0027$client_secret\u0027\"}\u0027;\n        exec /builtin/secrets/set_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_SCOPE\",\"value\":\"\u0027$scope\u0027\"}\u0027;\n\n        # Exchange the auth code for tokens.\n        $token = exec /packages/solx-google/_private/oauth-token-exchange --json \u0027{\"code\":\"\u0027$callback.result.code\u0027\",\"redirect_uri\":\"\u0027$loopback.result.redirect_uri\u0027\",\"client_id\":\"\u0027$client_id\u0027\",\"client_secret\":\"\u0027$client_secret\u0027\",\"scope\":\"\u0027$scope\u0027\"}\u0027;\n\n        exec /builtin/secrets/set_secret --json \u0027{\"name\":\"GOOGLE_OAUTH_REFRESH_TOKEN\",\"value\":\"\u0027$token.result.refresh_token\u0027\"}\u0027;\n\n        $result = json \u0027{\"succeeded\":true,\"access_token\":\"\u0027$token.result.access_token\u0027\",\"refresh_token\":\"\u0027$token.result.refresh_token\u0027\",\"expires_in\":\u0027$token.result.expires_in\u0027,\"scope\":\"\u0027$token.result.scope\u0027\",\"token_type\":\"\u0027$token.result.token_type\u0027\"}\u0027;\n    else;\n        $result = json \u0027{\"succeeded\":false,\"error\":\"\u0027$callback.result.error\u0027\",\"error_description\":\"\u0027$callback.result.error_description\u0027\"}\u0027;\n    endif;\nendif;\n"}';

save action /packages/solx-google/login-to-google --json '{"actionType":"script","binName":"solx-google-login.solx","caption":"Log in to Google (one-shot OAuth flow)","category":"google-workspace","description":"Drives the OAuth 2.0 authorization-code flow end-to-end. Binds the loopback listener, opens the system browser, awaits the callback, exchanges the code for tokens, persists the credentials via /builtin/secrets/set_secret, and releases the port.","capabilities":["google-workspace","oauth","orchestration","script"],"phrases":["log in to google","login to google","google login","sign in to google","google oauth","connect google"],"paramTypeRef":"/packages/solx-google/GoogleOAuthLoginParams","actionConfig":{"secrets":{"GOOGLE_OAUTH_CLIENT_ID":"'$key'","GOOGLE_OAUTH_CLIENT_SECRET":"'$key'","GOOGLE_OAUTH_REFRESH_TOKEN":"'$key'","GOOGLE_OAUTH_SCOPE":"'$key'"}}}';


save type /packages/solx-google/GoogleDocsGetParams --json '{"description":"Input for get-google-doc (GET https://docs.googleapis.com/v1/documents/{documentId}).","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["documentId"],"properties":{"documentId":{"type":"string","description":"Google Docs document ID. Filled into the {documentId} URL template."},"format":{"type":"string","description":"Reserved; ignored by the current REST path."}}}}';
save type /packages/solx-google/GoogleDocsPostParams --json '{"description":"Input for post-google-doc (documents.batchUpdate). documentId is stripped and substituted into the URL path; every other field is sent as-is as the request body, so requests (and optionally writeControl) must be top-level here -- NOT nested under a body key, since Google rejects an unrecognized top-level body field.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["documentId","requests"],"properties":{"documentId":{"type":"string"},"requests":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Array of Google Docs batchUpdate Request objects."},"writeControl":{"type":"object","additionalProperties":true,"description":"Optional batchUpdate writeControl."}},"additionalProperties":true}}';
save type /packages/solx-google/GoogleDocsDoc --json '{"description":"Google Docs API document JSON.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":true,"properties":{"documentId":{"type":"string"},"title":{"type":"string"},"body":{"type":"object","additionalProperties":true},"revisionId":{"type":"string"}}}}';
save type /packages/solx-google/SolDocToGoogleDocParams --json '{"description":"Input for convert-sol-doc-to-google-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"sol_document":{"type":"object","additionalProperties":true,"description":"Optional full Sol document JSON."},"sol_document_name":{"type":"string","description":"Optional Sol document name to fetch via /builtin/document/entity_get_document."},"default_title":{"type":"string"},"text_field_hint":{"type":"string"},"rich_text_field_hint":{"type":"string","description":"Optional field name in contents holding the Tiptap RichTextDoc."}}}}';
save type /packages/solx-google/SolDocToGoogleDocResult --json '{"description":"Result for convert-sol-doc-to-google-doc. create_body is shaped to match GoogleDriveCreateFileParams (name+mimeType) so it can be passed directly to create-google-file; batch_update_body is already {\"requests\":[...]} shaped to match GoogleDocsPostParams -- merge in the documentId from the create-google-file response and pass the result directly to post-google-doc (do not nest it under a body key).","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"title":{"type":"string"},"text":{"type":"string"},"create_body":{"type":"object","additionalProperties":true},"batch_update_body":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';
save type /packages/solx-google/UploadDocsToGoogleDocsParams --json '{"description":"Input for upload-documents-to-google-docs.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["path_prefix","count"],"properties":{"path_prefix":{"type":"string","description":"Folder (and descendants) to pull Sol documents from."},"count":{"type":"integer","minimum":1,"description":"Number of documents to upload (N)."},"order":{"type":"string","enum":["asc","desc"],"description":"Sort order by updated_at; defaults to desc (most recently updated first)."},"offset":{"type":"integer","minimum":0,"description":"Number of documents to skip before taking count; defaults to 0."},"parent_folder_id":{"type":"string","description":"Optional Google Drive folder ID to create the new Docs in; omitted creates at Drive root."}}}}';
save type /packages/solx-google/UploadDocsToGoogleDocsResult --json '{"description":"Result for upload-documents-to-google-docs.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"requested":{"type":"integer"},"found":{"type":"integer"},"uploaded":{"type":"array","items":{"type":"object","properties":{"sol_document_path":{"type":"string"},"sol_document_name":{"type":"string"},"title":{"type":"string"},"google_doc_id":{"type":"string"},"google_doc_url":{"type":"string"},"action":{"type":"string","enum":["created","updated"],"description":"\u0027created\u0027 if this was a brand-new Google Doc; \u0027updated\u0027 if a doc already tagged with this Sol document\u0027s path was found and reposted into instead."}}}}}}}';
save type /packages/solx-google/GoogleDocToSolDocParams --json '{"description":"Input for convert-google-doc-to-sol-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["google_doc"],"properties":{"google_doc":{"type":"object","additionalProperties":true},"output_document_name":{"type":"string"},"output_type_name":{"type":"string"}}}}';
save type /packages/solx-google/GoogleDocToSolDocResult --json '{"description":"Result for convert-google-doc-to-sol-doc.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"source_document_id":{"type":["string","null"]},"source_title":{"type":["string","null"]},"text":{"type":"string"},"suggested_document_name":{"type":"string"},"sol_document_payload":{"type":"object","additionalProperties":true},"metadata":{"type":"object","additionalProperties":true}}}}';
save type /packages/solx-google/GoogleDriveFindFolderParams --json '{"description":"Input for find-google-drive-folder.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"q":{"type":"string"},"fields":{"type":"string"},"pageSize":{"type":"integer","minimum":1,"maximum":1000},"corpora":{"type":"string","enum":["user","drive","allDrives","domain"]},"supportsAllDrives":{"type":"boolean"},"includeItemsFromAllDrives":{"type":"boolean"}},"additionalProperties":true}}';
save type /packages/solx-google/GoogleDriveCreateFileParams --json '{"description":"Input for create-google-file.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["name","mimeType"],"properties":{"name":{"type":"string"},"mimeType":{"type":"string"},"parents":{"type":"array","items":{"type":"string"}},"description":{"type":"string"},"fields":{"type":"string"},"appProperties":{"type":"object","additionalProperties":{"type":"string"},"description":"Private, app-only key/value tags on the created file, queryable later via find-google-drive-folder\u0027s q (appProperties has {key:...}). upload-documents-to-google-docs uses this to avoid recreating a Google Doc it already made for the same Sol document."}},"additionalProperties":true}}';
save type /packages/solx-google/GoogleDriveUploadImageParams --json '{"description":"Input for upload-google-drive-image (Drive files.create?uploadType=multipart). Uploads raw image bytes as a new Drive file.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["metadata","media_base64","media_content_type"],"properties":{"metadata":{"type":"object","additionalProperties":true,"description":"Drive file metadata, e.g. {\"name\": \"icon.png\"}."},"media_base64":{"type":"string","description":"Base64-encoded image bytes."},"media_content_type":{"type":"string","description":"MIME type of the image bytes, e.g. image/png."}}}}';
save type /packages/solx-google/GoogleDriveShareFileParams --json '{"description":"Input for share-google-drive-file-public (Drive permissions.create).","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["fileId"],"properties":{"fileId":{"type":"string","description":"Google Drive file ID. Filled into the {fileId} URL template, not sent in the body."},"type":{"type":"string","description":"Defaults to \"anyone\" if omitted by the caller."},"role":{"type":"string","description":"Defaults to \"reader\" if omitted by the caller."}}}}';
save type /packages/solx-google/GoogleOAuthLoginParams --json '{"description":"Input for login-to-google (and oauth-token-exchange).","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"client_id":{"type":"string"},"client_secret":{"type":"string"},"scope":{"type":"string"},"port":{"type":"integer"},"timeout_secs":{"type":"integer"},"code":{"type":"string"},"redirect_uri":{"type":"string"}}}}';
save type /packages/solx-google/GmailListParams --json '{"description":"Input for list-gmail-messages.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"q":{"type":"string"},"labelIds":{"type":"array","items":{"type":"string"}},"maxResults":{"type":"integer","minimum":1,"maximum":500},"pageToken":{"type":"string"}},"additionalProperties":true}}';
