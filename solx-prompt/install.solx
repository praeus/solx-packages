# solx-prompt install.
#
# One package, two actions out of two toolchains: `prompt` is the wasm32-wasip2
# three-phase planner under crate/, `prompt-widget` is the WidgetDescriptor
# script action fronting the vite bundle built from widget/. Both artifacts must
# be staged before this script runs - crate/bin/solx-prompt.wasm and
# widget/dist/solx-prompt.js - so ./build.sh or .\build.ps1 comes first.
#
# Paths here are relative to the package root, because `solx install-package`
# sets the cwd there before running this.
#
# actionConfig.timeout_secs below (4200s) covers two sequential llm phases, each
# potentially run detached (via /builtin/action/start+poll) up to the *child*
# action's own configured outer ceiling rather than solx-prompt's `timeout_secs`
# param (which only bounds the inner per-request timeout of each phase) -
# solx-ollama's ollama-chat currently ships with a 1860s outer ceiling of its
# own, so 2x that plus headroom for the search phase and polling. Half
# solx-inquiry's multi-inquire budget, because there is no fan-out here.

save file files/actions/shared/solx-prompt.wasm --file crate/bin/solx-prompt.wasm;

save file files/actions/shared/solx-prompt-widget-descriptor.solx --file widget/prompt-widget-descriptor.solx;

save file widgets/solx-prompt.js --file widget/dist/solx-prompt.js;

# --- types -------------------------------------------------------------------

save type /packages/solx-prompt/PromptParams --json '''{"description":"Parameters for the prompt action: one intent call decides answer-directly vs look-up and proposes abstract steps, a no-llm search phase resolves those against the actions and documents databases, and one steps call turns them into concrete, catalogue-validated action steps plus a next_prompt. Takes prior turns inline as history and has no session reference: it writes no documents at all, and reads none beyond the context documents named here.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["prompt","model"],"properties":{"prompt":{"type":"string","description":"The instruction or question to act on."},"model":{"type":"string","description":"Chat model name passed to the llm action for both the intent and steps calls."},"history":{"type":["array","null"],"description":"Prior turns, oldest first. The caller holds the transcript and passes the window it wants the model to see; there is no session document to read. Each entry is {prompt, message, steps, results} - results being what the caller got back from executing that turn steps, which is the only way this action can learn what its own plans actually did.","items":{"type":"object","properties":{"prompt":{"type":"string"},"message":{"type":"string"},"steps":{"type":"array","items":{"type":"object"}},"results":{"type":"array","description":"One entry per executed step: {action_ref, status, summary}.","items":{"type":"object"}}}}},"context_documents":{"type":["array","null"],"description":"Up to 10 full path/name document references to load verbatim as grounding for both llm calls. Named by the caller for this prompt specifically, so unlike a skill or a memory nothing decides whether they apply.","items":{"type":"string"}},"history_limit":{"type":["integer","null"],"description":"How many of the supplied turns reach the intent prompt. Defaults to 6, clamped to 20."},"recall_limit":{"type":["integer","null"],"description":"How many memories to recall. Defaults to 5, clamped to 20."},"max_terms":{"type":["integer","null"],"description":"Upper bound on search terms per look-up. Defaults to 5, clamped to 10."},"max_results":{"type":["integer","null"],"description":"Upper bound on merged hits fed to the steps call and returned to the caller. Defaults to 10, clamped to 50."},"max_steps":{"type":["integer","null"],"description":"Upper bound on concrete steps the steps phase may return. Defaults to 8, clamped to 20."},"document_path_prefix":{"type":["string","null"],"description":"Restrict document search to this path prefix."},"action_path_prefix":{"type":["string","null"],"description":"Restrict action search to this path prefix."},"type_ref":{"type":["string","null"],"description":"Restrict document search to this type reference. Ignored for action search."},"skills_path":{"type":["string","null"],"description":"Where PromptSkill documents live. Defaults to /solx-prompt/skills."},"memory_path":{"type":["string","null"],"description":"Where this caller own PromptMemory documents live. Omitting it turns memory recall off entirely - supplying it is the caller declaring where its own past output lives, which is what keeps that output from coming back as evidence in a later turn."},"intent_prompt":{"type":["string","null"],"description":"Override the default system prompt for the intent call."},"steps_prompt":{"type":["string","null"],"description":"Override the default system prompt for the steps call."},"llm_action_ref":{"type":["string","null"],"description":"Action reference for the chat action both phases drive. Defaults to /packages/solx-ollama/ollama-chat; any action taking {model, messages, format} and returning {message:{content}} works."},"base_url":{"type":["string","null"],"description":"Passed through to the llm action."},"api_key":{"type":["string","null"],"description":"Passed through to the llm action."},"auth_secret_name":{"type":["string","null"],"description":"Passed through to the llm action."},"headers":{"type":["object","null"],"description":"Passed through to the llm action."},"options":{"type":["object","null"],"description":"Merged key-by-key into every call own options object, so the pipeline temperature:0 survives a caller adding num_ctx. The only way to raise num_ctx."},"timeout_secs":{"type":["integer","null"],"description":"Per-llm-call timeout, forwarded to both chat calls. Clamped to 900."}}}}''';

save type /packages/solx-prompt/PromptResult --json '''{"description":"Result of the prompt action. Documentation only - solx never validates result shapes. This action writes nothing at all: memories come back as ready-to-save document payloads, steps as a ready-to-execute plan, and turn as a record for the caller to append to whatever it keeps history in. Deciding what to keep, run or persist is entirely the caller.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"prompt":{"type":"string","description":"Echo of the request."},"model":{"type":"string"},"mode":{"type":"string","enum":["direct","steps"],"description":"Whether the intent phase answered outright or proposed work. Read off what it actually produced, not off a mode it declared."},"message":{"type":"string","description":"The answer to show the user. Complete on its own in direct mode; otherwise it frames the steps."},"steps":{"type":"array","description":"Concrete action calls, in order. Each names an action the search phase actually surfaced; a step naming anything else, or referencing a capture no earlier step defines, was dropped and the reason is in notes.","items":{"type":"object","required":["action_ref","params"],"properties":{"action_ref":{"type":"string"},"params":{"type":"object"},"capture":{"type":["string","null"],"description":"Name this step result so a later step can read it as a dollar-prefixed reference, optionally with one dotted field. The caller substitutes the real value before calling that step."}}}},"destructive":{"type":"array","description":"Which of the steps action_refs carry solx:destructive, or run as a command or webhook. Surfaced rather than refused - deleting something can be exactly what was asked for - but a caller told to execute these must not have to inspect each one to find out.","items":{"type":"string"}},"next_prompt":{"type":["string","null"],"description":"The instruction for a later round, once these steps have been executed. Null when the turn is complete in itself."},"memories":{"type":"array","description":"Ready-to-save PromptMemory document payloads for whatever the steps phase flagged as durable. Empty when no memory_path was given.","items":{"type":"object"}},"turn":{"type":"object","description":"This turn record, shaped to be appended to a session document contents.turns array. It carries no results - the steps have not run yet, and the caller that runs them is the one that appends them."},"hits":{"type":"array","description":"What the search phase found, best match first. Action hits carry both paramSchema and resultSchema.","items":{"type":"object"}},"notes":{"type":"array","description":"Anything the caller should know that is not an error: a step that was dropped and why, a memory that was refused as ungrounded.","items":{"type":"string"}},"errors":{"type":"array","items":{"type":"object"}}}}}''';

# turns is deliberately undeclared. solx-docs computes a document full-text
# content by walking only the fields its type declares, so an undeclared turns
# is stored and returned but never enters the FTS index. That matters because
# these documents grow with every prompt and would otherwise re-index an entire
# growing transcript each time - the same reasoning behind solx-agent's
# undeclared messages. title and summary *are* indexed, which is what lets a
# session be found later by what it was about.
#
# Written by the widget, never by the action: prompt has no session reference
# and no document writes. The type lives here because a type has to be
# registered by an installable package, and this is the package the widget
# ships in.
save type /packages/solx-prompt/PromptSession --json '''{"description":"The history of one prompt conversation: every turn, with the prompt, the message, the concrete steps, what those steps returned, and the next_prompt. Written by the prompt-widget after each turn - the prompt action itself persists nothing.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"turnCount":{"type":"integer","description":"How many turns this session holds."},"lastPrompt":{"type":"string","description":"The most recent prompt, for a session picker subtitle."}}}}''';

save type /packages/solx-prompt/PromptMemory --json '''{"description":"One durable thing a prompt run established, flagged by the model as worth keeping and saved by the caller. Minted only from the steps phase, which has seen search results - an answer the intent phase gave without searching anything is model prior, and writing it down would let it come back later looking like a grounded finding. The author field records which action produced it, so whatever reads the document later can tell model output from something a person wrote.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["text"],"properties":{"text":{"type":"string","description":"The memory itself, as a standalone statement. Also stored in the document summary, which is what makes recall a single search with no follow-up read."},"tags":{"type":"array","items":{"type":"string"}},"prompt":{"type":"string","description":"The prompt this was established from."}}}}''';

save type /packages/solx-prompt/PromptSkill --json '''{"description":"Operator guidance for one kind of prompt, injected as reference material into the intent and steps calls. Two things govern writing one: --json is parsed as a DocumentInput, so these fields must sit under contents (serde ignores unknown fields, so a top-level instructions key saves an empty document and the skill silently never loads); and the total skill budget is 8000 characters across every skill in one turn, so a long skill crowds the others out.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["instructions"],"properties":{"instructions":{"type":"string"},"scope":{"type":"string","enum":["documents","actions","both"],"description":"Which kind of look-up this bears on. both always rides along."},"tools":{"type":"array","description":"Glob patterns. When set, this skill only loads for a turn whose action hits include a matching reference.","items":{"type":"string"}}}}}''';

save type /packages/solx-prompt/PromptCallLog --json '''{"description":"The durable index behind one widget session merged console: which action invocations (action_ref, invocation_id, starting cursor) belong to it, so a reload or another client can re-tail and re-merge the same console entries. Not the console entries themselves - those already persist per action_ref regardless of this document. A widget needs this because console-copy resolves its destination from the calling action, and a widget own calls are external execs with no caller at all.","schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"calls":{"type":"array","description":"One entry per tracked action invocation, oldest first.","items":{"type":"object","required":["actionRef","name","invocationId","consoleSeqStart","startedAt"],"properties":{"actionRef":{"type":"string","description":"The full action reference whose console this invocation wrote to."},"name":{"type":"string","description":"The action name, for display when no label is given."},"invocationId":{"type":"string","description":"Filters the shared console down to entries from just this invocation."},"consoleSeqStart":{"type":"integer","description":"The console seq in place when this call started; entries before it predate the call."},"startedAt":{"type":"string","description":"ISO timestamp this call was started."},"label":{"type":"string","description":"Optional display label, shown instead of name."}}}}}}}''';

# --- actions -----------------------------------------------------------------

save action /packages/solx-prompt/prompt --json '''{"actionType":"wasm","binName":"solx-prompt.wasm","fnName":"prompt","caption":"Prompt","category":"llm","description":"Turn a natural-language prompt into a message plus a runnable plan. One intent call decides whether the prompt can be answered outright or needs looking up and, if so, proposes abstract steps each carrying its own search prompt rather than an action name; a no-llm search phase resolves those against the actions and documents databases, fetching each candidate action parameter and result schema; one steps call turns the abstract plan into concrete action steps with params and captures, validated against what the search actually surfaced, plus a next_prompt for the round after they run. Two model calls, no fan-out. Takes prior turns inline as history and persists nothing: memories and this turn record come back as payloads for the caller to keep.","capabilities":["llm","prompt","plan","steps","rag"],"phrases":["do this for me","work out how to do this","turn this into a plan","plan this out","what should i do about"],"paramTypeRef":"/packages/solx-prompt/PromptParams","resultTypeRef":"/packages/solx-prompt/PromptResult","actionConfig":{"timeout_secs":4200}}''';

save action /packages/solx-prompt/prompt-widget --json '''{"actionType":"script","binName":"solx-prompt-widget-descriptor.solx","caption":"Prompt","category":"widgets","description":"A chat interface for the prompt action, with a merged console panel. The widget owns the loop: it sends a prompt, receives a message plus concrete steps, executes those steps in order (substituting each captured value, and stopping for explicit approval on anything marked destructive), then feeds the step results and the returned next_prompt back in as the next prompt. Every turn runs under a named, persisted session, so the next turn sees what the previous ones did. Requires solx-prompt own prompt action, a chat action such as solx-ollama, and solx-names; a missing one surfaces as a turn error rather than a failure to mount.","capabilities":["widget","ui","llm","chat","plan"],"phrases":["open prompt","show prompt widget","prompt console"],"resultTypeRef":"/builtin/types/WidgetDescriptor"}''';

# --- seeded skills -----------------------------------------------------------
#
# One placeholder for now, so an install exercises the path and the type. The
# real set lands with the intent and steps prompts it has to agree with, and is
# listed in uninstall.solx as it grows.

save doc /solx-prompt/skills/optional-params --type /packages/solx-prompt/PromptSkill --json '''{"title":"Omit optional parameters, never null them","contents":{"scope":"both","instructions":"Never send null for an optional parameter. An optional string is typed as a string, so an explicit null fails validation and errors the whole call. Omit the key instead."}}''';
