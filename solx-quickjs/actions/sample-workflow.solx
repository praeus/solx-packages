save action /packages/solx-quickjs/demo-js-action --json '{"action_type":"wasm","bin_name":"demo-js-action.wasm","caption":"Demo JS action","description":"Sample action built by solx-quickjs from sample-document-summary.js."}';
exec /packages/solx-quickjs/demo-js-action --json '{"limit":5}'
