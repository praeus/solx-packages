save file solx-conductor.js --file src/solx-conductor.js;
save file names.js --file src/names.js;
exec /packages/solx-quickjs/build-javascript-file --json '{"entry_artifact_name": "solx-conductor.js", "source_artifact_names": ["solx-conductor.js", "names.js"], "output_artifact_name": "solx-conductor.wasm"}';

save type /packages/solx-conductor/StartParams --json '{"description": "Create a conductor session: resolve a tool catalogue from a query plus an allowlist, seed the transcript with any memories, context and skills, and return the session id. Nothing runs until conductor-step.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["model", "goal", "allow"], "properties": {"model": {"type": "string", "description": "Ollama model name. It must support tools; one that does not rejects the request."}, "goal": {"type": "string", "description": "The task, as the first user turn. Also the default tool_query."}, "system": {"type": ["string", "null"], "description": "Optional system turn, prepended."}, "allow": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "description": "Glob over the action path. * matches any characters including /."}, "actions": {"type": ["array", "null"], "items": {"type": "string"}, "description": "When set and non-empty, only these action names at the matched path. Command and Webhook actions are ONLY ever reachable through an exact name here - a glob never reaches a shell."}}}, "description": "Default-deny allowlist. Required and non-empty; there is no wildcard shorthand. Hidden actions are filtered out host-side before this applies, and /builtin/secrets, /builtin/action, /builtin/env/set_env and this package itself are refused regardless."}, "tool_query": {"type": ["string", "null"], "description": "Full-text query selecting which permitted actions become tools. Defaults to goal. Catalogue by search, not by listing - every tool definition is prompt tokens on every iteration."}, "catalogue_cap": {"type": ["integer", "null"], "description": "Maximum tools offered, including any added later by sys__tool_search. Defaults to 16."}, "memory": {"type": ["object", "null"], "description": "Memory is off unless a scope is named. Memories live under /conductor/memories/SCOPE and are shared by every session using that scope: one run writes what it learned, the next reads it back. They are model-written text that re-enters a later prompt, so a scope is a trust boundary - keep unrelated tasks in separate scopes.", "properties": {"scope": {"type": "string", "description": "A single path segment. Required for memory to be enabled at all."}, "query": {"type": ["string", "null"], "description": "What to recall at start. Defaults to the goal."}, "limit": {"type": ["integer", "null"], "description": "How many memories to recall at start. Defaults to 5, capped at 20."}, "read": {"type": ["boolean", "null"], "description": "Defaults to true. False keeps writing without recalling."}, "write": {"type": ["boolean", "null"], "description": "Defaults to true. False makes the scope read-only for this session."}, "max_writes": {"type": ["integer", "null"], "description": "Memories this session may write. Defaults to 20."}}}, "context": {"type": ["array", "null"], "description": "Documents to put within the model reach. Each entry either names one document by ref, or searches for several. Only the titles and summaries are injected; the model calls sys__context_read to open one in full. The resolved list is frozen at start, and it is the only thing sys__context_read can open.", "items": {"type": "object", "properties": {"ref": {"type": ["string", "null"], "description": "One document, by full reference. A ref that does not resolve is an error rather than a silent gap."}, "query": {"type": ["string", "null"], "description": "Full-text query over documents."}, "path": {"type": ["string", "null"], "description": "Restrict the query to this path and everything under it."}, "typeRef": {"type": ["string", "null"], "description": "Restrict the query to one document type. Exact match."}, "limit": {"type": ["integer", "null"]}}}}, "skills": {"type": ["object", "null"], "description": "Skill documents describe how to use particular tools. A skill declares the action refs it covers as globs, and loads only when one of them is in the catalogue - so it never carries reach the session did not already have. On by default; there are simply no skills until someone writes one.", "properties": {"enabled": {"type": ["boolean", "null"], "description": "Defaults to true."}, "path": {"type": ["string", "null"], "description": "Where to look. Defaults to /conductor/skills. That default path stays write-protected against the model even when this points elsewhere."}, "limit": {"type": ["integer", "null"], "description": "Skill documents to consider. Defaults to 10."}}}, "tool_search": {"type": ["boolean", "null"], "description": "Whether the model may search for more tools mid-session, through sys__tool_search. Defaults to true. It searches the same allowlist frozen at start, so it widens what the model can SEE without widening what it may CALL, and it stops at catalogue_cap."}, "max_iterations": {"type": ["integer", "null"], "description": "Defaults to 12."}, "chat_timeout_secs": {"type": ["integer", "null"], "description": "Per-chat HTTP timeout passed through to ollama-chat. Clamped there to 1800."}}}}';
save type /packages/solx-conductor/StepParams --json '{"description": "Run exactly one iteration of a session, or resume one suspended for approval.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["session_id"], "properties": {"session_id": {"type": "string"}, "approve": {"type": ["array", "null"], "items": {"type": "string"}, "description": "call_id values from a previous awaiting_approval result. Anything not named is denied - an empty or missing list denies everything, which is the safe direction to fail. A call_id covers one exact set of arguments and never carries into a later iteration."}}}}';
save type /packages/solx-conductor/RunParams --json '{"description": "Step until the session finishes, hits its iteration cap, or stops for approval. Returns the same shape as conductor-step.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["session_id"], "properties": {"session_id": {"type": "string"}, "approve": {"type": ["array", "null"], "items": {"type": "string"}, "description": "Applied to the first step only. This action cannot approve on your behalf, so it returns as soon as anything else needs a decision."}}}}';
save type /packages/solx-conductor/SessionParams --json '{"description": "Read a conductor session back: transcript, tool call log, and status.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["session_id"], "properties": {"session_id": {"type": "string"}}}}';
save type /packages/solx-conductor/ToolsParams --json '{"description": "Resolve a catalogue without starting a session - what a model WOULD see for this query, allowlist, memory scope and context.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["allow"], "properties": {"allow": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "description": "Glob over the action path. * matches any characters including /."}, "actions": {"type": ["array", "null"], "items": {"type": "string"}, "description": "When set and non-empty, only these action names at the matched path. Command and Webhook actions are ONLY ever reachable through an exact name here - a glob never reaches a shell."}}}, "description": "Default-deny allowlist. Required and non-empty; there is no wildcard shorthand. Hidden actions are filtered out host-side before this applies, and /builtin/secrets, /builtin/action, /builtin/env/set_env and this package itself are refused regardless."}, "tool_query": {"type": ["string", "null"]}, "catalogue_cap": {"type": ["integer", "null"]}, "memory": {"type": ["object", "null"], "description": "Memory is off unless a scope is named. Memories live under /conductor/memories/SCOPE and are shared by every session using that scope: one run writes what it learned, the next reads it back. They are model-written text that re-enters a later prompt, so a scope is a trust boundary - keep unrelated tasks in separate scopes.", "properties": {"scope": {"type": "string", "description": "A single path segment. Required for memory to be enabled at all."}, "query": {"type": ["string", "null"], "description": "What to recall at start. Defaults to the goal."}, "limit": {"type": ["integer", "null"], "description": "How many memories to recall at start. Defaults to 5, capped at 20."}, "read": {"type": ["boolean", "null"], "description": "Defaults to true. False keeps writing without recalling."}, "write": {"type": ["boolean", "null"], "description": "Defaults to true. False makes the scope read-only for this session."}, "max_writes": {"type": ["integer", "null"], "description": "Memories this session may write. Defaults to 20."}}}, "context": {"type": ["array", "null"], "description": "Documents to put within the model reach. Each entry either names one document by ref, or searches for several. Only the titles and summaries are injected; the model calls sys__context_read to open one in full. The resolved list is frozen at start, and it is the only thing sys__context_read can open.", "items": {"type": "object", "properties": {"ref": {"type": ["string", "null"], "description": "One document, by full reference. A ref that does not resolve is an error rather than a silent gap."}, "query": {"type": ["string", "null"], "description": "Full-text query over documents."}, "path": {"type": ["string", "null"], "description": "Restrict the query to this path and everything under it."}, "typeRef": {"type": ["string", "null"], "description": "Restrict the query to one document type. Exact match."}, "limit": {"type": ["integer", "null"]}}}}, "skills": {"type": ["object", "null"], "description": "Skill documents describe how to use particular tools. A skill declares the action refs it covers as globs, and loads only when one of them is in the catalogue - so it never carries reach the session did not already have. On by default; there are simply no skills until someone writes one.", "properties": {"enabled": {"type": ["boolean", "null"], "description": "Defaults to true."}, "path": {"type": ["string", "null"], "description": "Where to look. Defaults to /conductor/skills. That default path stays write-protected against the model even when this points elsewhere."}, "limit": {"type": ["integer", "null"], "description": "Skill documents to consider. Defaults to 10."}}}}}}';
save type /packages/solx-conductor/ConductorMemory --json '{"description": "One thing a conductor session learned, written by the model through sys__memory_save and recalled by later sessions in the same scope. The text is capped at 1000 characters and stored in the document summary as well as here, which is what lets recall be a single search with no follow-up reads. Treat the text as model output, not as fact.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["text"], "properties": {"text": {"type": "string", "description": "The note itself."}, "tags": {"type": "array", "items": {"type": "string"}, "description": "Optional keywords, indexed for search."}, "scope": {"type": "string", "description": "The memory scope this was written in."}, "sourceSession": {"type": ["string", "null"], "description": "The session that wrote it."}}}}';
save type /packages/solx-conductor/ConductorSkill --json '{"description": "Operator guidance for using particular tools. Bound to action references by glob, so one skill can cover a whole family. It is injected only when a matching tool is in the session catalogue, which means a skill never grants reach - it only explains reach that was already granted. Write one with: solx save document /conductor/skills/NAME --type /packages/solx-conductor/ConductorSkill", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["tools", "instructions"], "properties": {"tools": {"type": "array", "items": {"type": "string"}, "description": "Action reference globs, for example /builtin/document/* or /packages/solx-media/transcode. * matches any characters including /."}, "instructions": {"type": "string", "description": "What the model should know about these tools. Capped at 4000 characters, and 8000 across all skills in one session."}}}}';
save type /packages/solx-conductor/ConductorSession --json '{"description": "The stored state of one conductor session: transcript, frozen catalogue, allowlist, context index, pending approvals, and the tool call audit log. Written by conductor-start and rewritten by every conductor-step. Deliberately permissive - the shape evolves with the package, and a session that fails validation mid-loop would strand the run.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "properties": {"model": {"type": "string"}, "status": {"type": "string"}, "iteration": {"type": "integer"}, "allow": {"type": "array", "description": "Frozen at start. Read from here on every step, so a later caller cannot widen a running session - and re-checked at dispatch, so editing it here buys nothing either."}, "tools": {"type": "object", "description": "Tool name to action reference. The dispatch table, but not the authority: every call is gated again against allow at the moment it runs."}, "memory": {"type": ["object", "null"], "description": "The memory scope and its budgets, frozen at start."}, "memories_written": {"type": "integer"}, "context": {"type": "array", "description": "The frozen context index. sys__context_read can open these and nothing else."}, "skills": {"type": ["object", "null"], "description": "Where skills are read from, frozen at start."}, "pending": {"type": "array", "description": "Non-empty only while awaiting approval. Cleared at the end of every iteration, so an approval never survives into the next one."}}}}';
save type /packages/solx-conductor/StepResult --json '{"description": "Outcome of one iteration. Documentation only - result schemas are not validated.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "properties": {"session_id": {"type": "string"}, "status": {"type": "string", "description": "running, awaiting_approval, final, blocked, exhausted, or cancelled."}, "iteration": {"type": "integer"}, "max_iterations": {"type": "integer"}, "final": {"type": ["string", "null"], "description": "The closing message from the model, set when status is final."}, "pending": {"type": "array", "description": "Non-empty only when status is awaiting_approval. Each entry carries call_id, name, ref, and the full arguments - approve by call_id, having read the arguments.", "items": {"type": "object"}}, "tools_dropped": {"type": "integer", "description": "Actions that matched the query and allowlist but fell outside the catalogue cap."}, "memories_written": {"type": "integer", "description": "Memories this session has saved so far."}, "tools": {"type": "array", "items": {"type": "string"}, "description": "From conductor-start only: the tool names the model will be able to reach."}, "memories_recalled": {"type": "integer", "description": "From conductor-start only."}, "context": {"type": "array", "items": {"type": "string"}, "description": "From conductor-start only: the context documents the model may open."}, "skills": {"type": "array", "items": {"type": "string"}, "description": "From conductor-start only: the skill documents that were injected."}}}}';
save type /packages/solx-conductor/ToolsResult --json '{"description": "A resolved catalogue, plus whatever else a session would have been seeded with. Documentation only - result schemas are not validated.", "schema": {"$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "properties": {"tools": {"type": "array", "description": "Ollama tool definitions, ready to pass to ollama-chat.", "items": {"type": "object"}}, "refs": {"type": "object", "description": "Tool name to action reference. This is the dispatch table a session starts from; a name absent from it names nothing."}, "dropped": {"type": "integer"}, "skills": {"type": "array", "description": "Skills that would load, each with the catalogue entries it matched.", "items": {"type": "object"}}, "context": {"type": "array", "description": "The context index that would be injected.", "items": {"type": "object"}}, "memories": {"type": "array", "description": "The memories that would be recalled, when a memory scope is given.", "items": {"type": "string"}}}}}';

save action /packages/solx-conductor/conductor-start --json '{"actionType": "wasm", "binName": "solx-conductor.wasm", "fnName": "start", "caption": "Start a conductor session", "category": "agent", "description": "Resolve a tool catalogue from a search query and a default-deny allowlist, recall any memories for the scope, index the context documents, load the skills covering the chosen tools, then create the session. Returns the session id and everything the model will be able to reach, so you can inspect it before spending a token.", "capabilities": ["agent", "orchestration", "llm", "tools", "session", "memory", "context", "skills"], "phrases": ["start an agent", "start a conductor session", "run an agent loop", "give the model tools"], "paramTypeRef": "/packages/solx-conductor/StartParams", "actionConfig": {"timeout_secs": 180}, "resultTypeRef": "/packages/solx-conductor/StepResult"}';
save action /packages/solx-conductor/conductor-step --json '{"actionType": "wasm", "binName": "solx-conductor.wasm", "fnName": "step", "caption": "Run one conductor iteration", "category": "agent", "description": "Run exactly one iteration: ask the model, dispatch the tool calls it makes through the gate, and append the results. Returns awaiting_approval, with the full arguments of each pending call, when the model asks for something destructive.", "capabilities": ["agent", "orchestration", "llm", "tools", "approval"], "phrases": ["step the agent", "run one iteration", "continue the session", "approve the tool call"], "paramTypeRef": "/packages/solx-conductor/StepParams", "actionConfig": {"timeout_secs": 2400}, "resultTypeRef": "/packages/solx-conductor/StepResult"}';
save action /packages/solx-conductor/conductor-run --json '{"actionType": "wasm", "binName": "solx-conductor.wasm", "fnName": "run", "caption": "Run a conductor session to completion", "category": "agent", "description": "Step repeatedly until the session finishes, hits its iteration cap, is cancelled, or stops for approval. Checks action/cancelled between iterations, so action/start plus action/stop cancels it promptly.", "capabilities": ["agent", "orchestration", "llm", "tools", "loop"], "phrases": ["run the agent", "run the session", "let the agent finish"], "paramTypeRef": "/packages/solx-conductor/RunParams", "actionConfig": {"timeout_secs": 21600}, "resultTypeRef": "/packages/solx-conductor/StepResult"}';
save action /packages/solx-conductor/conductor-session --json '{"actionType": "wasm", "binName": "solx-conductor.wasm", "fnName": "session", "caption": "Read a conductor session", "category": "agent", "description": "Read a session back: full transcript, the tool call audit log with per-call outcomes, the memories written, the context offered, and current status. Pure read.", "capabilities": ["agent", "session", "read", "transcript"], "phrases": ["read the session", "show the transcript", "what did the agent do", "what did the agent learn"], "paramTypeRef": "/packages/solx-conductor/SessionParams", "actionConfig": {"timeout_secs": 60}}';
save action /packages/solx-conductor/conductor-tools --json '{"actionType": "wasm", "binName": "solx-conductor.wasm", "fnName": "tools", "caption": "Preview a conductor catalogue", "category": "agent", "description": "Resolve a query and allowlist to the exact tools, skills, context and memories a session would be given, without creating one. Use it to check what a model would see, and to test that the gate refuses what it should.", "capabilities": ["agent", "tools", "catalogue", "preview"], "phrases": ["preview the tools", "what tools would the agent get", "check the allowlist", "what would the agent remember"], "paramTypeRef": "/packages/solx-conductor/ToolsParams", "actionConfig": {"timeout_secs": 180}, "resultTypeRef": "/packages/solx-conductor/ToolsResult"}';
