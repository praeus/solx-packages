post action /packages/solx-google/get-google-doc --json '{"action_type":"webhook","fn_name":"https://docs.googleapis.com/v1/documents/{documentId}","caption":"Get Google Doc (REST)","category":"google-workspace","description":"Fetches a Google Doc via GET https://docs.googleapis.com/v1/documents/{documentId}.","capabilities":["google-workspace","docs","rest","webhook","read"],"phrases":["get google doc","read google doc","fetch google docs document"],"param_type_ref":"/packages/solx-google/GoogleDocsGetParams","result_type_ref":"/packages/solx-google/GoogleDocsDoc","action_config":{"secrets":{"GOOGLE_OAUTH_CLIENT_ID":"'$key.value'","GOOGLE_OAUTH_CLIENT_SECRET":"'$key.value'","GOOGLE_OAUTH_REFRESH_TOKEN":"'$key.value'"},"timeout_secs":30,"path_params":{"documentId":""},"auth":{"type":"oauth_refresh","client_id_secret":"GOOGLE_OAUTH_CLIENT_ID","client_secret_secret":"GOOGLE_OAUTH_CLIENT_SECRET","refresh_token_secret":"GOOGLE_OAUTH_REFRESH_TOKEN","token_uri":"https://oauth2.googleapis.com/token","scope":"https://www.googleapis.com/auth/documents.readonly"}}}';
