post action /packages/solx-omniparse/solx-omniparse-process-file --json '{"action_type":"command","fn_name":".\\solx-omniparse-process-file.exe","caption":"solx-omniparse process-file","category":"extraction","description":"Preprocess a document (PDF/office/etc.) into plain text bytes using omniparse, with ML OCR fallback for scanned/image-only PDFs. Invoke explicitly with source_path/file_name/mime_type.","capabilities":["extraction","preprocess","ocr","document-conversion","command","pdf"],"phrases":["omniparse process file","convert pdf to text","ocr process file","scanned pdf process file"],"param_type_ref":"/packages/solx-omniparse/OmniparseInput","result_type_ref":"/packages/solx-omniparse/OmniparseResult","action_config":{"cwd":"D:/Projects/solx-packages/solx-omniparse/bin"}}'
